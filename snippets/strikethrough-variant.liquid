{%- doc -%}
  Renders the diagonal line shown across an unavailable option value.

  @param {object} product_option - The option value to render the line for.
  @param {boolean} [corner_to_corner] - Stretch the line so it runs exactly from corner to
    corner of the element, whatever its size. Without it the line keeps a fixed angle and is
    cropped, which is what the swatches use.
{%- enddoc -%}

{% unless product_option.available %}
  <svg
    viewBox="0 0 100 46"
    preserveAspectRatio="{% if corner_to_corner %}none{% else %}xMidYMid slice{% endif %}"
  >
    {% # 25deg %}
    <line x1="100" y1="0" x2="0" y2="46" vector-effect="non-scaling-stroke" />
    {% # duplicate line for motion overlay %}
    <line x1="100" y1="0" x2="0" y2="46" vector-effect="non-scaling-stroke" />
  </svg>
{% endunless %}
