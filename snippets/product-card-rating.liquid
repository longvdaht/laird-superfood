{% comment %}
  Product card star rating — Okendo Reviews.
  Accepts: product (defaults to closest.product)
{% endcomment %}
{%- liquid
  assign product = product | default: closest.product
  assign okendo_count = product.metafields.okendo.summaryData.reviewCount | default: product.metafields.okendo.ReviewCount | default: 0
-%}

{%- if settings.show_product_card_rating != false and okendo_count > 0 -%}
  <div class="product-card-rating-container">
    {% render 'okendo-reviews-product-rating-summary', product: product %}
  </div>

  <style>
    .product-card-rating-container {
      display: block;
      margin: 4px 0 8px;
      line-height: 1;
    }
  </style>
{%- endif -%}
