{%- liquid
  assign pov_product  = product
  assign pov_variant  = pov_product.selected_or_first_available_variant
  assign pov_first_group = pov_product.selling_plan_groups | first

  assign pov_discount_pct = 0
  assign pov_sub_price    = nil

  unless pov_first_group == blank
    assign pov_first_plan = pov_first_group.selling_plans | first
    unless pov_first_plan == blank
      for pov_adj in pov_first_plan.price_adjustments
        if pov_adj.value_type == 'percentage'
          assign pov_discount_pct = pov_adj.value | round
        endif
      endfor
    endunless

    unless pov_variant == blank
      for pov_alloc in pov_variant.selling_plan_allocations
        unless pov_first_plan == blank
          if pov_alloc.selling_plan_id == pov_first_plan.id
            assign pov_sub_price = pov_alloc.price
          endif
        endunless
      endfor
      if pov_sub_price == nil and pov_variant.selling_plan_allocations.size > 0
        assign pov_sub_price = pov_variant.selling_plan_allocations.first.price
      endif
    endunless
  endunless

  # Merchant-editable copy, set in the Theme editor on the product information section.
  # [discount] in any of these is replaced with the subscription discount read above.
  assign pov_legend = section.settings.po_legend | default: 'Frequency'
  assign pov_sub_title = section.settings.po_subscribe_title | default: 'Subscribe & Save'
  assign pov_onetime_title = section.settings.po_onetime_title | default: 'One-Time Purchase'

  assign pov_badge_text = section.settings.po_badge_text | default: 'Save [discount]%'
  assign pov_badge_text = pov_badge_text | replace: '[discount]', pov_discount_pct

  assign pov_benefits_raw = section.settings.po_benefits
  if pov_benefits_raw == blank
    assign pov_benefits = 'Free shipping on orders over $35|Save [discount]% on every order, additional 10% off third subscription|Priority stock, we hold inventory for subscribers first|Easy to manage, cancel anytime' | split: '|'
  else
    assign pov_benefits = pov_benefits_raw | newline_to_br | strip_newlines | split: '<br />'
  endif

  assign pov_benefits_extra_raw = section.settings.po_benefits_extra
  if pov_benefits_extra_raw == blank
    assign pov_benefits_extra = '' | split: '|'
  else
    assign pov_benefits_extra = pov_benefits_extra_raw | newline_to_br | strip_newlines | split: '<br />'
  endif

  assign pov_show_more = section.settings.po_show_more_benefits
  if pov_benefits_extra.size == 0
    assign pov_show_more = false
  endif

  assign pov_see_more_label = section.settings.po_see_more_label | default: 'See more subscription benefits +'
  assign pov_see_less_label = section.settings.po_see_less_label | default: 'See fewer benefits -'
-%}

{%- unless pov_product.selling_plan_groups == empty -%}

{%- capture check_svg -%}
<svg class="new-po-check-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <circle cx="10" cy="10" r="10" fill="currentColor"/>
  <path d="M5.75 10.3L8.5 13L14.25 7.2" stroke="#003349" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
{%- endcapture -%}

<fieldset
  class="new-purchase-options"
  data-section-id="{{ section.id }}"
  style="display:none"
>

  {%- if pov_legend != blank -%}
    <legend class="new-po-legend">{{ pov_legend }}</legend>
  {%- endif -%}

  <div class="new-po-option new-po-option--subscribe" data-option="subscription">
    <label class="new-po-option__row">
      <input
        type="radio"
        class="new-po-radio-input"
        name="new-po-{{ section.id }}"
        value="subscription"
        checked
      >
      <span class="new-po-radio-indicator" aria-hidden="true"></span>
      <span class="new-po-option__title">
        {{ pov_sub_title }}
        {%- if pov_discount_pct > 0 and pov_badge_text != blank -%}
          <span class="new-po-discount-badge" data-po-discount-badge>{{ pov_badge_text }}</span>
        {%- endif -%}
      </span>
      <span class="new-po-prices">
        <span class="new-po-price new-po-price--compare" data-po-compare-price>
          {{- pov_variant.price | money -}}
        </span>
        <span class="new-po-price new-po-price--sub" data-po-sub-price>
          {{- pov_sub_price | default: pov_variant.price | money -}}
        </span>
      </span>
    </label>

    <div class="new-po-option__body">
      <div class="new-po-frequency">
        <label class="new-po-frequency__label" for="new-po-freq-{{ section.id }}">Frequency:</label>
        <div class="new-po-select-wrapper">
          <select class="new-po-frequency-select" id="new-po-freq-{{ section.id }}">
            {%- for grp in pov_product.selling_plan_groups -%}
              {%- for pln in grp.selling_plans -%}
                <option value="{{ pln.id }}">{{ pln.name }}</option>
              {%- endfor -%}
            {%- endfor -%}
          </select>
          <span class="new-po-select-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 14 14" fill="none">
              <path d="M11 5.5L7 9.5L3 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </div>
      </div>

      <ul class="new-po-benefits-list">
        {%- for pov_benefit in pov_benefits -%}
          {%- assign pov_benefit_text = pov_benefit | strip | replace: '[discount]', pov_discount_pct -%}
          {%- if pov_benefit_text != blank -%}
            <li class="new-po-benefit">
              {{ check_svg }}
              <span>{{ pov_benefit_text }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if pov_show_more -%}
        <button
          type="button"
          class="new-po-see-more"
          aria-expanded="false"
          data-po-see-more-label="{{ pov_see_more_label | escape }}"
          data-po-see-less-label="{{ pov_see_less_label | escape }}"
        >
          {{ pov_see_more_label }}
        </button>

        <ul class="new-po-benefits-extra" hidden>
          {%- for pov_benefit in pov_benefits_extra -%}
            {%- assign pov_benefit_text = pov_benefit | strip | replace: '[discount]', pov_discount_pct -%}
            {%- if pov_benefit_text != blank -%}
              <li class="new-po-benefit">
                {{ check_svg }}
                <span>{{ pov_benefit_text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>

  <div class="new-po-option new-po-option--onetime" data-option="onetime">
    <label class="new-po-option__row">
      <input
        type="radio"
        class="new-po-radio-input"
        name="new-po-{{ section.id }}"
        value="onetime"
      >
      <span class="new-po-radio-indicator" aria-hidden="true"></span>
      <span class="new-po-option__title">{{ pov_onetime_title }}</span>
      <span class="new-po-prices">
        {%- liquid
          assign onetime_compare_value = nil
          if pov_variant.compare_at_price > pov_variant.price
            assign onetime_compare_value = pov_variant.compare_at_price
          elsif pov_variant.title == '1 - 16oz'
            assign onetime_compare_value = 3400
          elsif pov_variant.title == '3 Pack - 16oz'
            assign onetime_compare_value = 10200
          endif
        -%}
        <span
          class="new-po-price new-po-price--compare"
          data-po-onetime-compare-price
          {%- unless onetime_compare_value %} style="display:none"{% endunless %}
        >
          {%- if onetime_compare_value -%}
            {%- assign compare_dollars = onetime_compare_value | divided_by: 100 -%}
            {%- assign compare_cents = onetime_compare_value | modulo: 100 -%}
            {%- if compare_cents == 0 -%}
              ${{ compare_dollars }}
            {%- else -%}
              {{- onetime_compare_value | money -}}
            {%- endif -%}
          {%- endif -%}
        </span>
        <span class="new-po-price new-po-price--regular" data-po-onetime-price>
          {{- pov_variant.price | money -}}
        </span>
      </span>
    </label>
  </div>


  {%- comment -%}
    Prices per variant, so the sync script can refresh them on pickers that do not carry
    the data-variant-*-text attributes (every template other than new-mahalo).
  {%- endcomment -%}
  <script type="application/json" data-po-variant-prices>
    {
      {%- for pov_v in pov_product.variants -%}
        {%- liquid
          assign pov_v_compare = nil
          if pov_v.compare_at_price > pov_v.price
            assign pov_v_compare = pov_v.compare_at_price
          elsif pov_v.title == '1 - 16oz'
            assign pov_v_compare = 3400
          elsif pov_v.title == '3 Pack - 16oz'
            assign pov_v_compare = 10200
          endif

          assign pov_v_sub = nil
          if pov_v.selling_plan_allocations.size > 0
            assign pov_v_sub = pov_v.selling_plan_allocations.first.price
          endif
        -%}
        "{{ pov_v.id }}": {
          "price": {{ pov_v.price | money | json }},
          "compare": {% if pov_v_compare %}{{ pov_v_compare | money | json }}{% else %}""{% endif %},
          "sub": {% if pov_v_sub %}{{ pov_v_sub | money | json }}{% else %}""{% endif %}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  </script>
</fieldset>
{%- endunless -%}
