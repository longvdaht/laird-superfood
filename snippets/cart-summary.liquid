{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
{%- enddoc -%}

<div class="cart__summary-totals">
  {% # We need to keep this node in place to allow morphing to work properly # %}
  <div class="cart__original-total-container cart-primary-typography">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <span class="cart__summary-item cart__original-total">
        <span class="cart__original-total-label">{{ 'content.cart_subtotal' | t }}</span>
        <span class="cart__original-total-value cart-secondary-typography">
          {{- cart.original_total_price | money -}}
        </span>
      </span>
      <div class="cart__summary-discounts">
        <ul
          class="discounts list-unstyled"
          role="list"
          aria-label="{{ 'content.discounts' | t }}"
        >
          {%- for discount in cart.cart_level_discount_applications -%}
            <li class="cart__summary-item cart__discount">
              <span class="cart__discount-label">
                {{- 'icon-discount.svg' | inline_asset_content -}}
                {{ discount.title | escape }}
              </span>
              <span class="cart__discount-value cart-secondary-typography"
                >-{{ discount.total_allocated_amount | money -}}
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>

  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="cart-actions">
      {% if settings.show_cart_note %}
        {% render 'cart-note' %}
      {% endif %}
      {% if settings.show_cart_note and settings.show_add_discount_code %}
        <div class="cart-actions__divider"></div>
      {% endif %}
      {% if settings.show_add_discount_code %}
        {% render 'cart-discount', section_id: section.id %}
      {% endif %}
    </div>
  {% endif %}

  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif

    comment
      Cart has no built-in "sum of compare_at prices" field, so it's accumulated here to show
      a strikethrough subtotal when line items are on sale - from a plain compare_at_price, or
      (new, with the subscribe toggle) a selling plan compare_at_price. original_total_price
      already covers discount-code-style discounts separately above, so this only needs to
      catch the other 2. Everything here is per-unit, multiplied by quantity to get line totals
      before summing - cart.total_price/original_total_price are already line totals.
    endcomment
    assign cart_compare_at_total = 0
    for item in cart.items
      assign item_compare_at = item.original_price

      if item.variant.compare_at_price > item_compare_at
        assign item_compare_at = item.variant.compare_at_price
      endif

      if item.selling_plan_allocation.compare_at_price > item_compare_at
        assign item_compare_at = item.selling_plan_allocation.compare_at_price
      endif

      assign item_compare_at_line_total = item_compare_at | times: item.quantity
      assign cart_compare_at_total = cart_compare_at_total | plus: item_compare_at_line_total
    endfor

    if settings.currency_code_enabled_cart_total
      assign cart_compare_at_total_formatted = cart_compare_at_total | money_with_currency
    else
      assign cart_compare_at_total_formatted = cart_compare_at_total | money
    endif
  -%}

  <div class="cart__total-container">
    <span
      class="cart__summary-item cart__total"
      role="status"
    >
      <span class="cart__total-label">
        {{ 'content.cart_subtotal' | t }} ({{ 'content.item_count' | t: count: cart.item_count }})
      </span>
      <text-component
        ref="cartTotal"
        value="{{ total_price | strip_html }}"
        class="cart__total-value rebuy-cart__flyout-subtotal-amount"
        {% comment %}
          Used by payment_terms web component. The extra `rebuy-cart__flyout-subtotal-amount`
          class is NOT styling, it's a bridge: Corso's Checkout Plus is configured (in Corso
          Admin, cartSelectors) to look for that exact class name from the old Rebuy cart, and
          that config lives on Corso's side, not in this theme. Safe to keep once Corso Admin
          is updated with the real selector (#checkout / [data-cart-subtotal]) - remove then.
        {% endcomment %}
        data-cart-subtotal
      >
        {% if cart_compare_at_total > cart.total_price %}
          <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
          <s class="compare-at-price">{{ cart_compare_at_total_formatted }}</s>
          <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
          {{ total_price }}
        {% else %}
          {{ total_price }}
        {% endif %}
      </text-component>
    </span>
    {% if settings.show_installments %}
      <span class="cart__summary-item cart__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}
  </div>
</div>

{% comment %}
  Cart Rebuild: data-skip-subtree-update (assets/morph.js) tells morphSection to leave this
  subtree alone entirely on cart updates, instead of re-patching it from the server's fresh HTML
  every time. Needed because Corso (Checkout Plus) injects its own DOM in and around the
  checkout button here after the page loads - patching that area from server HTML (which knows
  nothing about what Corso added) was wiping it out and making Corso redetect/reinsert itself on
  every add/remove, which is what caused the visible flash/jump. Corso updates its own injected
  price text through its own listeners, not through this morph, so this is safe to skip - there's
  nothing dynamic of ours inside .cart__ctas itself (the total is shown separately above).

  data-skip-node-update is also needed alongside data-skip-subtree-update - the latter only
  protects children from being re-patched, not .cart__ctas's own attributes, and this element
  doesn't need either of those to ever change after first render (its class is static).
{% endcomment %}
<div
  class="cart__ctas"
  data-skip-node-update
  data-skip-subtree-update
>
  <button
    type="submit"
    id="checkout"
    {% comment %}
      rebuy-cart__checkout-button is a bridge class for Corso Checkout Plus (see comment on the
      subtotal element above) - purely a selector hook, not styled anywhere in this theme.
    {% endcomment %}
    class="rebuy-button rebuy-cart__checkout-button block"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
    form="cart-form"
  >
    {{ 'content.checkout' | t }}
  </button>

  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
    <div
      class="
        additional-checkout-buttons
        {% if accelerated_checkout_buttons_layout == 'vertical' %}additional-checkout-buttons--vertical{% endif %}
      "
    >
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .cart-actions {
    display: block;
  }

  .cart-actions__divider {
    border-block-start: var(--style-border-width) solid var(--color-border);
  }

  .cart__summary-totals:not(:has(.cart-actions)) {
    margin-block-start: var(--margin-3xs);
    border-block-start: var(--style-border-width) solid var(--color-border);
    padding-block-start: var(--margin-xl);
  }

  .cart__installments {
    color: var(--color-foreground);
  }
{% endstylesheet %}




