{%- comment -%}
  Decorative floral graphic. Served as an external SVG (assets/graphic-floral.svg) instead of
  inline markup so its ~49KB isn't repeated in the HTML every time it's rendered.
{%- endcomment -%}
<img
  src="{{ 'graphic-floral.svg' | asset_url }}"
  alt=""
  aria-hidden="true"
  width="908"
  height="818"
  loading="lazy"
  decoding="async"
>
