{%- doc -%}
  Renders, as JSON, the variant a picker must start on: the one Shopify selected when it is still
  visible, and otherwise the first visible variant that is in stock.

  Variant pickers read this JSON to know what the add to cart button buys, so going through it
  rather than through `selected_or_first_available_variant` directly is what keeps a hidden
  variant from being bought by way of a `?variant=` url. See `variant-hidden`.

  @param {object} product_resource - The product the picker belongs to.

  @example
  <script type="application/json">
    {% render 'variant-visible-selected', product_resource: product_resource %}
  </script>
{%- enddoc -%}

{%- liquid
  assign starting_variant = product_resource.selected_or_first_available_variant

  capture starting_variant_hidden
    render 'variant-hidden', variant: starting_variant, product_resource: product_resource
  endcapture

  if starting_variant_hidden != blank
    assign visible_variant = blank

    for product_variant in product_resource.variants
      capture product_variant_hidden
        render 'variant-hidden', variant: product_variant, product_resource: product_resource
      endcapture

      if product_variant_hidden == blank
        if visible_variant == blank
          assign visible_variant = product_variant
        endif
        if product_variant.available
          assign visible_variant = product_variant
          break
        endif
      endif
    endfor

    if visible_variant != blank
      assign starting_variant = visible_variant
    endif
  endif
-%}
{{- starting_variant | json -}}
