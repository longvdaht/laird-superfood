{%- doc -%}
  Renders which values of an option stay visible in a variant picker, as
  `<visible option value ids, comma separated>|<option value id to select>`.

  A value is hidden when the product lists it in `custom.hidden_variants`, or when every variant
  carrying it is hidden — see `variant-hidden`. Requiring every variant keeps one hidden
  combination of a multi option product from taking a whole value away: `Vanilla / 16oz` being
  hidden must not hide `Vanilla` while `Vanilla / 8oz` is still for sale.

  The value to select is the one Shopify selected when it is still visible, and the first visible
  value otherwise, so that hiding the selected value does not leave the option with nothing
  checked. When a misconfiguration would hide every value, all of them are kept, so the product
  never becomes impossible to buy.

  @param {object} product_resource - The product the option belongs to.
  @param {object} product_option - The option to render, as returned by `options_with_values`.

  @example
  {% capture visible_values %}
    {% render 'variant-visible-values', product_resource: product_resource, product_option: product_option %}
  {% endcapture %}
  {% assign visible_values = visible_values | strip | split: '|' %}
  {% assign visible_value_ids = visible_values[0] | split: ',' %}
  {% assign selected_value_id = visible_values[1] %}
{%- enddoc -%}

{%- liquid
  assign visible_ids = ''
  assign selected_id = ''
  assign all_ids = ''
  assign option_key = 'option' | append: product_option.position

  for product_option_value in product_option.values
    assign value_id = product_option_value.id | append: ''
    assign all_ids = all_ids | append: value_id | append: ','

    assign option_value_name = product_option_value.name | default: product_option_value | append: '' | strip
    assign carrying_variants = product_resource.variants | where: option_key, option_value_name

    assign is_hidden = false

    if carrying_variants.size > 0
      assign hidden_count = 0
      for carrying_variant in carrying_variants
        capture carrying_variant_hidden
          render 'variant-hidden', variant: carrying_variant, product_resource: product_resource
        endcapture
        if carrying_variant_hidden != blank
          assign hidden_count = hidden_count | plus: 1
        endif
      endfor
      if hidden_count == carrying_variants.size
        assign is_hidden = true
      endif
    else
      # A combined listing value points at a child product rather than at a variant of this one,
      # so only the product level lists can hide it.
      capture option_value_hidden
        render 'variant-hidden', option_value_name: option_value_name, product_resource: product_resource
      endcapture
      if option_value_hidden != blank
        assign is_hidden = true
      endif
    endif

    unless is_hidden
      assign visible_ids = visible_ids | append: value_id | append: ','
      if selected_id == ''
        assign selected_id = value_id
      endif
      if product_option_value.selected
        assign selected_id = value_id
      endif
    endunless
  endfor

  # Every value being hidden would leave the product impossible to buy, so treat it as a
  # misconfiguration and keep the option as Shopify returned it.
  if visible_ids == ''
    assign visible_ids = all_ids
    for product_option_value in product_option.values
      if selected_id == ''
        assign selected_id = product_option_value.id | append: ''
      endif
      if product_option_value.selected
        assign selected_id = product_option_value.id | append: ''
      endif
    endfor
  endif
-%}
{{- visible_ids | split: ',' | join: ',' -}}|{{- selected_id -}}
