{%- doc -%}
  Renders the cart drawer, a slide-out panel that displays the contents of the cart. It includes the cart icon that acts as a trigger.

  @param {object} [settings] - An object containing theme settings.
  @param {boolean} [settings.auto_open_cart_drawer] - If `true`, the cart drawer opens automatically after an item is added.
  @param {string} [settings.drawer_color_scheme] - The color scheme for the drawer.
{%- enddoc -%}

<script
  src="{{ 'cart-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<cart-drawer-component
  class="cart-drawer"
  {{ block.shopify_attributes }}
  {% if settings.auto_open_cart_drawer %}
    auto-open
  {% endif %}
>
  <button
    class="button header-actions__action button-unstyled"
    aria-haspopup="dialog"
    aria-label="{{ 'accessibility.cart' | t }}"
    aria-describedby="cart-bubble-text"
    {% comment %}
      NOTE (Cart Rebuild, 2026-09): renamed from data-testid="cart-drawer-trigger". Rebuy has a
      custom "ready" callback (configured server-side in Rebuy Admin, not in this theme) that
      does `document.querySelector('[data-testid="cart-drawer-trigger"]').addEventListener(...)`
      to force-open its own Smart Cart on click, hijacking this exact button. Renaming the
      attribute breaks that querySelector match so clicks fall through to our own
      on:click="cart-drawer-component/open" below. This does NOT disable Rebuy elsewhere on the
      site - still needs the real Rebuy Admin fix at go-live (see custom.js note).
    {% endcomment %}
    data-testid="native-cart-drawer-trigger"
    on:click="cart-drawer-component/open"
  >
    {% render 'cart-icon-component' %}
  </button>

  <dialog
    ref="dialog"
    class="cart-drawer__dialog dialog-modal dialog-drawer color-{{ settings.drawer_color_scheme }}{% if cart.empty? %} cart-drawer--empty{%endif%}"
    aria-labelledby="{% if cart.empty? %}cart-drawer-heading-empty{% else %}cart-drawer-heading{% endif %}"
    scroll-lock
  >
    <div class="cart-drawer__inner">
      <cart-items-component
        class="cart-items-component"
        data-section-id="{{ section.id }}"
      >
        {%- if cart.empty? -%}
          <div class="cart-drawer__header">
            {% comment %}
              NOTE (Cart Rebuild, 2026-09): stock Horizon theme only showed the close button here
              when the cart is empty (no title). Added the title back so the header always looks
              the same (title + close), matching the old Rebuy cart and the Figma design.
            {% endcomment %}
            <h2
              class="cart-drawer__heading h3"
              id="cart-drawer-heading-empty-title"
            >
              {{ 'content.cart_title' | t }}
            </h2>

            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button cart-close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {% render 'cart-announcement-bar' %}
          {% render 'cart-progress-bar' %}

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            <div class="cart-drawer__items">
              <h2
                class="cart-drawer__heading h3 cart-drawer__heading--empty"
                id="cart-drawer-heading-empty"
              >
                {{ 'content.your_cart_is_empty' | t }}
              </h2>
              {% render 'cart-products' %}
              {% render 'cart-cross-sell' %}
            </div>
          </div>
        {%- else -%}
          <div
            class="cart-drawer__header"
            id="cart-drawer-header"
          >
            <h2
              class="cart-drawer__heading h3"
              id="cart-drawer-heading"
            >
              {{ 'content.cart_title' | t }} ({{ cart.item_count }})
            </h2>

            <button
              ref="closeButton"
              on:click="cart-drawer-component/close"
              class="button cart-close-button button-unstyled"
              aria-label="{{ 'actions.close_dialog' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-close.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {% render 'cart-announcement-bar' %}
          {% render 'cart-progress-bar' %}
          {% render 'cart-gwp-watcher' %}

          <div
            class="cart-drawer__content motion-reduce"
            aria-label="{{ 'accessibility.cart' | t }}"
            style="--header-height: 60px;"
          >
            <scroll-hint
              class="cart-drawer__items"
            >
              {% render 'cart-products' %}
              {% render 'cart-cross-sell' %}
            </scroll-hint>

            <div
              class="cart-drawer__summary"
            >
              {% render 'cart-summary' %}
            </div>
          </div>
        {%- endif -%}
      </cart-items-component>
    </div>
  </dialog>
</cart-drawer-component>

{% stylesheet %}
  .cart-items-component {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__heading .cart-bubble {
    width: fit-content;
    border-radius: var(--style-border-radius-buttons-primary);
    aspect-ratio: auto;
    padding: var(--cart-padding);
  }

  .cart-drawer__heading .cart-bubble[data-maintain-ratio] {
    aspect-ratio: 1;
    min-width: 26px;
  }

  .cart-drawer__inner .cart-drawer__header {
    background-color: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--padding-sm) var(--padding-xl);
    border-bottom: var(--style-border-width) solid none;
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .cart-close-button svg {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    --icon-stroke-width: 2px;
  }

  .cart-close-button .svg-wrapper {
    color: var(--color-navy);
  }

  .cart-drawer__dialog {
    overflow: hidden;
  }

  .cart-drawer__inner {
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__content {
    height: calc(100% - var(--header-height));
    display: flex;
    flex-direction: column;
  }

  .cart-drawer__summary {
    background-color: var(--color-background);
    position: sticky;
    bottom: 0;
    z-index: 1;
  }
{% endstylesheet %}
