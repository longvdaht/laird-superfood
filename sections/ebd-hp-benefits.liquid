<section class="hp-benefits">
  <div class="content-wrapper">
    {%- if section.settings.heading != blank -%}
      <h2 class="darkblue">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="swiper benefits-slider">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="benefit" data-benefit>
              {%- if block.settings.background_image != blank -%}
                {{
                  block.settings.background_image
                  | image_url: width: 900
                  | image_tag:
                    class: 'benefit__image',
                    loading: 'lazy',
                    alt: '',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 1025px) 25vw, 300px'
                }}
              {%- endif -%}
              <div class="benefit__overlay">
                <h3 class="benefit__title">
                  <button
                    type="button"
                    class="benefit__toggle"
                    aria-expanded="false"
                    aria-controls="Benefit-{{ block.id }}"
                    data-benefit-toggle
                  >
                    <span>{{ block.settings.title }}</span>
                    <span class="benefit__icon" aria-hidden="true"></span>
                  </button>
                </h3>
                <div class="benefit__text" id="Benefit-{{ block.id }}">
                  <div class="benefit__text-inner">
                    {{ block.settings.text }}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      <div class="swiper-scrollbar swiper-scrollbar-darkblue"></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HP Benefits",
  "settings": [
    {
      "id": "heading",
      "type": "text",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Benefits",
      "settings": [
        {
          "id": "title",
          "type": "text",
          "label": "Title"
        },
        {
          "id": "text",
          "type": "richtext",
          "label": "Text"
        },
        {
          "id": "background_image",
          "type": "image_picker",
          "label": "Background Image"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "HP Benefits",
      "category": "Home Page"
    }
  ]
}
{% endschema %}

{% stylesheet %}
section.hp-benefits {
  padding: 75px 45px 35px;
  overflow: hidden;
  background-color: var(--color-mediumgray);

  .content-wrapper {
    max-width: 1600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 25px;

    > .swiper {
      width: 100%;
      min-width: 0;
    }

    h2 {
      margin: 0;
      text-transform: capitalize;
    }
  }

  .swiper-slide {
    width: 300px;
    height: auto;
  }

  /* Card: photo with a translucent white panel on top. The panel shows the title only and grows
     over the whole card to reveal the text (hover/focus on desktop, tap on touch screens). */
  .benefit {
    position: relative;
    aspect-ratio: 0.7;
    overflow: hidden;
    border-radius: 8px;
    background-color: var(--color-lightblue, #d9e6ea);

    .benefit__image {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .benefit__overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    padding: 25px;
    background: rgba(255, 255, 255, 0.75);
  }

  .benefit__title {
    margin: 0;
  }

  .benefit__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-darkblue);
    font: inherit;
    font-size: 24px;
    line-height: 28px;
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;

    &:focus-visible {
      outline: 2px solid var(--color-darkblue);
      outline-offset: 4px;
    }
  }

  /* +/− icon, only on touch layouts (see media queries) */
  .benefit__icon {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
    display: none;

    &::before,
    &::after {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      width: 16px;
      height: 3px;
      margin-top: -1.5px;
      border-radius: 10px;
      background-color: var(--color-darkblue);
      transition: transform 0.2s ease;
    }

    &::after {
      transform: rotate(90deg);
    }
  }

  /* Text height animates through the 0fr → 1fr grid-row trick */
  .benefit__text {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease;
  }

  .benefit__text-inner {
    min-height: 0;
    overflow: hidden;

    p {
      margin: 0;
      padding-top: 10px;
      color: var(--color-darkblue);
      font-size: 16px;
      line-height: 22px;
    }

    p + p {
      padding-top: 8px;
    }
  }

  .benefit.active {
    .benefit__overlay {
      bottom: 0;
      overflow-y: auto;
    }

    .benefit__text {
      grid-template-rows: 1fr;
    }

    .benefit__icon::after {
      transform: rotate(0deg);
    }
  }

  @media (hover: hover) and (min-width: 1025px) {
    .benefit:hover,
    .benefit:focus-within {
      .benefit__overlay {
        bottom: 0;
        overflow-y: auto;
      }

      .benefit__text {
        grid-template-rows: 1fr;
      }
    }
  }

  .swiper .swiper-scrollbar {
    position: relative;
    left: auto;
    bottom: auto;
    transform: none;
    width: 265px;
    max-width: 100%;
    margin: 24px auto 0;

    &.swiper-scrollbar-lock {
      display: none;
    }
  }

  @media (hover: none) {
    .benefit__icon {
      display: block;
    }
  }

  @media (max-width: 1024px) {
    padding: 60px 30px 35px;

    .benefit__toggle {
      font-size: 20px;
      line-height: 24px;
    }

    .benefit__icon {
      display: block;
    }
  }

  @media (max-width: 768px) {
    padding: 24px 20px 45px;

    .content-wrapper {
      gap: 24px;

      h2 {
        font-size: 28px;
        line-height: 30px;
        text-align: center;
        text-wrap: balance;
      }
    }

    .benefit__toggle {
      font-size: 18px;
      line-height: 24px;
    }

    .benefit__text-inner p {
      line-height: 26px;
    }
  }
}
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('section.hp-benefits').forEach(function (section) {
    const slider = section.querySelector('.benefits-slider');
    if (slider && window.Swiper) {
      new Swiper(slider, {
        slidesPerView: 'auto',
        spaceBetween: 20,
        watchOverflow: true,
        scrollbar: {
          el: section.querySelector('.swiper-scrollbar'),
          draggable: true
        },
        breakpoints: {
          1025: {
            slidesPerView: 4,
            spaceBetween: 25
          }
        }
      });
    }

    // Tap to open/close on touch layouts; desktop opens on hover/focus via CSS.
    const desktopHover = window.matchMedia('(hover: hover) and (min-width: 1025px)');
    const benefits = section.querySelectorAll('[data-benefit]');

    const setOpen = function (benefit, open) {
      benefit.classList.toggle('active', open);
      const toggle = benefit.querySelector('[data-benefit-toggle]');
      if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    benefits.forEach(function (benefit) {
      benefit.addEventListener('click', function () {
        if (desktopHover.matches) return;
        const open = !benefit.classList.contains('active');
        benefits.forEach(function (other) {
          if (other !== benefit) setOpen(other, false);
        });
        setOpen(benefit, open);
      });
    });
  });
});
{% endjavascript %}
