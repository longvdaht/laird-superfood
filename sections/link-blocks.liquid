{% if section.blocks.size > 0 %}
  <div
    id="LinkBlocks-{{ section.id }}"
    class="link-blocks link-blocks--{{ section.settings.alignment }}"
  >
    <div class="link-blocks__inner">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="link-blocks__item"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text }}
            </a>
          {% else %}
            <span
              class="link-blocks__item"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.text }}
            </span>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% style %}
  #LinkBlocks-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.section_background }};
  }

  #LinkBlocks-{{ section.id }} .link-blocks__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  #LinkBlocks-{{ section.id }}.link-blocks--left .link-blocks__inner {
    justify-content: flex-start;
  }

  #LinkBlocks-{{ section.id }}.link-blocks--center .link-blocks__inner {
    justify-content: center;
  }

  #LinkBlocks-{{ section.id }}.link-blocks--right .link-blocks__inner {
    justify-content: flex-end;
  }

  #LinkBlocks-{{ section.id }} .link-blocks__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    background-color: {{ section.settings.button_background }};
    color: {{ section.settings.text_border_color }};
    border: 1px solid {{ section.settings.text_border_color }};
    border-radius: 7px;

    text-decoration: none;
    padding: 12px;
  }

  #LinkBlocks-{{ section.id }} a.link-blocks__item:hover {
    background-color: {{ section.settings.text_border_color }};
    color: {{ section.settings.button_background }};
  }

  @media screen and (max-width: 749px) {
    #LinkBlocks-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.5 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.5 }}px;
    }

    #LinkBlocks-{{ section.id }} .link-blocks__item {
      font-size: 12px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Link blocks",
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_border_color",
      "label": "Text & border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Link blocks"
    }
  ]
}
{% endschema %}
