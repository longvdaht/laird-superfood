<section class="global-separator" style="background-color: {{ section.settings.color_2 }}">
  {% case section.settings.separator_type %}
  
    {% when 'wave_1' %}
      <svg class="wave-1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" fill="{{ section.settings.color_1 }}"></path>
      </svg>

    {% when 'wave_2' %}
      <svg class="wave-a" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M0,25 C160,60 320,70 480,40 C610,15 740,-5 880,20 C980,40 1090,70 1200,55 V0 H0 Z" fill="{{ section.settings.color_1 }}" />
      </svg>  
    
    {% when 'wave_3' %}
      <svg class="wave-b-flipped-horizontal" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 120" preserveAspectRatio="none">
        <path d="M1200,32 C1020,78 840,92 660,50 C510,15 360,5 200,40 C110,60 50,85 0,70 V0 H1200 Z" fill="{{ section.settings.color_1 }}" />
      </svg>


  {% endcase %}
</section>

{% schema %}
  {
    "name": "EBD Global Separator",
    "settings": [
      {
        "id": "separator_type",
        "type": "select",
        "label": "Separator Type",
        "default": "wave_1",
        "options": [
          {
            "value": "wave_1",
            "label": "Wave 1"
          },
          {
            "value": "wave_2",
            "label": "Wave 2"
          },
          {
            "value": "wave_3",
            "label": "Wave 3"
          }
        ]
      },
      {
        "id": "color_1",
        "type": "color",
        "label": "Color #1"
      },
      {
        "id": "color_2",
        "type": "color",
        "label": "Color #2"
      }
    ],
    "presets": [
      {
        "name": "EBD Global Separator",
        "category": "Global"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
.global-separator {
  width: 100%;
  max-height: 100px;
}

.global-separator svg {
  width: 100%;
  height: 100%;
  max-height: 100px;
  display: block;
  position: relative;
  top: -1px;
}

{% endstylesheet %}