<div class="hp-about">
  {%- if section.settings.show_leaves -%}
    {%- comment -%} Faint leaf decoration from Figma V1 (Founder-Story), behind the story content {%- endcomment -%}
    <img
      class="hp-about__leaves hp-about__leaves--left"
      src="{{ 'hp-leaves-left.svg' | asset_url }}"
      alt=""
      width="276"
      height="125"
      loading="lazy"
      aria-hidden="true"
    >
    <img
      class="hp-about__leaves hp-about__leaves--right"
      src="{{ 'hp-leaves-right.svg' | asset_url }}"
      alt=""
      width="340"
      height="658"
      loading="lazy"
      aria-hidden="true"
    >
  {%- endif -%}
  <div class="content-wrapper">
    <div class="hp-about__story">
      <div class="hp-about__heading">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hp-about__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="darkblue">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      {%- liquid
        assign image_main = section.settings.image
        assign image_secondary = section.settings.image_secondary
        assign caption_title = section.settings.caption_title
        assign caption_text = section.settings.caption_text
      -%}
      {%- if image_main != blank or image_secondary != blank or caption_title != blank or caption_text != blank -%}
        <div class="hp-about__media">
          <div class="hp-about__images">
            {%- if image_main != blank -%}
              {{
                image_main
                | image_url: width: 1400
                | image_tag:
                  class: 'hp-about__image hp-about__image--main',
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  sizes: '(min-width: 1440px) 610px, (min-width: 769px) 42vw, 80vw'
              }}
            {%- endif -%}
            {%- if image_secondary != blank -%}
              {{
                image_secondary
                | image_url: width: 800
                | image_tag:
                  class: 'hp-about__image hp-about__image--secondary',
                  loading: 'lazy',
                  widths: '200, 400, 600, 800',
                  sizes: '(min-width: 1440px) 315px, (min-width: 769px) 22vw, 40vw'
              }}
            {%- endif -%}
          </div>
          {%- if caption_title != blank or caption_text != blank -%}
            <div class="hp-about__caption">
              {%- if caption_title != blank -%}
                <p class="hp-about__caption-title">{{ caption_title }}</p>
              {%- endif -%}
              {%- if caption_text != blank -%}
                <p class="hp-about__caption-text">{{ caption_text }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="hp-about__body">
        {%- if section.settings.text != blank -%}
          <div class="hp-about__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.link_url != blank and section.settings.link_label != blank -%}
          <div class="hp-about__link">
            <a href="{{ section.settings.link_url }}" class="btn">{{ section.settings.link_label }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="video-wrapper">
      {%- liquid
        # Pick the largest mp4 within 720p for mobile and 1080p for desktop. The video is only
        # loaded once it scrolls into view (see the script below), so it no longer costs the
        # initial page load ~12MB on mobile.
        assign video = section.settings.video
        assign src_mobile = ''
        assign src_mobile_h = 0
        assign src_desktop = ''
        assign src_desktop_h = 0
        for source in video.sources
          if source.format != 'mp4'
            continue
          endif
          if source.height <= 720 and source.height > src_mobile_h
            assign src_mobile = source.url
            assign src_mobile_h = source.height
          endif
          if source.height <= 1080 and source.height > src_desktop_h
            assign src_desktop = source.url
            assign src_desktop_h = source.height
          endif
        endfor
        if src_desktop == blank
          assign src_desktop = video.sources[1].url | default: video.sources.first.url
        endif
        if src_mobile == blank
          assign src_mobile = src_desktop
        endif
      -%}
      <video
        id="aboutVideo"
        data-src-mobile="{{ src_mobile }}"
        data-src-desktop="{{ src_desktop }}"
        {% if video.preview_image != blank %}
          poster="{{ video.preview_image | image_url: width: 1200 }}"
        {% endif %}
        {% if video.aspect_ratio %}
          style="aspect-ratio: {{ video.aspect_ratio }};"
        {% endif %}
        preload="none"
        muted
        loop
        playsinline
      ></video>
        <button class="video-toggle" id="videoToggle" aria-label="Video Play Button">
          <span class="icon icon-play">{% render 'icon-play' %}</span>
          <span class="icon icon-pause hidden">{% render 'icon-pause' %}</span>
        </button>
      {%- if section.settings.product_image != blank -%}
        <a href="{{ section.settings.product_url }}" title="Laird Superfood Instant Lattes">
          {{
            section.settings.product_image
            | image_url: width: 600
            | image_tag:
              class: 'product-image',
              loading: 'lazy',
              widths: '240, 400, 600',
              sizes: '(min-width: 769px) 289px, 117px'
          }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <style></style>
</div>


{% schema %}
{
  "name": "HP About",
  "settings": [
    {
      "type": "header",
      "content": "Story"
    },
    {
      "id": "show_leaves",
      "type": "checkbox",
      "label": "Show leaf decoration",
      "default": true
    },
    {
      "id": "eyebrow",
      "type": "text",
      "label": "Eyebrow text",
      "default": "From the Waves to Your Cup"
    },
    {
      "id": "heading",
      "type": "text",
      "label": "Heading"
    },
    {
      "id": "text",
      "type": "richtext",
      "label": "Text"
    },
    {
      "id": "link_url",
      "type": "url",
      "label": "Link URL"
    },
    {
      "id": "link_label",
      "type": "text",
      "label": "Link Label"
    },
    {
      "id": "image",
      "type": "image_picker",
      "label": "Main image",
      "info": "The larger, tilted photo. Landscape, about 4:3."
    },
    {
      "id": "image_secondary",
      "type": "image_picker",
      "label": "Secondary image",
      "info": "The smaller photo overlapping the main one. Landscape, about 4:3."
    },
    {
      "id": "caption_title",
      "type": "text",
      "label": "Caption title",
      "default": "Gabby Reece | Laird Hamilton"
    },
    {
      "id": "caption_text",
      "type": "text",
      "label": "Caption text",
      "default": "Co-founders"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "id": "video",
      "type": "video",
      "label": "Video"
    },
    {
      "id": "product_image",
      "type": "image_picker",
      "label": "Product Image"
    },
    {
      "id": "product_url",
      "type": "url",
      "label": "Product URL"
    }
  ],
  "presets": [
    {
      "name": "HP About",
      "category": "Home Page"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .hp-about {
    position: relative;
    padding: 50px 45px 0;
    overflow: hidden;
    background-color: var(--color-mediumgray);

    .content-wrapper {
      position: relative;
      z-index: 1;
      max-width: 1600px;
      margin: 0 auto;
    }

    /* Leaf decoration (Figma: 276px top-left, 340px top-right at 1440). Scales down below 1440. */
    .hp-about__leaves {
      position: absolute;
      top: 0;
      z-index: 0;
      height: auto;
      pointer-events: none;
    }

    .hp-about__leaves--left {
      left: 0;
      width: min(276px, 19.2vw);
    }

    .hp-about__leaves--right {
      right: 0;
      width: min(340px, 23.6vw);
    }

    /* Mobile (Figma): same leaves at ~0.7 scale; the right group sits lower, beside the photos and text */
    @media (max-width: 768px) {
      .hp-about__leaves--left {
        width: 198px;
      }

      .hp-about__leaves--right {
        top: 296px;
        width: 237px;
      }
    }

    /* Story: tilted photos on the left, heading + text on the right (Figma V1 "Founder-Story") */
    .hp-about__story {
      display: grid;
      grid-template-columns: minmax(0, 760fr) minmax(0, 553fr);
      grid-template-rows: auto auto;
      grid-template-areas:
        'media heading'
        'media body';
      column-gap: 40px;
      row-gap: 24px;
      max-width: 1353px;
      margin: 0 auto;
    }

    .hp-about__heading {
      grid-area: heading;
      align-self: end;
      display: flex;
      flex-direction: column;
      gap: 12px;

      .hp-about__eyebrow {
        margin: 0;
        color: var(--color-red-2);
        font-size: 24px;
        line-height: 28px;
        font-weight: 700;
        text-transform: uppercase;
      }

      h2 {
        margin: 0;
        max-width: 352px;
        text-transform: capitalize;
        text-wrap: balance;
      }
    }

    .hp-about__body {
      grid-area: body;
      align-self: start;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .hp-about__text {
      display: flex;
      flex-direction: column;
      gap: 10px;

      p {
        margin: 0;
        color: var(--color-darkblue);
        font-size: 18px;
        line-height: 24px;
      }
    }

    /* Image positions are the Figma offsets as a share of the 760x561 frame. Figma rotates around
       the top-left corner, hence transform-origin. */
    .hp-about__media {
      grid-area: media;
      align-self: center;
      width: 100%;
    }

    .hp-about__images {
      position: relative;
      width: 100%;
      aspect-ratio: 760 / 561;
    }

    .hp-about__image {
      position: absolute;
      display: block;
      height: auto;
      object-fit: cover;
      border-radius: 12px;
      transform-origin: 0 0;
    }

    .hp-about__image--main {
      left: 16.34%;
      top: 4.89%;
      width: 79.22%;
      aspect-ratio: 602 / 445;
      transform: rotate(3.45deg);
    }

    .hp-about__image--secondary {
      z-index: 1;
      left: -0.1%;
      top: 14.38%;
      width: 40.65%;
      aspect-ratio: 309 / 229;
      transform: rotate(-5.19deg);
    }

    /* In normal flow under the photos, pulled up into the frame's empty bottom-left corner
       (Figma: caption top at 518/561 of the frame). A percentage margin follows the frame width,
       so the caption never runs into the main photo whatever the screen size. */
    .hp-about__caption {
      position: relative;
      z-index: 2;
      margin-top: -5.6%;
      display: flex;
      flex-direction: column;
      gap: 3px;

      p {
        margin: 0;
        color: var(--color-darkblue);
        font-size: 14px;
        line-height: 20px;
      }

      .hp-about__caption-title {
        font-size: 16px;
        font-weight: 500;
      }
    }

    @media (max-width: 1024px) {
      .hp-about__story {
        column-gap: 30px;
      }

      .hp-about__heading .hp-about__eyebrow {
        font-size: 20px;
        line-height: 24px;
      }

      .hp-about__text p {
        font-size: 16px;
        line-height: 22px;
      }
    }

    @media (max-width: 768px) {
      .hp-about__story {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto;
        grid-template-areas:
          'heading'
          'media'
          'body';
      }

      .hp-about__heading {
        align-self: auto;
        align-items: center;
        text-align: center;

        .hp-about__eyebrow {
          font-size: 18px;
          line-height: 20px;
        }

        h2 {
          max-width: none;
          font-size: 28px;
          line-height: 30px;
        }
      }

      .hp-about__media {
        width: calc(100% + 20px);
        margin: 0 -10px;
      }

      .hp-about__image {
        border-radius: 6px;
      }

      .hp-about__caption {
        padding-left: 4%;
        gap: 0;

        .hp-about__caption-title {
          font-size: 14px;
        }
      }

      .hp-about__body {
        gap: 25px;
      }

      .hp-about__text p {
        font-size: 16px;
        line-height: 26px;
      }
    }

    /* A Better Latte video (Figma V1 "Video"): rounded corners, no floral graphics, product shot
       overlapping the bottom-left corner. */
    .video-wrapper {
      position: relative;
      margin: 75px auto;
      max-width: 1320px;

      video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: relative;
        z-index: 1;
        border-radius: 50px;
      }

      img.product-image {
        position: absolute;
        bottom: -75px;
        left: 44px;
        z-index: 1;
        width: min(289px, 22%);
        height: auto;
        transition: 1s;

        &:hover {
          transform: scale(1.05);
        }
      }
    }

    .video-toggle {
      position: absolute;
      top: 35px;
      right: 44px;
      z-index: 2;
      background: none;
      border: solid 2px white;
      border-radius: 50%;
      width: 55px;
      height: 55px;
      cursor: pointer;

      &:focus-visible {
        outline: 2px solid white;
        outline-offset: 3px;
      }
    }

    .icon {
      display: inline-block;
      &.icon-play {
        svg {
          width: 26px;
          position: relative;
          top: 1px;
          left: 1px;

          path {
            fill: white;
          }
        }
      }

      &.icon-pause {
        position: relative;
        top: -1px;
        left: 1px;
        svg {
          width: 30px;
          position: relative;
          top: 6px;
          left: 2px;
        }
      }
    }

    .hidden {
      display: none !important;
    }

    @media (max-width: 1024px) {
      max-width: 100%;
      padding: 40px 30px 0;

      .video-wrapper {
        margin: 60px auto;

        video {
          border-radius: 30px;
        }

        img.product-image {
          bottom: -60px;
          left: 30px;
        }
      }

      .video-toggle {
        top: 25px;
        right: 30px;
      }
    }

    @media (max-width: 768px) {
      padding: 24px 20px 0;

      .video-wrapper {
        margin: 48px -3px 36px;

        video {
          border-radius: 12px;
        }

        img.product-image {
          left: 5px;
          bottom: -12px;
          width: 117px;
        }
      }

      .video-toggle {
        top: 7px;
        right: 7px;
      }
    }
  }
{% endstylesheet %}

{% javascript %}
document.addEventListener('DOMContentLoaded', () => {
  const video  = document.getElementById('aboutVideo');
  const toggle = document.getElementById('videoToggle');
  if (!video || !toggle) return;

  const playIcon  = toggle.querySelector('.icon-play');
  const pauseIcon = toggle.querySelector('.icon-pause');

  let firstClickDone = false;

  const setIcons = (isPlaying) => {
    if (isPlaying) {
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
      toggle.setAttribute('aria-label','Pause video');
    } else {
      playIcon.classList.remove('hidden');
      pauseIcon.classList.add('hidden');
      toggle.setAttribute('aria-label','Play video');
    }
  };

  // Ensure initial state
  video.muted = true;

  // Attach the source only when needed, so the video is not downloaded on page load.
  const loadVideo = () => {
    if (video.getAttribute('src')) return;
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    video.src = (isMobile ? video.dataset.srcMobile : video.dataset.srcDesktop) || video.dataset.srcDesktop;
  };

  // Autoplay (muted) while the video is on screen, pause when it scrolls away. Once the user has
  // taken control with the toggle, leave playback to them.
  if ('IntersectionObserver' in window) {
    new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (firstClickDone) return;
        if (entry.isIntersecting) {
          loadVideo();
          video.play().catch(() => {});
        } else if (!video.paused) {
          video.pause();
        }
      });
    }, { rootMargin: '200px 0px' }).observe(video);
  } else {
    loadVideo();
    video.play().catch(() => {});
  }

  toggle.addEventListener('click', () => {
    loadVideo();
    // FIRST CLICK: restart from beginning and unmute (even though it's already playing muted)
    if (!firstClickDone) {
      video.pause();               // ensure we can safely jump to 0
      video.currentTime = 0;       // restart
      video.muted = false;         // unmute on user gesture
      video.play();
      firstClickDone = true;
      setIcons(true);
      return;
    }

    // AFTER FIRST CLICK: normal pause/mute ↔ play/unmute behavior
    if (video.paused) {
      video.muted = false;         // resume unmuted
      video.play();
      setIcons(true);
    } else {
      video.pause();
      video.muted = true;          // pause and mute
      setIcons(false);
    }
  });
});
{% endjavascript %}
