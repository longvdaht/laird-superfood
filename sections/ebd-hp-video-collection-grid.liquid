<section class="ebd-video-collection-grid">
  <div class="content-wrapper">
    <h2 class="darkblue">
      {{ section.settings.heading }}
    </h2>
    <div class="swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}          
          <div class="swiper-slide">
            <a href="{{ block.settings.link_url }}" class="slide-wrapper" title="{{ block.settings.link_text }}">
              <div class="media-wrapper">
                <video src="{{ block.settings.video.sources[1].url }}" muted loop playsinline></video>
                <img class="poster" src="{{ block.settings.image | img_url: '500x' }}" alt="{{ block.settings.link_text }}">
              </div>
              <h4 class="darkblue">{{ block.settings.link_text }}</h4>
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-scrollbar swiper-scrollbar-darkblue"></div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "HP Video Collection Grid",
    "settings": [
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Collection",
        "settings": [
          {
            "id": "image",
            "type": "image_picker",
            "label": "Image"
          },
          {
            "id": "video",
            "type": "video",
            "label": "Video"
          },
          {
            "id": "link_url",
            "type": "url",
            "label": "Link URL"
          },
          {
            "id": "link_text",
            "type": "text",
            "label": "Link Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "HP Video Collection Grid",
        "category": "Home Page"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.ebd-video-collection-grid {
    padding: 25px 45px 45px;
    overflow: hidden;

    .content-wrapper {
        max-width: 1600px;
        margin: 0 auto;
        position: relative;

      .media-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 2 / 3;
        overflow: hidden;
        border: 1px solid #003349;

        video,
        .poster {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }

        .poster {
          z-index: 2;
          transition: opacity 0.2s ease;
        }

        &.playing {
          .poster {
            opacity: 0;
          }
        }
      }

      h4 {
        font-size: 18px;
        font-weight: 600;
        margin: 5px 0 0;
      }
    }

    

    @media (max-width: 768px) {
      padding: 25px 20px 65px;
    }


  }

{% endstylesheet %}

{% javascript %}
  const swiper = new Swiper('.ebd-video-collection-grid .swiper', {
    slidesPerView: 1.45,
    spaceBetween: 15,
    scrollbar: {
      el: '.ebd-video-collection-grid .swiper-scrollbar',
      draggable: true
    },
    breakpoints: {

      1200: {
        slidesPerView: 5.25
      },
      1000: {
        slidesPerView: 4.5
      },
      700: {
        slidesPerView: 3.25,
        spaceBetween: 15
      },
      500: {
        slidesPerView: 2.25,
        spaceBetween: 15
      }
    }
  });

  document.querySelectorAll('.ebd-video-collection-grid .slide-wrapper').forEach(function(wrapper) {
    const video = wrapper.querySelector('video');
    const mediaWrapper = wrapper.querySelector('.media-wrapper');

    wrapper.addEventListener('mouseenter', function() {
      if (video) {
        video.currentTime = 0;
        video.play();
        mediaWrapper.classList.add('playing');
      }
    });

    wrapper.addEventListener('mouseleave', function() {
      if (video) {
        video.pause();
        video.currentTime = 0;
        mediaWrapper.classList.remove('playing');
      }
    });
  });
{% endjavascript %}
