<section class="ebd-video-collection-grid">
  {%- if section.settings.show_leaves -%}
    {%- comment -%} Faint leaf decoration from Figma V1 (Frame 55); continues into the From the Waves section below {%- endcomment -%}
    <img
      class="bg-decoration bg-decoration--left"
      src="{{ 'hp-lineup-leaves-left.svg' | asset_url }}"
      alt=""
      width="276"
      height="565"
      loading="lazy"
      aria-hidden="true"
    >
    <img
      class="bg-decoration bg-decoration--right"
      src="{{ 'hp-lineup-leaves-right.svg' | asset_url }}"
      alt=""
      width="340"
      height="212"
      loading="lazy"
      aria-hidden="true"
    >
  {%- endif -%}

  <div class="content-wrapper">
    <div class="heading">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="darkblue">
        {{ section.settings.heading }}
      </h2>
    </div>
    <div class="swiper">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link_url }}" class="slide-wrapper" title="{{ block.settings.link_text }}">
              <div class="media-wrapper">
                <video src="{{ block.settings.video.sources[1].url }}" muted loop playsinline></video>
                <img class="poster" loading="lazy" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.link_text }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
              </div>
              <h4 class="label">{{ block.settings.link_text }}</h4>
            </a>
          </div>
        {% endfor %}
      </div>
      <div class="swiper-scrollbar swiper-scrollbar-darkblue"></div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "HP Video Collection Grid",
    "settings": [
      {
        "id": "eyebrow",
        "type": "text",
        "label": "Eyebrow text",
        "default": "Fuel your lifestyle"
      },
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      },
      {
        "type": "header",
        "content": "Background decoration"
      },
      {
        "id": "show_leaves",
        "type": "checkbox",
        "label": "Show leaf decoration",
        "default": true
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Collection",
        "settings": [
          {
            "id": "image",
            "type": "image_picker",
            "label": "Image"
          },
          {
            "id": "video",
            "type": "video",
            "label": "Video"
          },
          {
            "id": "link_url",
            "type": "url",
            "label": "Link URL"
          },
          {
            "id": "link_text",
            "type": "text",
            "label": "Link Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "HP Video Collection Grid",
        "category": "Home Page"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.ebd-video-collection-grid {
    position: relative;
    padding: 75px 44px 50px;
    overflow: hidden;
    background-color: var(--color-mediumgray);

    /* Leaves (Figma: 276px bottom-left, 340px bottom-right at 1440). Scales down below 1440. */
    .bg-decoration {
      position: absolute;
      bottom: 0;
      height: auto;
      pointer-events: none;
    }

    .bg-decoration--left {
      left: 0;
      width: min(276px, 19.2vw);
    }

    .bg-decoration--right {
      right: 0;
      width: min(340px, 23.6vw);
    }

    .content-wrapper {
      max-width: 1600px;
      margin: 0 auto;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 35px;
      align-items: stretch;

      > .swiper {
        width: 100%;
        min-width: 0;
      }

      /* The section's custom CSS (theme editor) centers .swiper-wrapper. That only works while all
         tiles fit; once the slider scrolls it shifts the first tiles off-screen. Keep the centering
         for the locked (non-scrolling) state only. */
      > .swiper:not(.swiper-lock) > .swiper-wrapper {
        justify-content: flex-start !important;
      }

      .heading {
        display: flex;
        flex-direction: column;
        gap: 5px;
        text-align: center;

        .eyebrow {
          margin: 0;
          color: var(--color-red-2);
          font-size: 24px;
          line-height: 28px;
          font-weight: 700;
          text-transform: uppercase;
        }

        h2 {
          margin: 0;
        }
      }

      .slide-wrapper {
        display: block;
        border-radius: 8px;
        overflow: hidden;
      }

      .media-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 254 / 288;
        overflow: hidden;

        video,
        .poster {
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
          display: block;
        }

        .poster {
          z-index: 2;
          transition: opacity 0.2s ease;
        }

        &.playing {
          .poster {
            opacity: 0;
          }
        }
      }

      h4.label {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 70px;
        margin: 0;
        padding: 0 10px;
        background-color: var(--color-darkblue);
        color: white;
        font-size: 20px;
        line-height: 24px;
        font-weight: 700;
        text-align: center;
        text-transform: uppercase;
      }
    }

    .swiper .swiper-scrollbar {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      width: 261px;
      max-width: 100%;
      margin: 28px auto 0;

      &.swiper-scrollbar-lock {
        display: none;
      }
    }

    @media (max-width: 768px) {
      padding: 48px 20px;

      /* Same leaves at ~0.7 scale, like From the Waves on mobile */
      .bg-decoration--left {
        width: 198px;
      }

      .bg-decoration--right {
        width: 237px;
      }

      .content-wrapper {
        gap: 24px;

        .heading .eyebrow {
          font-size: 18px;
          line-height: 20px;
        }
      }
    }
  }
{% endstylesheet %}

{% javascript %}
  const swiper = new Swiper('.ebd-video-collection-grid .swiper', {
    slidesPerView: 1.35,
    spaceBetween: 20,
    watchOverflow: true,
    scrollbar: {
      el: '.ebd-video-collection-grid .swiper-scrollbar',
      draggable: true
    },
    breakpoints: {
      1200: {
        slidesPerView: 5
      },
      1000: {
        slidesPerView: 4.5
      },
      700: {
        slidesPerView: 3.25
      },
      500: {
        slidesPerView: 2.25
      }
    }
  });

  document.querySelectorAll('.ebd-video-collection-grid .slide-wrapper').forEach(function(wrapper) {
    const video = wrapper.querySelector('video');
    const mediaWrapper = wrapper.querySelector('.media-wrapper');

    wrapper.addEventListener('mouseenter', function() {
      if (video) {
        video.currentTime = 0;
        video.play();
        mediaWrapper.classList.add('playing');
      }
    });

    wrapper.addEventListener('mouseleave', function() {
      if (video) {
        video.pause();
        video.currentTime = 0;
        mediaWrapper.classList.remove('playing');
      }
    });
  });
{% endjavascript %}
