<section class="ebd-product-main">
  <div class="content-wrapper">
    <div class="product-media-column" style="background-color: {{ product.metafields.custom.background_color }}">
      {% assign quote_rendered = false %}

      {%- comment -%} DESKTOP GRID WRAPPER {%- endcomment -%}
      <div class="ebd-media-desktop">
        {% assign row_open = false %}
      {% for media in product.media limit: 7 %}
          {% assign i = forloop.index %}

          {% if i == 1 or i == 4 %}
            {% case media.media_type %}
              {% when 'image' %}
                <a href="{{ media | image_url }}" target="_blank" class="zoom-clickable">
                  {{ media | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                </a>
              {% when 'video' %}
                {{ media | video_tag: controls: true }}
              {% when 'external_video' %}
                {{ media | external_video_tag }}
            {% endcase %}
          {% endif %}

          {% if i == 2 or i == 5 %}
            <div class="ebd-media-row">
            {% assign row_open = true %}
          {% endif %}

          {% if i == 2 or i == 3 or i == 5 or i == 6 %}
            <div class="ebd-media-half">
              {% case media.media_type %}
                {% when 'image' %}
                  <a href="{{ media | image_url }}" target="_blank" class="zoom-clickable">
                    {{ media | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                  </a>
                {% when 'video' %}
                  {{ media | video_tag: controls: true }}
                {% when 'external_video' %}
                  {{ media | external_video_tag }}
              {% endcase %}
            </div>
          {% endif %}

          {% if i == 3 or i == 6 %}
            </div>
            {% assign row_open = false %}
          {% endif %}

          {% if i == 6 and quote_rendered == false %}
            {% render 'ebd-product-media-quote' %}
            {% assign quote_rendered = true %}
          {% endif %}
        {% endfor %}
        {% if row_open %}</div>{% endif %}
      </div>

      {%- comment -%} MOBILE SWIPER WRAPPER {%- endcomment -%}
      <div class="ebd-media-mobile">
        <div class="swiper">
          <div class="swiper-wrapper">
            {% assign quote_rendered_mobile = false %}

            {% for media in product.media limit: 7 %}
              <div class="swiper-slide">
                {% case media.media_type %}
                  {% when 'image' %}
                    <a href="{{ media | image_url }}" target="_blank" class="zoom-clickable">
                      {{ media | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                    </a>
                  {% when 'video' %}
                    {{ media | video_tag: controls: true }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag }}
                {% endcase %}
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="swiper-scrollbar"></div>
      </div>
    </div>

    <div class="product-information-column">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when '@theme' %}
            {% render block %}
          {% when '@app' %}
            {% render block %}
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "EBD Product Main",
  "templates": ["product"],
  "settings": [],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "EBD Product Main",
      "category": "EBD Product"
    }
  ]
}
{% endschema %}

{% stylesheet "scss" %}
section.ebd-product-main {
  .content-wrapper {
    display: flex;
    max-width: 1600px;

    .product-media-column {
      width: 50%;
      padding: 25px 45px;

      .ebd-media-mobile {
        display: none;
      }

      /* Zoom Effect Styling */
      .zoom-clickable {
        position: relative;
        display: block;
        cursor: zoom-in;
        margin: 10px;
        overflow: hidden;
        border-radius: 7px;

        &::after {
          content: '';
          position: absolute;
          bottom: 15px;
          right: 15px;
          width: 32px;
          height: 32px;
          background-color: rgba(255, 255, 255, 0.9);
          background-image: url('data:image/svg+xml;charset=UTF-8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>');
          background-size: 60%;
          background-position: center;
          background-repeat: no-repeat;
          border-radius: 50%;
          opacity: 0;
          transform: scale(0.8);
          transition: all 0.2s ease-in-out;
          pointer-events: none;
          z-index: 5;
        }

        &:hover::after {
          opacity: 1;
          transform: scale(1);
        }

        &:hover img {
          filter: brightness(0.95);
        }

        img:not(.w-32) {
          margin: 0 !important; /* Margin is now handled by .zoom-clickable */
          background-color: rgba(255,255,255,0.5);
          width: 100%;
          display: block;
        }
      }

      img.w-32 {
        width: auto !important;
        max-width: 150px !important;
        margin: 20px 0px !important;
      }

      .ebd-media-row {
        display: flex;
        gap: 20px;
      }

      .ebd-media-half {
        width: 50%;
        .zoom-clickable { margin: 10px 0; }
      }
    }

    .product-information-column {
      width: 50%;
      padding: 65px 45px;
    }
  }

  @media (max-width: 1024px) {
    .content-wrapper {
      .product-media-column {
        width: 45%;
        padding: 25px 15px;

        .zoom-clickable {
          margin: 0 0 10px;
        }

        .ebd-media-row {
          gap: 10px;
        }
      }

      .product-information-column {
        width: 55%;
        padding: 65px 20px;
      }
    }
  }

  @media (max-width: 768px) {
    .content-wrapper {
      flex-direction: column;

      .product-media-column {
        width: 100%;
        padding: 25px 15px 15px;

        .ebd-media-desktop {
          display: none;
        }

        .ebd-media-mobile {
          display: block;

          .zoom-clickable {
            margin: 0;
          }

          .swiper-slide {
            aspect-ratio: 1;

            video {
              width: 100%;
              height: 100%;
              object-fit: cover;
              border-radius: 7px;
            }
          }

          .swiper-scrollbar {
            position: relative;
            background: white;
            margin-top: 25px;
            
            .swiper-scrollbar-drag {
              background-color: #003349;
            }
          }
        }
      }

      .product-information-column {
        width: 100%;
      }
    }
  }
}
{% endstylesheet %}

<style>
  @media screen and (max-width:768px) {
    .ebd-product-media-quote img {
      background: transparent !important;
      max-width: 150px !important;
    }
  }
</style>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function() {
    const swiperEl = document.querySelector('.ebd-media-mobile .swiper');
    if (swiperEl) {
      const swiper = new Swiper(swiperEl, {
        slidesPerView: 1,
        spaceBetween: 10,
        loop: false,
        scrollbar: {
          el: '.ebd-media-mobile .swiper-scrollbar',
          draggable: true,
          clickable: true,
        },
      });
    }
  });
{% endjavascript %}