{%- liquid
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign image_alt = section.settings.image_alt | default: image.alt | escape
-%}

<section class="new-to-laird{% if image != blank or image_mobile != blank %} new-to-laird--has-image{% endif %}">
  {%- if image != blank or image_mobile != blank -%}
    <div class="new-to-laird__media">
      <picture>
        {%- if image_mobile != blank -%}
          <source
            media="(max-width: 768px)"
            srcset="{{ image_mobile | image_url: width: 400 }} 400w, {{ image_mobile | image_url: width: 800 }} 800w, {{ image_mobile | image_url: width: 1200 }} 1200w"
            sizes="100vw"
            width="{{ image_mobile.width }}"
            height="{{ image_mobile.height }}"
          >
        {%- endif -%}
        {%- if image != blank -%}
          <source
            media="(min-width: 769px)"
            srcset="{{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w"
            sizes="50vw"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
          <img
            src="{{ image | image_url: width: 1200 }}"
            alt="{{ image_alt }}"
            width="{{ image.width }}"
            height="{{ image.height }}"
          >
        {%- else -%}
          <img
            src="{{ image_mobile | image_url: width: 800 }}"
            alt="{{ image_alt }}"
            class="new-to-laird__mobile-only"
            width="{{ image_mobile.width }}"
            height="{{ image_mobile.height }}"
          >
        {%- endif -%}
      </picture>
    </div>
  {%- endif -%}

  <div class="content-wrapper">
    <div class="content">
      <div class="heading">
        {%- if section.settings.heading != blank -%}
          <h3 class="white">{{ section.settings.heading }}</h3>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="white">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
      <div class="link-wrapper">
        {%- if section.settings.link_1_label != blank -%}
          <a href="{{ section.settings.link_1_url }}" class="btn">{{ section.settings.link_1_label }}</a>
        {%- endif -%}
        {%- if section.settings.link_2_url != blank and section.settings.link_2_label != blank -%}
          <a href="{{ section.settings.link_2_url }}" class="btn">{{ section.settings.link_2_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "HP New To Laird",
    "settings": [
      {
        "type": "header",
        "content": "Image"
      },
      {
        "id": "image",
        "type": "image_picker",
        "label": "Image (desktop)",
        "info": "Shown on the left side of the banner. Use a transparent PNG so the background color shows around it."
      },
      {
        "id": "image_mobile",
        "type": "image_picker",
        "label": "Image (mobile)",
        "info": "Shown along the bottom of the banner. Falls back to the desktop image."
      },
      {
        "id": "image_alt",
        "type": "text",
        "label": "Image alt text",
        "info": "Defaults to the image's alt text."
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      },
      {
        "id": "text",
        "type": "text",
        "label": "Text"
      },
      {
        "id": "link_1_url",
        "type": "url",
        "label": "Link #1 URL"
      },
      {
        "id": "link_1_label",
        "type": "text",
        "label": "Link #1 Label"
      },
      {
        "id": "link_2_url",
        "type": "url",
        "label": "Link #2 URL"
      },
      {
        "id": "link_2_label",
        "type": "text",
        "label": "Link #2 Label"
      }
    ],
    "presets": [
      {
        "name": "HP New To Laird",
        "category": "Home Page"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.new-to-laird {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 231px;
    padding: 38px 45px;
    overflow: hidden;
    background-color: var(--color-mediumblue);

    .new-to-laird__media {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 49%;

      picture,
      img {
        display: block;
        width: 100%;
        height: 100%;
      }

      img {
        object-fit: cover;
        object-position: center;
      }

      .new-to-laird__mobile-only {
        display: none;
      }
    }

    .content-wrapper {
      position: relative;
      width: 100%;
      max-width: 1600px;
      margin: 0 auto;
      display: flex;
      justify-content: flex-end;
    }

    .content {
      width: min(528px, 48%);
      display: flex;
      flex-direction: column;
      gap: 25px;
    }

    .heading {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-bottom: 10px;

      h3 {
        margin: 0;
        font-size: 40px;
        line-height: 42px;
        font-weight: 700;
      }

      p {
        margin: 0;
      }
    }

    .link-wrapper {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 20px;
    }

    @media (max-width: 1024px) {
      .heading h3 {
        font-size: 32px;
        line-height: 36px;
      }
    }

    @media (max-width: 768px) {
      display: block;
      min-height: 0;
      padding: 25px 20px;

      &.new-to-laird--has-image {
        padding-bottom: 150px;
      }

      .new-to-laird__media {
        top: auto;
        width: 100%;
        height: 127px;

        img {
          object-position: center top;
        }

        .new-to-laird__mobile-only {
          display: block;
        }
      }

      .content {
        width: 100%;
        gap: 10px;
        text-align: center;
      }

      .heading {
        gap: 8px;
        padding-bottom: 0;

        h3 {
          font-size: 20px;
          line-height: 24px;
        }
      }

      .link-wrapper {
        justify-content: center;
        gap: 15px;
      }
    }
  }
{% endstylesheet %}
