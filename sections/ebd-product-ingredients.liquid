{% assign ingredients = product.metafields.custom.ingredients.value %}

{% if ingredients != blank %}
  <section class="ebd-ingredients">
    <div class="ebd-ingredients__container">
      <h1 class="ebd-ingredients__heading">{{ section.settings.heading }}</h1>

      <div class="ebd-ingredients__layout">
        <!-- Left column -->
        <aside class="ebd-ingredients__nav">
          <div class="ebd-ingredients__nav-inner">
            <select id="ingredient-select" class="ebd-ingredients__select">
              {% for ingredient in ingredients %}
                <option value="{{ forloop.index0 }}">{{ ingredient.name }}</option>
              {% endfor %}
            </select>

            <div class="ebd-ingredients__button-list" aria-label="Ingredients">
              {% for ingredient in ingredients %}
                <button
                  type="button"
                  class="ebd-ingredients__button ingredient-button {% if forloop.index0 == 0 %}is-active{% endif %}"
                  data-index="{{ forloop.index0 }}"
                >
                  <span class="ebd-ingredients__button-text">{{ ingredient.name }}</span>
                </button>
              {% endfor %}
            </div>
          </div>
        </aside>

        <!-- Right column -->
        <div class="ebd-ingredients__panel">
          {% for ingredient in ingredients %}
            <div
              class="ebd-ingredients__content ingredient-content {% if forloop.index0 != 0 %}is-hidden{% endif %}"
              data-index="{{ forloop.index0 }}"
            >
              <div class="ebd-ingredients__grid">
                <div class="ebd-ingredients__media">
                  {% if ingredient.image != blank %}
                    {{
                      ingredient.image
                      | image_url: width: 450
                      | image_tag:
                        class: 'ebd-ingredients__image',
                        alt: ingredient.name
                    }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'ebd-ingredients__image' }}
                  {% endif %}
                </div>

                <div class="ebd-ingredients__details">
                  <h2 class="ebd-ingredients__title">{{ ingredient.name }}</h2>
                  <p class="ebd-ingredients__description">{{ ingredient.description }}</p>

                  {% assign highlights = ingredient.highlights | metafield_tag | split: ', ' %}
                  {% if highlights.size > 0 %}
                    <div class="ebd-ingredients__highlights">
                      <h3 class="ebd-ingredients__highlights-title">Highlights:</h3>

                      <div class="ebd-ingredients__highlights-list">
                        {% for highlight in highlights %}
                          <div class="ebd-ingredients__highlight">{{ highlight }}</div>
                        {% endfor %}
                      </div>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </section>
{% endif %}

{% style %}
  .ebd-ingredients {
    background: #f5f3f0;

    .ebd-ingredients__container {
      width: 100%;
      max-width: 1600px;
      margin: 0 auto;
      padding: 80px 16px;
    }

    .ebd-ingredients__heading {
      margin: 0 0 40px;
      text-align: center;
      font-size: 40px;
      font-weight: 700;
      line-height: 1.15;
      color: #000;
    }

    .ebd-ingredients__layout {
      display: flex;
      flex-direction: column;
      gap: 32px;
      min-height: 592px;
    }

    .ebd-ingredients__nav {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;

      .ebd-ingredients__nav-inner {
        height: 100%;
        padding: 0;
      }

      .ebd-ingredients__select {
        display: block;
        width: 100%;
        height: 64px;
        padding: 0 16px;
        background: #fff;
        border: 2px solid #d8e3e8;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        color: #000;
      }

      .ebd-ingredients__button-list {
        display: none;
        padding: 16px;
      }

      .ebd-ingredients__button {
        display: block;
        width: 100%;
        text-align: left;
        padding: 10px 16px;
        margin: 0 0 10px;
        border-radius: 999px;
        border: 2px solid transparent;
        background: transparent;
        cursor: pointer;
        transition: background 0.2s ease, border-color 0.2s ease;

        .ebd-ingredients__button-text {
          display: block;
          white-space: nowrap;
          overflow: hidden;
          text-overflow: ellipsis;
          font-size: 16px;
          font-weight: 600;
          color: #000;
        }

        &.is-active {
          background: #d8e3e8;
          border-color: #3a758a;
        }

        &:last-child {
          margin-bottom: 0;
        }
      }
    }

    .ebd-ingredients__panel {
      background: #fff;
      border-radius: 12px;
      overflow: hidden;

      .ebd-ingredients__content {
        height: 100%;

        &.is-hidden {
          display: none;
        }

        .ebd-ingredients__grid {
          display: grid;
          grid-template-columns: 1fr;
          gap: 16px;
          height: 100%;

          .ebd-ingredients__media {
            height: 100%;

            .ebd-ingredients__image {
              width: 100%;
              height: 100%;
              object-fit: cover;
              display: block;
              border-radius: 12px 12px 0 0;
            }
          }

          .ebd-ingredients__details {
            padding: 32px 24px;

            .ebd-ingredients__title {
              margin: 0 0 16px;
              color: #000;
              font-size: 24px;
              font-weight: 700;
              text-transform: uppercase;
              line-height: 1.2;
            }

            .ebd-ingredients__description {
              margin: 0 0 48px;
              color: #424242;
              font-size: 16px;
              font-weight: 500;
              line-height: 1.45;
            }

            .ebd-ingredients__highlights-title {
              margin: 0 0 16px;
              color: #3a758a;
              font-size: 16px;
              font-weight: 600;
              text-transform: uppercase;
              line-height: 1.3;
            }

            .ebd-ingredients__highlights-list {
              display: grid;
              gap: 24px;
            }
          }
        }
      }
    }

    @media (min-width: 640px) {
      .ebd-ingredients__container {
        padding: 96px 24px;
      }

      .ebd-ingredients__nav {
        .ebd-ingredients__select {
          height: 48px;
        }
      }

      .ebd-ingredients__panel {
        .ebd-ingredients__content {
          .ebd-ingredients__grid {
            .ebd-ingredients__media {
              .ebd-ingredients__image {
                border-radius: 12px 0 0 12px;
              }
            }
          }
        }
      }
    }

    @media (min-width: 1024px) {
      .ebd-ingredients__layout {
        flex-direction: row;
      }

      .ebd-ingredients__nav {
        width: 33.333%;

        .ebd-ingredients__select {
          display: none;
        }

        .ebd-ingredients__button-list {
          display: block;
        }
      }

      .ebd-ingredients__panel {
        width: 66.666%;

        .ebd-ingredients__content {
          .ebd-ingredients__grid {
            grid-template-columns: 1fr 1fr;

            .ebd-ingredients__media {
              .ebd-ingredients__image {
                border-radius: 12px 0 0 12px;
              }
            }
          }
        }
      }
    }
  }
{% endstyle %}


{% schema %}
{
  "name": "EBD Product Ingredients",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ingredients"
    }
  ],
  "presets": [
    {
      "name": "EBD Product Ingredients"
    }
  ]
}
{% endschema %}

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    const ingredientSelect = document.getElementById('ingredient-select');
    const ingredientButtons = document.querySelectorAll('.ingredient-button');
    const ingredientContents = document.querySelectorAll('.ingredient-content');

    function setActiveIngredient(index) {
      ingredientButtons.forEach((button) => button.classList.remove('is-active'));
      if (ingredientButtons[index]) ingredientButtons[index].classList.add('is-active');

      ingredientContents.forEach((content) => content.classList.add('is-hidden'));
      if (ingredientContents[index]) ingredientContents[index].classList.remove('is-hidden');

      if (ingredientSelect && String(ingredientSelect.value) !== String(index)) {
        ingredientSelect.value = String(index);
      }
    }

    if (ingredientSelect) {
      ingredientSelect.addEventListener('change', function () {
        setActiveIngredient(parseInt(this.value, 10));
      });
    }

    ingredientButtons.forEach((button) => {
      button.addEventListener('click', function () {
        setActiveIngredient(parseInt(this.getAttribute('data-index'), 10));
      });
    });

    setActiveIngredient(0);
  });
{% endjavascript %}
