<section class="ebd-page">
  <div class="content-wrapper">
    <h1 class="darkblue">{{ page.title }}</h1>
    <div class="main-content">
      {{ page.content }}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
  ]
}
{% endschema %}

{% stylesheet %}
  section.ebd-page {
    padding: 65px;
    
    .content-wrapper {
      max-width: 1400px;
      margin: 0 auto;

      h1 {
        font-size: 48px;
        line-height: 54px;
      }
    }

    @media (max-width: 1024px) {
      padding: 65px 45px;

      .content-wrapper {
        h1 {
          font-size: 38px;
          line-height: 44px;
        }
      }
    }

    @media (max-width: 1024px) {
      padding: 35px 25px;

      .content-wrapper {
        h1 {
          font-size: 28px;
          line-height: 32px;
        }
      }
    }
  }
{% endstylesheet %}
