{%- comment -%}
  Only for the templates that show the Recharge widget itself. Mahalo hides it behind the
  theme's own purchase options, whose every number is read from the product's selling plans and
  variants, so the hardcoded percentages below have nothing to correct there and would be the
  one invented figure left on the page.
{%- endcomment -%}
{%- unless template.suffix == 'mahalo' -%}
<script>
  (function () {
    // The Recharge widget prints the selling plan discount as it works it out per variant
    // (5.88% off the three pack); the store advertises the headline 20%. Rewrite it inside the
    // widget's own shadow root. The previous version watched document.body with a subtree
    // MutationObserver that was never disconnected and walked the whole shadow tree on every
    // mutation of the page, which on a PDP with this many apps never stops costing.
    const OLD_PERCENT = '5.88%';
    const NEW_PERCENT = '20%';

    const rewrite = (root) => {
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, null, false);
      let node;
      while ((node = walker.nextNode())) {
        if (node.nodeValue.includes(OLD_PERCENT)) {
          node.nodeValue = node.nodeValue.split(OLD_PERCENT).join(NEW_PERCENT);
        }
      }
    };

    const attach = () => {
      const widget = document.querySelector('recharge-subscription-widget');
      if (!widget || !widget.shadowRoot) return false;

      rewrite(widget.shadowRoot);
      // Scoped to the widget, so a variant change still gets rewritten without the rest of the
      // page paying for it. Rewriting only when the old text is found means our own writes
      // wake the observer once and then settle.
      new MutationObserver(() => rewrite(widget.shadowRoot)).observe(widget.shadowRoot, {
        childList: true,
        subtree: true,
        characterData: true,
      });
      return true;
    };

    if (attach()) return;

    // The widget hydrates itself, so wait for its shadow root, then give up rather than poll
    // for the life of the page.
    const poll = setInterval(() => {
      if (attach()) clearInterval(poll);
    }, 200);
    setTimeout(() => clearInterval(poll), 10000);
  })();
</script>
{%- endunless -%}
