<script>
  (function() {
    // Configuration: Change these to match exactly what you want
    const oldPercent = "5.88%";
    const newPercent = "20%";

    const updateRechargeWidget = () => {
      // 1. Find the Recharge Widget
      const widget = document.querySelector('recharge-subscription-widget');
      
      if (widget && widget.shadowRoot) {
        // 2. Look through all text nodes inside the Shadow DOM
        const walker = document.createTreeWalker(
          widget.shadowRoot, 
          NodeFilter.SHOW_TEXT, 
          null, 
          false
        );

        let node;
        while (node = walker.nextNode()) {
          if (node.nodeValue.includes(oldPercent)) {
            // 3. Replace the old percentage with the new one
            node.nodeValue = node.nodeValue.split(oldPercent).join(newPercent);
          }
        }
      }
    };

    // Run the function when the page loads
    window.addEventListener('load', updateRechargeWidget);

    // Also run it periodically for 3 seconds to catch the widget if it loads late
    const interval = setInterval(updateRechargeWidget, 500);
    setTimeout(() => clearInterval(interval), 3000);

    // Watch for changes (in case user switches variants)
    const observer = new MutationObserver(updateRechargeWidget);
    observer.observe(document.body, { childList: true, subtree: true });
  })();
</script>