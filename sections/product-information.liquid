{% liquid
  if section.settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  assign product_has_media = true
  if closest.product.media.size == 0
    assign product_has_media = false
  endif

  assign product_grid_class = 'product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' product-information--media-none'
  elsif section.settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' product-information--media-left'
  endif

  if section.settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' product-information__grid--half'

    if section.settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' product-information__grid--limit-details'
    endif
  endif

  case section.settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase

  # Product page background. Preferred: a hex color picked on the product
  # (metafield custom.product_page_background_color) that fades into the page background.
  # Legacy: custom.product_page_background holding keyword classes (red gradient, gold gradient, ...).
  assign pdp_background_class = product.metafields.custom.product_page_background | downcase | strip
  assign pdp_background_color = product.metafields.custom.product_page_background_color | strip

  # The legacy text metafield may also hold a hex, so merchants can switch without a new field
  if pdp_background_color == blank
    assign pdp_background_first_char = pdp_background_class | slice: 0
    if pdp_background_first_char == "#"
      assign pdp_background_color = pdp_background_class
      assign pdp_background_class = ""
    endif
  endif

  if pdp_background_color != blank
    assign pdp_background_class = "gradient"
  endif
%}

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="product-information new-section section section--{{ content_width }} spacing-style color-{{ section.settings.color_scheme }} relative{% if section.settings.custom_mobile_padding %} product-information--custom-mobile-padding{% endif %} {% if pdp_background_class != blank %} {{ pdp_background_class }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %} --gap: {{ section.settings.gap }}px;
    {%- if section.settings.custom_mobile_padding -%}
      --padding-block-start-mobile: {{ section.settings['padding-block-start-mobile'] }}px;
      --padding-block-end-mobile: {{ section.settings['padding-block-end-mobile'] }}px;
    {%- endif -%}
    {%- if pdp_background_color != blank -%}
      --pdp-gradient-color: {{ pdp_background_color }};
    {%- endif -%}
  "
>
  {% if section.settings.desktop_media_position == 'left' and product_has_media %}
    {% assign product_href = '#ProductInformation-' | append: section.id %}
    {% render 'skip-to-content-link', href: product_href, text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  {% content_for 'blocks' %}

  <div
    class="{{ product_grid_class }}"
    data-product-grid-content
  >
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="product-information__media"
        data-testid="product-information-media"
      >
        {%- content_for 'block',
          type: '_product-media-gallery',
          id: 'media-gallery',
          closest.product: closest.product
        -%}
      </div>
    {% endcapture %}

    {% capture details %}
      {% content_for 'block',
        type: '_product-details',
        id: 'product-details',
        closest.product: closest.product
      %}
    {% endcapture %}

    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ details }}
      {% endif %}
    {% endfor %}
  </div>
</div>

{%- comment -%}
  Mahalo runs its own custom purchase options UI: the Recharge widget is hidden and proxied
  behind our markup, with the copy coming from this section's settings. new-mahalo still uses
  the older hard-coded snippet. Add a template suffix here to roll this one out further.
{%- endcomment -%}
{%- if template.suffix == 'mahalo' -%}
  {%- render 'purchase-options-mahalo', product: closest.product, section: section -%}
  {% render 'purchase-options-sync',
    root_selector: '.product-information',
    show_price_in_button: section.settings.po_show_price_in_button
  %}
{%- endif -%}

{% stylesheet %}
  .product-information {
    gap: var(--gap) 0;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  .product-details {
    background-color: var(--color-mediumgray);
    border-radius: 12px;
    padding-left: 24px;
    padding-right: 24px;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 1 / -1;
      padding-left: 10px;
      padding-right: 10px;
      border-radius: 8px;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    .section--page-width .product-information__grid,
    .section--page-width .new-product-information__grid {
      max-width: 1440px;
      margin: auto;
      width: 100%;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none,
    .product-information__grid:has(.product-information__media:empty) {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(:has(.product-information__media:empty)) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information__media {
          padding-right: calc(var(--gap, 0) * 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) * 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) * 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) * 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(:has(.product-information__media:empty)),
      .product-information__grid:not(:has(.product-information__media:empty)) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        :has(.product-information__media:empty)
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        :has(.product-information__media:empty)
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    max-width: var(--sidebar-width);
  }

  /* Swatch rows keep their original layout: the wrapper stays out of the way */
  .product-information .variant-option--swatches .variant-option__buttons-row {
    display: contents;
  }

  /* One equal column per visible option: 4 options give 4 columns, 3 give 3. */
  .product-information .variant-option--buttons:not(.variant-option--swatches) {
    display: block;
  }

  .product-information .variant-option--buttons:not(.variant-option--swatches) legend {
    width: 100%;
    margin-block-end: 12px;
  }

  .product-information .variant-option--buttons:not(.variant-option--swatches) .variant-option__buttons-row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    align-items: stretch;
    gap: 8px;
    width: 100%;
  }

  .product-information .variant-option--buttons:not(.variant-option--swatches) .variant-option__buttons-row:has(> :nth-child(5)) {
    grid-auto-flow: row;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .product-information .variant-option--buttons:not(.variant-option--swatches) .variant-option__buttons-row .variant-option__button-label {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  /* Badges shown above a variant button (see snippets/variant-badges.liquid) */
  /* Reserve room for the badge on the whole row so the buttons stay aligned */
  .product-information .variant-option__buttons-row:has(.variant-option__button-label--has-selling-badge) {
    padding-block-start: 8px;
  }

  .product-information .variant-option__button-label--has-selling-badge {
    position: relative;
    overflow: visible;
  }

  .product-information .variant-option__button-label__selling-badge {
    position: absolute;
    left: 50%;
    z-index: 3;
    max-width: calc(100% + 16px);
    pointer-events: none;
    white-space: nowrap;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 0 8px;
    min-height: 18px;
    border-radius: 4px;
    background: var(--variant-badge-background, var(--color-rose-46, #ea0044));
    color: var(--variant-badge-text-color, var(--color-white-solid, #fff));
    font-family: var(--font-family-Font-1, Rubik);
    font-size: 12px;
    font-weight: 500;
    line-height: 100%;
    letter-spacing: var(--letter-spacing-0_3, 0);
    text-align: center;
    box-sizing: border-box;
  }

  /* The first badge sits above the button, the second below it */
  .product-information .variant-option__button-label__selling-badge--top {
    top: 0;
    transform: translate(-50%, -70%);
  }

  .product-information .variant-option__button-label__selling-badge--bottom {
    bottom: 0;
    transform: translate(-50%, 70%);
  }

  /* The variant buttons draw their outline with pseudo elements (see custom.css), so
     tint those too and match their specificity. */
  .product-information .variant-option__button-label--badge-highlight,
  .product-information fieldset.variant-option--buttons label.variant-option__button-label--badge-highlight::before,
  .product-information fieldset.variant-option--buttons label.variant-option__button-label--badge-highlight::after {
    border-color: var(--variant-badge-border-color, var(--color-rose-46, #ea0044));
  }

  /* Section setting: separate top and bottom padding on mobile */
  @media screen and (max-width: 749px) {
    .product-information--custom-mobile-padding.spacing-style {
      padding-block: calc(var(--padding-block-start-mobile, 0px) + var(--section-top-offset, 0px))
        var(--padding-block-end-mobile, 0px);
    }
  }

  @media screen and (min-width: 750px) {
    .product-information__grid--limit-details .product-details > .group-block {
      max-width: 100%;
      padding-top: 36px;
    }
  }

  @media (min-width: 1200px) {
    .rating-wrapper-link {
      position: absolute;
      top: 0;
      right: 0;
    }
  }

  /* Grid items stretch by default, which leaves the sticky column no room to travel */
  @media screen and (min-width: 750px) {
    .product-details.sticky-content--desktop {
      align-self: start;
    }
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  /* Custom purchase options (snippets/purchase-options-mahalo.liquid) */
  .new-purchase-options {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    border: none;
    padding: 0;
    margin: 0;
  }

  .new-purchase-options .new-po-legend {
    color: var(--lairdsuperfood-com-black, var(--color-black-solid, #000)) !important;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0) !important;
    font-family: var(--font-family-Font-1, Rubik) !important;
    font-size: 14px !important;
    font-style: normal !important;
    font-weight: var(--font-weight-700, 700) !important;
    line-height: 20px !important;
    padding: 0;
    margin: 0 0 4px 0;
    display: none;
  }

  .new-po-option {
    border: 1px solid var(--color-azure-88, #888888);
    border-radius: 12px;
    overflow: hidden;
    background: transparent;
  }

  .new-po-option:has(.new-po-radio-input:checked) {
    border-width: 2px;
    border-color: var(--color-azure-14, #003349);
    background: #FFFFFF;
  }

  .new-po-option__row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    cursor: pointer;
    width: 100%;
  }

  .new-po-option:has(.new-po-radio-input:checked) .new-po-option__row {
    /* Keep the content from shifting when the border grows from 1.5px to 2px */
    padding: 15.5px 17.5px;
  }

  .new-po-radio-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .new-po-radio-indicator {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--color-azure-88, #DBE3E7);
    background: #fff;
    position: relative;
    transition: border-color 0.15s;
  }

  .new-po-radio-input:checked ~ .new-po-radio-indicator {
    border-color: var(--color-azure-14, #003349);
  }

  .new-po-radio-input:checked ~ .new-po-radio-indicator::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--color-azure-14, #003349);
  }

  .new-po-option__title {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    color: var(--lairdsuperfood-com-prussian-blue, var(--color-azure-14, #003349));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: 20px;
    font-style: normal;
    font-weight: 600;
    line-height: 28px;
  }

  /* Inherits the size of the title it sits in, so "Subscribe & Save" and the percentage read
     as one line and the row keeps its height at every breakpoint the title is resized at. */
  .new-po-discount-badge {
    display: inline-flex;
    padding: 2px 8px;
    justify-content: center;
    align-items: center;
    border-radius: 4px;
    background: var(--color-rose-46, #EA0044);
    color: var(--color-white-solid, #FFF);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: inherit;
    font-style: normal;
    font-weight: 700;
    line-height: inherit;
    white-space: nowrap;
  }

  .new-po-prices {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-shrink: 0;
    margin-left: auto;
  }

  .new-po-price {
    font-family: var(--font-family-Font-1, Rubik);
    font-style: normal;
  }

  .new-po-price--compare {
    color: var(--lairdsuperfood-com-bismark, var(--color-azure-42, #595959));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-size: var(--font-size-16, 16px);
    font-weight: 400;
    line-height: var(--font-size-24, 16px);
    text-decoration-line: line-through;
  }

  .new-po-price--sub,
  .new-po-price--regular {
    color: var(--lairdsuperfood-com-prussian-blue, var(--color-azure-14, #003349));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-size: 16px;
    font-weight: 600;
    line-height: 20px;
  }

  .new-po-option__body {
    padding: 0 18px 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .new-po-benefits-extra[hidden] {
    display: none !important;
  }

  .new-po-benefits-list,
  .new-po-benefits-extra {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .new-po-benefits-extra {
    margin-top: -4px;
  }

  .new-po-benefit {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--lairdsuperfood-com-prussian-blue, var(--color-azure-14, #003349));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-16, 16px);
    font-style: normal;
    font-weight: 400;
    line-height: var(--font-size-24, 24px);
  }

  .new-po-check-icon {
    color: var(--color-azure-14, #B2D6E1);
    flex-shrink: 0;
  }

  .new-po-see-more {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-azure-10, #012332);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-14, 14px);
    font-style: normal;
    font-weight: 600;
    line-height: var(--font-size-24, 24px);
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-decoration-skip-ink: auto;
    text-transform: uppercase;
    text-align: left;
  }

  .new-po-see-more:hover {
    opacity: 0.85;
  }

  .new-po-frequency {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .new-po-frequency__label {
    display: none;
  }

  .new-po-select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .new-po-frequency-select {
    width: 100%;
    appearance: none;
    background: transparent;
    border: 2px solid var(--color-azure-88, #DBE3E7);
    border-radius: 10px;
    padding: 12px 16px;
    color: var(--lairdsuperfood-com-prussian-blue, var(--color-azure-14, #003349));
    font-size: var(--font-size-16, 16px);
    font-style: normal;
    font-weight: 700;
    line-height: var(--font-size-24, 24px);
    cursor: pointer;
  }

  .new-po-frequency-select:focus {
    outline: 2px solid var(--color-azure-14, #003349);
    outline-offset: 2px;
  }

  .new-po-select-arrow {
    position: absolute;
    right: 16px;
    pointer-events: none;
    color: var(--color-azure-14, #003349);
    display: flex;
    align-items: center;
  }

  @media (max-width: 1023px) {
    .new-po-radio-indicator {
      width: 18px;
      height: 18px;
    }

    .new-po-option__title {
      font-size: 16px;
      line-height: 24px;
    }
  }

  @media (max-width: 767px) {
    .new-po-option__title,
    .new-po-benefit,
    .new-po-frequency-select {
      font-size: 14px;
      line-height: 20px;
    }

    .new-po-price--compare,
    .new-po-price--sub,
    .new-po-price--regular {
      font-size: 14px;
      line-height: 18px;
    }
  }

  @media (max-width: 390px) {
    .new-po-option__row,
    .new-po-option:has(.new-po-radio-input:checked) .new-po-option__row {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product_information",
  "blocks": [
    {
      "type": "breadcrumbs"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "content-center-aligned",
          "label": "t:options.page"
        },
        {
          "value": "content-full-width",
          "label": "t:options.full"
        }
      ],
      "default": "content-center-aligned"
    },
    {
      "type": "select",
      "id": "desktop_media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "equal_columns",
      "label": "t:settings.equal_columns",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "limit_details_width",
      "label": "t:settings.limit_product_details_width",
      "default": true,
      "visible_if": "{{ section.settings.equal_columns }}"
    },
    {
