<section class="manage-subscriptions-heading">
  <div class="container">
    <div class="heading">
      <h1 class="small darkblue">{{ section.settings.heading }}</h1>
      <div class="link-wrapper">
        <a
        href="/account"
        class="btn btn-outline-darkblue"
        >Back to Account</a>
        <a
        href="/tools/recurring/login/"
        class="btn btn-outline-darkblue"
        >Manage Subscriptions</a>
      </div>
    </div> 
  </div>
</section>

{% schema %}
  {
    "name": "EBD Manage Subs Heading",
    "settings": [
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      }
    ],
    "presets": [
      {
        "name": "EBD Manage Subs Heading",
        "category": "Manage Subs"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.manage-subscriptions-heading {
    background-color: #f1ede7;
    .heading {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 65px 0;

      h1 {
        text-align: center;
        margin-bottom: 25px;
      }

      .link-wrapper {
        display: flex;
        gap: 10px;
      }
    }
  }
{% endstylesheet %}