$(document).ready(function() {
  var emailField = $('[name="contact[email]"]');
  var nameField = $('[name="contact[Contact Name]"]');
  var inqueryField = $('[name="contact[Type of Inquiry]"]');
  var textField = $('[name="contact[Message]"]');
  var contactSignup = $('#contact_signup');
  var phoneField = $('[name="contact[Phone]"]');
  var regEx = /^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
  
  inqueryField.on('keyup change', function(){
	if ($(this).val().length > 0) {
	  $(this).parent().removeClass('error');
	}
  })
  
  nameField.on('keyup change', function(){
	contactSignup.find('[name="first_name"]').val($(this).val());
	if ($(this).val().length > 0) {
	  $(this).parent().removeClass('error');
	}
  })
  
  emailField.on('keyup change', function(){
	contactSignup.find('[name="email"]').val($(this).val());
    var validEmail = regEx.test($(this).val());
	if (validEmail) {
	  $(this).parent().removeClass('error');
	}
  })
  
  phoneField.on('keyup change', function(){
	contactSignup.find('[name="phone_number"]').val($(this).val());
  })
  
  textField.on('keyup change', function(){
	if ($(this).val().length > 0) {
	  $(this).parent().removeClass('error');
	}
  })
  
  KlaviyoSubscribe.attachToForms('#contact_signup', {
	hide_form_on_success: true,
	extra_properties: {
	  $source: 'ContactUs'
	},
	success: function(){
	  $('#contact_form').submit();
	}
  });
  
  $('.contact-form-submit').on('click', function(e){
	e.preventDefault();
	var inquery = inqueryField.val();
	var email = emailField.val();
	var name = nameField.val();
	var text = textField.val();
	
	$(this).find(".error").removeClass('error');
	
	if (name.length < 1) {
	  nameField.parent().addClass('error');
	}
	
	if (inquery.length < 1) {
	  inqueryField.parent().addClass('error');
	}
	
	if (text.length < 1) {
	  textField.parent().addClass('error');
	}
	
    var validEmail = regEx.test(email);
	
	if (email.length < 1 || !validEmail) {
	  $('[name="contact[email]"]').parent().addClass('error');
	}
	
	if(name.length > 0 && validEmail && inquery.length > 0 && text.length > 0){
	  contactSignup.submit();
	}else{
	  $('html, body').animate({
		scrollTop: $('.contact-form').offset().top - 150
	  }, 1000);
	}
  })
  
  $('.contact-form-inquiry-wrap').on('click',function(){
	$('#inquiry-list').fadeIn();
  });
  
  $(document).mouseup(function (e){

    var container = $(".contact-form-inquiry-wrap");

    if (!container.is(e.target) && container.has(e.target).length === 0){

      $('#inquiry-list').fadeOut();

    }
  });
 
  
  $('#inquiry-list').on('click', 'p', function(){
	var text = $(this).text();
	$('[name="contact[Type of Inquiry]"]').val(text);
	if(text == 'Other'){
	  $('.other-field-wrap').fadeIn();
	}else{
	  $('.other-field-wrap input').val('');
	  $('.other-field-wrap').fadeOut();
	}
  });
  
  $('body').on('click', '.contact-success-popup-close', function(e){
	e.preventDefault();
	$(this).closest('.contact-success-popup').fadeOut();
  })
});

$(document).ready(function(){
  var popupContent = '<div class="contact-success-popup"><div class="contact-success-popup-content"><h3>SUCCESS!</h3><p>Thank you for submitting your request. Our team will be responding soon.</p><img src="https://cdn.shopify.com/s/files/1/1308/3049/files/LairdApproved-White-01_1.png?v=1619036271" alt="" /></div></div>';
  
  $(document).mouseup(function (e){

    var button = $(".globo-form button.action.submit");

    if (button.is(e.target)){
	  button.closest('form').find('.success').find('.content').empty();
button.closest('form').find('.success').find('.content').append(popupContent);
    }
  });
})</script>
