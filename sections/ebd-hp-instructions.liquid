{%- assign step_count = section.settings.step_count | plus: 0 -%}

<section class="hp-instructions" data-hp-instructions>
  <div class="content-wrapper">
    <div class="heading">
      {%- if section.settings.heading != blank -%}
        <h2 class="darkblue">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 1 -%}
        <div class="toggles" role="tablist" aria-label="{{ section.settings.heading | escape }}">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="instructions-toggle{% if forloop.first %} active{% endif %}"
              role="tab"
              id="InstructionsTab-{{ block.id }}"
              aria-controls="InstructionsPanel-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              {% unless forloop.first %}
                tabindex="-1"
              {% endunless %}
              {{ block.shopify_attributes }}
            >
              {{- block.settings.title -}}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      <div
        class="instruction-wrapper"
        id="InstructionsPanel-{{ block.id }}"
        {% if section.blocks.size > 1 %}
          role="tabpanel"
          aria-labelledby="InstructionsTab-{{ block.id }}"
        {% endif %}
        style="--step-count: {{ step_count }};"
        {% unless forloop.first %}
          hidden
        {% endunless %}
      >
        {%- for i in (1..step_count) -%}
          {%- liquid
            assign image_key = 'image_' | append: i
            assign content_key = 'content_' | append: i
            assign step_image = block.settings[image_key]
            assign step_content = block.settings[content_key]
          -%}
          {%- if step_image != blank or step_content != blank -%}
            <div class="instruction-card">
              <div class="image">
                {%- if step_image != blank -%}
                  {{
                    step_image
                    | image_url: width: 840
                    | image_tag:
                      loading: 'lazy',
                      alt: step_image.alt,
                      widths: '300, 420, 600, 840',
                      sizes: '(min-width: 1025px) min(420px, 30vw), (min-width: 769px) 31vw, 300px'
                  }}
                {%- endif -%}
                <span class="step-badge" aria-hidden="true">{{ i }}</span>
              </div>
              {%- if step_content != blank -%}
                <div class="content">
                  <span class="visually-hidden">Step {{ i }}:</span>
                  {{ step_content }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
  {
    "name": "HP Instructions",
    "settings": [
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      },
      {
        "id": "step_count",
        "type": "select",
        "label": "Steps to show",
        "options": [
          { "value": "3", "label": "3" },
          { "value": "4", "label": "4" }
        ],
        "default": "3",
        "info": "Step numbers are added automatically. In each step, use a heading (H4) for the title and a paragraph for the note."
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Instructions",
        "settings": [
          {
            "id": "title",
            "type": "text",
            "label": "Title"
          },
          {
            "type": "header",
            "content": "Step 1"
          },
          {
            "id": "image_1",
            "type": "image_picker",
            "label": "Image #1"
          },
          {
            "id": "content_1",
            "type": "richtext",
            "label": "Content #1"
          },
          {
            "type": "header",
            "content": "Step 2"
          },
          {
            "id": "image_2",
            "type": "image_picker",
            "label": "Image #2"
          },
          {
            "id": "content_2",
            "type": "richtext",
            "label": "Content #2"
          },
          {
            "type": "header",
            "content": "Step 3"
          },
          {
            "id": "image_3",
            "type": "image_picker",
            "label": "Image #3"
          },
          {
            "id": "content_3",
            "type": "richtext",
            "label": "Content #3"
          },
          {
            "type": "header",
            "content": "Step 4",
            "info": "Only shown when \"Steps to show\" is set to 4."
          },
          {
            "id": "image_4",
            "type": "image_picker",
            "label": "Image #4"
          },
          {
            "id": "content_4",
            "type": "richtext",
            "label": "Content #4"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "HP Instructions",
        "category": "Home Page"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.hp-instructions {
    padding: 75px 45px;
    background-color: white;

    .content-wrapper {
      max-width: 1308px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 35px;
    }

    .heading {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;

      h2 {
        margin: 0;
        text-align: center;
        text-transform: capitalize;
      }
    }

    .toggles {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
    }

    .instructions-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 12px 25px;
      border: 2px solid var(--color-darkblue);
      border-radius: 50px;
      background-color: white;
      color: var(--color-darkblue);
      font: inherit;
      font-size: 13.3px;
      line-height: 16px;
      font-weight: 600;
      text-align: center;
      text-transform: uppercase;
      white-space: nowrap;
      cursor: pointer;
      transition: background-color 0.3s ease, color 0.3s ease;

      &:hover,
      &.active {
        background-color: var(--color-darkblue);
        color: white;
      }

      &:focus-visible {
        outline: 2px solid var(--color-darkblue);
        outline-offset: 3px;
      }
    }

    .instruction-wrapper {
      display: grid;
      grid-template-columns: repeat(var(--step-count, 3), minmax(0, 1fr));
      gap: 24px;

      &[hidden] {
        display: none;
      }
    }

    .instruction-card {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .instruction-card .image {
      position: relative;
      aspect-ratio: 420 / 565;
      overflow: hidden;
      border-radius: 16px;
      background-color: var(--color-mediumgray);

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    .step-badge {
      position: absolute;
      top: 10px;
      left: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 38px;
      height: 38px;
      border: 2px solid white;
      border-radius: 50%;
      background-color: var(--color-darkblue);
      color: white;
      font-size: 22px;
      line-height: 26px;
      font-weight: 600;
    }

    .instruction-card .content {
      display: flex;
      flex-direction: column;
      gap: 8px;
      text-align: center;

      h1, h2, h3, h4, h5, h6 {
        margin: 0;
        color: var(--color-darkblue);
        font-size: 16px;
        line-height: 20px;
        font-weight: 600;
      }

      p {
        margin: 0;
        color: rgba(18, 18, 18, 0.81);
        font-size: 14px;
        line-height: 18px;
      }
    }

    @media (max-width: 1024px) {
      padding: 60px 30px;

      .content-wrapper {
        gap: 30px;
      }

      .instruction-wrapper {
        gap: 16px;
      }

      .instruction-card {
        gap: 16px;
      }
    }

    /* Mobile (Figma): heading left-aligned, compact pills in one row, steps scroll sideways */
    @media (max-width: 768px) {
      padding: 45px 20px;

      .content-wrapper {
        gap: 24px;
      }

      .heading {
        align-items: stretch;
        gap: 12px;

        h2 {
          text-align: left;
        }
      }

      .toggles {
        flex-wrap: nowrap;
        justify-content: space-between;
        gap: 8px;
      }

      .instructions-toggle {
        flex: 0 1 auto;
        min-height: 49px;
        padding: 8px 16px;
        border-width: 1.5px;
        font-size: 13px;
        line-height: 15px;
        font-weight: 500;
        white-space: normal;
      }

      .instruction-wrapper {
        display: flex;
        gap: 8px;
        margin: 0 -20px;
        padding: 0 20px;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-padding: 0 20px;
        scrollbar-width: none;

        &::-webkit-scrollbar {
          display: none;
        }
      }

      .instruction-card {
        flex: 0 0 300px;
        max-width: 80vw;
        gap: 15px;
        scroll-snap-align: start;
      }
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-hp-instructions]').forEach(function (section) {
    var tabs = Array.prototype.slice.call(section.querySelectorAll('.instructions-toggle'));
    if (!tabs.length) return;

    function select(tab, focus) {
      tabs.forEach(function (other) {
        var isActive = other === tab;
        var panel = document.getElementById(other.getAttribute('aria-controls'));
        other.classList.toggle('active', isActive);
        other.setAttribute('aria-selected', isActive ? 'true' : 'false');
        other.tabIndex = isActive ? 0 : -1;
        if (panel) {
          panel.hidden = !isActive;
          if (isActive) panel.scrollLeft = 0;
        }
      });
      if (focus) tab.focus();
    }

    tabs.forEach(function (tab, index) {
      tab.addEventListener('click', function () {
        select(tab, false);
      });

      tab.addEventListener('keydown', function (event) {
        var next = null;
        if (event.key === 'ArrowRight') next = tabs[(index + 1) % tabs.length];
        if (event.key === 'ArrowLeft') next = tabs[(index - 1 + tabs.length) % tabs.length];
        if (event.key === 'Home') next = tabs[0];
        if (event.key === 'End') next = tabs[tabs.length - 1];
        if (next) {
          event.preventDefault();
          select(next, true);
        }
      });
    });
  });
{% endjavascript %}
