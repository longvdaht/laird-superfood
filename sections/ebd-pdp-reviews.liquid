<script type="text/javascript">
  (function(){
    if (document.querySelector('script[src*="staticw2.yotpo.com"]')) return;
    var e = document.createElement("script");
    e.type = "text/javascript";
    e.async = true;
    e.src = "//staticw2.yotpo.com/CyaEk9ZwIjf8dLar23dkuP26el4UGxqhb2KyVlkN/widget.js";
    var t = document.getElementsByTagName("script")[0];
    t.parentNode.insertBefore(e, t);
  })();
</script>

<section class="pdp-reviews" id="product-reviews">
  <div class="content-wrapper">
    <div class="heading">
      <h3 class="mediumblue">Customer Reviews</h3>
      <h2 class="darkblue">{{ product.title }}</h2>
    </div>


    <div
      class="yotpo yotpo-main-widget"
      data-product-id="{% if product.id == 6765302186019 %}6382424513{% elsif product.id == 7193234374691 %}6801586847779{% else %}{{ product.id }}{% endif %}"
      data-name="{{ product.title | escape }}"
      data-url="{{ shop.url }}{{ product.url }}"
      data-image-url="
        {{ product.featured_image | product_img_url: " large" | replace: '?' , '%3F' | replace: '&'
        , '%26' }}
      "
    ></div>
  </div>

</section>

{% schema %}
  {
    "name": "EBD PDP Reviews",
    "presets": [
      {
        "name": "EBD PDP Reviews",
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.pdp-reviews {
    padding: 65px;

    .content-wrapper {
      max-width: 1400px;
      margin: 0 auto;

      .heading {
        text-align: center;
        h2 {
          text-align: center;
          max-width: 850px;
          margin: 0 auto;
        }

        h3 {
          text-align: center;
          margin-bottom: 5px;
          text-transform: uppercase; 
        }
      }
    }
  }
{% endstylesheet %}