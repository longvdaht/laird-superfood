          "type": "header",
          "content": "Slide options"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Make the whole slide clickable",
          "info": "Optional. Buttons keep their own links."
        },
        {
          "type": "select",
          "id": "show_on",
          "label": "Show this slide on",
          "options": [
            { "value": "both", "label": "Desktop and mobile" },
            { "value": "desktop", "label": "Desktop only" },
            { "value": "mobile", "label": "Mobile only" }
          ],
          "default": "both"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HP Hero Carousel",
      "category": "Home Page",
      "blocks": [{ "type": "slide" }]
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .ebd-hero-carousel {
    position: relative;

    /* The global .swiper rule in custom.css hides the slider until Swiper boots and lets it
       overflow; a hero must stay visible even if the script never runs. */
    .hc-swiper {
      opacity: 1;
      overflow: hidden;
    }

    .hc-swiper:not(.swiper-initialized) .swiper-slide + .swiper-slide {
      display: none;
    }

    .swiper-slide {
      display: flex;
      width: 100%;
      height: auto;
    }

    /* "Each slide keeps its own height": stop the flex row from stretching every slide
       to the height of the tallest one (Swiper's autoHeight animates the wrapper instead). */
    .hc-swiper--auto-height .swiper-wrapper {
      align-items: flex-start;
    }

    .hc-slide-inner {
      position: relative;
      display: grid;
      grid-template-areas: 'stack';
      width: 100%;
      min-height: var(--hc-min-height);
      overflow: hidden;
    }

    .hc-media,
    .hc-overlay,
    .hc-slide-link,
    .hc-content {
      grid-area: stack;
      min-width: 0;
    }

    .hc-media {
      position: var(--hc-media-position);
      inset: 0;
      z-index: 0;
    }

    .hc-media--mobile {
      display: none;
    }

    .hc-media--placeholder .hc-placeholder {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--color-lightgray, #e5e7eb);
    }

    .hc-media img,
    .hc-media video {
      display: block;
      width: 100%;
      height: var(--hc-media-height);
      object-fit: cover;
      object-position: var(--hc-focal-point);
    }

    .hc-overlay {
      z-index: 1;
      background: var(--hc-overlay);
      pointer-events: none;
    }

    .hc-slide-link {
      z-index: 2;
      display: block;
    }

    .hc-content {
      z-index: 3;
      display: flex;
      flex-direction: column;
      justify-content: var(--hc-align-y);
      align-items: var(--hc-align-x);
      padding: var(--hc-padding);
      /* lets the optional slide-wide link stay clickable around the text */
      pointer-events: none;
    }

    .hc-text-box {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: var(--hc-box-width);
      text-align: var(--hc-text-align);
      align-items: var(--hc-text-align);
      pointer-events: auto;
    }

    .hc-text-box--mobile {
      display: none;
    }

    /* With the fade transition every slide sits in the same spot, so the text/links of the
       hidden ones must not swallow clicks meant for the visible slide. */
    .swiper-fade .swiper-slide:not(.swiper-slide-active) .hc-text-box,
    .swiper-fade .swiper-slide:not(.swiper-slide-active) .hc-slide-link {
      pointer-events: none;
    }

    /* Mirrors the global h1/h2 styles so slides 2+ can use a lower heading level
       without changing how the banner looks. */
    .hc-h1 {
      font-family: var(--font-primary);
      font-size: 86px;
      line-height: 1;
      font-weight: 700;
      margin: 0 0 25px;
    }

    /* Size comes from the slide settings. The default (24px / 20px) is the size of the theme's h3,
       which is what the original HP Hero used for this line — the theme's global h2 (40px) sat too
       close to the h1 and the two levels read as the same thing. */
    .hc-h2 {
      font-family: var(--font-primary);
      font-size: var(--hc-h2-size);
      line-height: 1.2;
      font-weight: 700;
      margin: 0 0 15px;
    }

    .hc-body p:last-child {
      margin-bottom: 0;
    }

    /* Same sizing rules as the original HP Hero: a fixed 3-column grid capped at 600px, and the
       icon is limited by the column WIDTH (height: auto), not by its height. Icons are usually
       wide artwork (a row of stars), so capping the height instead makes them render too large. */
    .hc-icons {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 20px;
      max-width: 600px;
      width: 100%;
      margin: 15px 0 0;
    }

    .hc-icon {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 5px;
    }

    /* Divider + spacing copied from the original HP Hero: the line sits on the column edge, so it
       is one grid gap (20px) away from the icon before it, and the padding puts the same 20px
       between the line and the icon after it. The original hard-codes this on the middle one of
       exactly three icons; here it works for any number. */
    .hc-icon + .hc-icon {
      border-left: solid 1px currentColor;
      padding-left: 20px;
    }

    .hc-icon__img {
      height: 40px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .hc-icon__img img {
      height: auto;
      max-height: 100%;
      max-width: 100%;
      width: auto;
    }

    .hc-icon__img--white img {
      filter: brightness(0) invert(1);
    }

    .hc-icon__label {
      font-family: var(--font-primary);
      font-size: 16px;
      line-height: 20px;
      font-weight: 500;
      text-align: center;
    }

    .hc-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 45px;
      /* The row itself is aligned by .hc-text-box, but once the buttons wrap (narrow screens) the
         rows also have to follow the text alignment, otherwise they all sit left. */
      justify-content: var(--hc-text-align);
    }

    .hc-button {
      display: inline-block;
      padding: 10px 25px;
      border: solid 2px transparent;
      border-radius: 25px;
      font-family: var(--font-primary);
      font-size: 17px;
      font-weight: 600;
      white-space: nowrap;
      text-decoration: none;
      transition: 0.2s;
    }

    .hc-button:hover {
      opacity: 0.85;
    }

    .hc-pagination {
      position: absolute;
      bottom: 20px;
      left: 0;
      right: 0;
      z-index: 4;
      display: flex;
      justify-content: center;
      gap: 10px;
      width: auto;
    }

    .hc-pagination .swiper-pagination-bullet {
      width: 10px;
      height: 10px;
      margin: 0;
      border-radius: 50%;
      background: var(--hc-dot-color);
      opacity: 0.45;
      transition: opacity 0.2s ease;
    }

    .hc-pagination .swiper-pagination-bullet-active {
      opacity: 1;
    }

    .hc-arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 4;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: rgba(0, 0, 0, 0.35);
      color: var(--hc-arrow-color);
      display: flex;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      transition: 0.2s;
    }

    .hc-arrow:hover {
      background: rgba(0, 0, 0, 0.6);
    }

    .hc-arrow svg {
      width: 16px;
      height: 16px;
    }

    .hc-arrow--prev {
      left: 15px;
    }

    .hc-arrow--next {
      right: 15px;
    }

    .hc-arrow.swiper-button-disabled {
      opacity: 0.35;
      cursor: default;
    }

    @media (max-width: 1024px) {
      .hc-h1 {
        font-size: 64px;
      }

      .hc-icon__label {
        font-size: 14px;
        line-height: 18px;
      }
    }

    @media (max-width: 768px) {
      .hc-slide-inner {
        min-height: var(--hc-min-height-mobile);
      }

      .hc-media {
        position: var(--hc-media-position-mobile);
      }

      .hc-media img,
      .hc-media video {
        height: var(--hc-media-height-mobile);
        object-position: var(--hc-focal-point-mobile);
      }

      .hc-slide-inner--has-mobile-media .hc-media--desktop {
        display: none;
      }

      .hc-slide-inner--has-mobile-media .hc-media--mobile {
        display: block;
      }

      .hc-overlay {
        background: var(--hc-overlay-mobile);
      }

      .hc-content {
        justify-content: var(--hc-align-y-mobile);
        align-items: var(--hc-align-x-mobile);
        padding: var(--hc-padding-mobile);
      }

      .hc-text-box {
        max-width: var(--hc-box-width-mobile);
        text-align: var(--hc-text-align-mobile);
        align-items: var(--hc-text-align-mobile);
      }

      .hc-slide-inner--split .hc-text-box--desktop {
        display: none;
      }

      .hc-slide-inner--split .hc-text-box--mobile {
        display: flex;
      }

      .hc-slide-inner--hide-icons-mobile .hc-icons {
        display: none;
      }

      .hc-h1 {
        font-size: 30px;
        line-height: 34px;
        margin: 0 0 10px;
      }

      .hc-h2 {
        font-size: var(--hc-h2-size-mobile);
        margin: 0 0 10px;
      }

      .hc-icons {
        gap: 10px;
      }

      .hc-icon + .hc-icon {
        padding-left: 10px;
      }

      .hc-icon__label {
        font-size: 12px;
      }

      .hc-buttons {
        margin-top: 25px;
        gap: 15px;
        justify-content: var(--hc-text-align-mobile);
      }

      .hc-button {
        font-size: 14px;
        padding: 7px 20px;
      }

      .hc-arrow {
        display: none;
      }
    }
  }
{% endstylesheet %}
