<section class="mushroom-lp-signup">
  <div class="content-wrapper">
    <div class="image">
      <img src="{{ section.settings.image | img_url: '1500x' }}" alt="{{ section.settings.image.alt }}">
    </div>
    <div class="content">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
      <div class="newsletter-signup">
        <div class="klaviyo-form-VkaeCg"></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Mush LP Signup",
    "settings": [
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      },
      {
        "id": "text",
        "type": "text",
        "label": "Text"
      },
      {
        "id": "image",
        "type": "image_picker",
        "label": "Image"
      }
    ],
    "presets": [
      {
        "name": "Mush LP Signup"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.mushroom-lp-signup {
    .content-wrapper {
      display: flex;
      max-width: none;
      .image {
        width: 50%;
        img {
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
      }

      .content{
        width: 50%;
        background-color: #3a758a;
        padding: 225px 125px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        
        h2 {
          color: white;
          text-align: center;
        }
      }
    }

    form.klaviyo-form {
      input {
        font-family: 'Poppins', sans-serif !important;
        min-width: 300px !important;
        color: #9D826A !important;
      }
      button {
        background-color: #003349 !important;
        border-radius: 50px !important;
        margin-left: 25px !important;
        font-family: 'Poppins', sans-serif !important;
        letter-spacing: 1.25px !important;
        color:rgb(255, 255, 255) !important;
        padding: 0 35px !important;
      }
    }

    @media (max-width: 1400px) {
      .content-wrapper {
        .content {
          padding: 125px 65px;
        }
      }
    }

    @media (max-width: 800px) {
      .content-wrapper {
        flex-direction: column;
        .image {
          width: 100%;

        }

        .content {
          width: 100%;
          padding: 85px 25px;
        }
      }
    }
  }
{% endstylesheet %}