<section class="global-announcement">
  <div class="swiper">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="slide-wrapper">
            {% if block.settings.announcement_url != blank %}
              <a href="{{ block.settings.announcement_url }}" title="{{ block.settings.title }}" class="white">
                {{ block.settings.content }}
              </a>
            {% else %}
              <h5 style="white">{{ block.settings.content }}</h5>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Global Announcement",    
    "blocks": [
      {
        "type": "text",
        "name": "Announcement",
        "settings": [
          {
            "id": "title",
            "type": "text",
            "label": "Title"
          },
          {
            "id": "announcement_url",
            "type": "url",
            "label": "Announcement URL"
          },
          {
            "id": "content",
            "type": "richtext",
            "label": "Content"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Global Announcement",
        "category": "Global"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.global-announcement {
    background-color: var(--color-mediumblue);
    overflow: hidden;
    .slide-wrapper {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 7px 20px;

      h5, p, a {
        margin: 0;
        text-align: center;
        font-size: 14px;
        line-height: 18px;
      }
    }

    @media (max-width: 768px) {
      .slide-wrapper {
        h5, p, a {
          font-size: 12px;
          line-height: 16px;
        }
      }
    }
  }
{% endstylesheet %}

{% javascript %}
  const swiper = new Swiper('.global-announcement .swiper', {
    loop: true,
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
    },
    speed: 500,
  });
{% endjavascript %}