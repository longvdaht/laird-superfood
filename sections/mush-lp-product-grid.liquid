<section class="mushroom-lp-product-grid">
  <div class="content-wrapper">
    <div class="grid">
      <div class="row">
        {% for block in section.blocks %}
          {% if forloop.index < 3 %}
            <div class="grid-item">
              <a href="{{ block.settings.url }}" class="media">
                <img src="{{ block.settings.product_image | img_url: '750x' }}" alt="{{ block.settings.product_image.alt }}">
                <div class="overlay">
                  <div class="content">
                    <h5>Best For</h5>
                    <h4>{{ block.settings.best_for_text }}</h4>                    
                  </div>
                </div>
              </a>
              <div class="button-wrapper">
                <a href="{{ block.settings.url }}" class="btn">SHOP NOW</a>
              </div>              
            </div>
          {% endif %}
        {% endfor %}        
      </div>
      <div class="row">
        {% for block in section.blocks %}
          {% if forloop.index > 2 and forloop.index < 6 %}
            <div class="grid-item">
              <a href="{{ block.settings.url }}" class="media">
              <img src="{{ block.settings.product_image | img_url: '750x' }}" alt="{{ block.settings.product_image.alt }}">
              <div class="overlay">
                <div class="content">
                <h5>Best For</h5>
                <h4>{{ block.settings.best_for_text }}</h4>                    
                </div>
              </div>
              </a>
              <div class="button-wrapper">
                <a href="{{ block.settings.url }}" class="btn">SHOP NOW</a>
              </div>              
            </div>
            {% endif %}
        {% endfor %}        
      </div>
      <div class="row">
        {% for block in section.blocks %}
          {% if forloop.index > 5 %}
            <div class="grid-item">
              <a href="{{ block.settings.url }}" class="media">
                <img src="{{ block.settings.product_image | img_url: '750x' }}" alt="{{ block.settings.product_image.alt }}">
                <div class="overlay">
                  <div class="content">
                    <h5>Best For</h5>
                    <h4>{{ block.settings.best_for_text }}</h4>                    
                  </div>
                </div>
              </a>
              <div class="button-wrapper">
                <a href="{{ block.settings.url }}" class="btn">SHOP NOW</a>
              </div>              
            </div>
          {% endif %}
        {% endfor %}        
      </div>
    </div>

    <div class="grid mobile">
      <div class="row">
        {% for block in section.blocks %}
          <div class="grid-item">
            <a href="{{ block.settings.url }}" class="media">
              <img src="{{ block.settings.product_image | img_url: '750x' }}" alt="{{ block.settings.product_image.alt }}">
              <div class="overlay">
                <div class="content">
                  <h5>Best For</h5>
                  <h4>{{ block.settings.best_for_text }}</h4>                    
                </div>
              </div>
            </a>
            <div class="button-wrapper">
              <a href="{{ block.settings.url }}" class="btn">SHOP NOW</a>
            </div>              
          </div>            
        {% endfor %}        
      </div>
    </div>

  </div>
</section>

{% schema %}
  {
    "name": "Mush LP Product Grid",
    "settings": [     
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Product",
        "settings": [
          {
            "id": "product_image",
            "type": "image_picker",
            "label": "Product Image"
          },
          {
            "id": "url",
            "type": "url",
            "label": "URL"
          },
          {
            "id": "best_for_text",
            "type": "text",
            "label": "Best For Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Mush LP Product Grid"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.mushroom-lp-product-grid {
    background-color: #f4eee7;
    padding: 45px 65px;
    .grid {
      .row {
        display: flex;
        justify-content: center;
        gap: 45px;
        margin-bottom: 65px;

        .grid-item {
          a.media {
            display: block;
            border-radius: 50%;
            width: 350px;
            height: 350px;
            border: solid 2px #D9BC9D;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            img {
              width: 80%;
              height: 80%;
              object-fit: cover;
            }
            .overlay {
              width: 100%;
              height: 100%;
              top: 0;
              left: 0;
              display: flex;
              justify-content: center;
              align-items: center;
              position: absolute;
              backdrop-filter: blur(7px);
              background-color: rgba(0, 0, 0, 0.3);
              border-radius: 50%;
              border: solid 2px #D9BC9D;
              opacity: 0;
              transition: 0.4s;

              .content {
                text-align: center;
                width: 80%;
                h4 {
                  color: white;
                  text-align: center;
                  font-size: 25px;
                  font-weight: 600;
                }

                h5 {
                  color: white;
                  text-align: center;
                  padding-bottom: 8px;
                  font-size: 20px;
                  border-bottom: solid 1px white;
                  margin-bottom: 8px;
                  display: inline-block;
                }
              }
            }

            &:hover {
              .overlay {
                opacity: 1;
              }
            }
          }

          .button-wrapper {
            text-align: center;
          }
        }
      }

      &.mobile {
        display: none;
      }
    }

    @media (max-width: 1400px) {
      padding: 45px;
      .grid {
        .row {
          gap: 25px;
        }
      }
    }

    @media (max-width: 1200px) {
      padding: 25px;
      .grid {
        .row {
          margin-bottom: 45px;
          .grid-item {
            a.media {
              width: 300px;
              height: 300px;
            }
          }
        }
      }
    }

    @media (max-width: 1000px) {
      padding: 25px;

      .grid {
        display: none;
        &.mobile {
          display: block;
        }

        .row {
          display: flex;
          flex-wrap: wrap;
        }
      }
    }

    @media (max-width: 800px) {
      .grid {
        .row {
          .grid-item {
            a.media {
              width: 200px;
              height: 200px;
              .overlay {
                .content {
                  h4 {
                  font-size: 16px;
                }

                  h5 {
                    font-size: 14px;
                  }
                }

              }
            }
          }
        }
      }
      
    }

    @media (max-width: 500px) {
      padding: 0 10px 45px;
      .grid {
        .row {
          gap: 20px;
          .grid-item {
            margin-bottom: 25px;
            display: flex;
            flex-direction: column;
            align-items: center;
            a.media {
              width: 165px;
              height: 165px;
            }
          }
        }
       
      }
    }
  }
{% endstylesheet %}