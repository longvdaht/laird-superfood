<section class="mushroom-lp-lineup">
  <div class="content-wrapper">
    <div class="image">
      <img src="{{ section.settings.image | img_url: '1000x' }}" alt="{{ section.settings.image.alt }}">
    </div>
    <div class="content">
      <h2>{{ section.settings.heading }}</h2>
      <div class="text">
        {{ section.settings.text }}
      </div>
      <a href="{{ section.settings.button_url }}" class="btn desktop">{{ section.settings.button_label }}</a>
      <a href="{{ section.settings.button_url }}" class="btn mobile">SHOP NOW</a>
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Mush LP Lineup",
    "settings": [
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      },
      {
        "id": "text",
        "type": "richtext",
        "label": "Text"
      },
      {
        "id": "button_url",
        "type": "url",
        "label": "Button URL"
      },
      {
        "id": "button_label",
        "type": "text",
        "label": "Button Label"
      },
      {
        "id": "image",
        "type": "image_picker",
        "label": "Image"
      }
    ],
    "presets": [
      {
        "name": "Mush LP Lineup"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.mushroom-lp-lineup {
    background-color: #f4eee7;
    padding: 65px;
    .content-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      gap: 65px;

      .image {
        width: 50%;
        img {
          width: 100%;
          height: auto;
        }
      }

      .content {
        width: 50%;
        h2 {
          text-transform: uppercase;
          font-style: italic;
          font-size: 38px;
          line-height: 1.1;
          font-weight: 700;
          color: #6e5238;
          margin-bottom: 10px;
        }

        p {
          font-family: 'Poppins', sans-serif;
          font-size: 28px;
          line-height: 1.25;
          color: #003349;
          font-weight: 500;
        }

        .text {
          margin-bottom: 35px;
        }

        a.btn {
          display: inline-block;
          background-color: #e90044;
          color: white;
          padding: 14px 32px;
          font-family: "Poppins", sans-serif;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 1px;
          border-radius: 50px;
          text-decoration: none;
          font-size: 16px;
        }

        a.mobile {
          display: none;
        }
      }
    }

    @media (max-width: 1200px) {
      padding: 65px 45px;
      .content-wrapper {
        gap: 45px;

        .image {
          width: 33.33%;
        }

        .content {
          width: 66.66%;

          p {
            font-size: 20px;
            line-height: 28px;
          }
        }
      }
    }

    @media (max-width: 800px) {
      padding: 45px 25px;
      .content-wrapper {
        flex-direction: column;
        gap: 25px;
        .image {
          width: 100%;
          max-width: 400px;
          margin: 0 auto;
          aspect-ratio: 1;
          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            background-position: center;
          }
        }
        
        .content {
          width: 100%;
          text-align: center;

          h2 {
            text-align: center;
          }

          .text {
            margin-bottom: 25px;
          }

          a.btn.desktop {
            display: none;
          }

          a.btn.mobile {
            display: inline-block;
          }
        }
      }
    }
  }
{% endstylesheet %}