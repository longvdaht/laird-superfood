<section class="ebd-home-hero">
  {% if section.settings.video_background != blank %}
    <video class="desktop-video" src="{{ section.settings.video_background.sources[1].url }}" autoplay muted loop playsinline aria-label="Hero Background Video"></video>
  {% endif %}
  {% if section.settings.video_background_mobile != blank %}
    <video class="mobile-video" src="{{ section.settings.video_background_mobile.sources[1].url }}" autoplay muted loop playsinline aria-label="Hero Background Video"></video>
  {% endif %}
  <div class="content-wrapper">
    <div class="heading">{{ section.settings.heading }}</div>
    <div class="subheading">{{ section.settings.subheading }}</div>
    <div class="icons-wrapper">
      {% for block in section.blocks %}
        <div class="icon-text">
          <div class="image-wrapper">
            <img 
              src="{{ block.settings.icon | img_url: '250x' }}" 
              alt="{{ block.settings.title }}"
              width="{{ block.settings.icon.width }}"
              height="{{ block.settings.icon.height }}"
            >
          </div>
          <h5 class="white">{{ block.settings.title }}</h5>
        </div>
      {% endfor %}
    </div>
    {% if section.settings.button_1_url != blank %}
      <div class="link-wrapper">
        <a href="{{ section.settings.button_1_url }}" class="btn">{{ section.settings.button_1_label }}</a>
        {% if section.settings.button_2_url != blank %}
          <a href="{{ section.settings.button_2_url }}" class="btn">{{ section.settings.button_2_label }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section> 

{% schema %}
  {
    "name": "HP Hero",
    "settings": [
      {
        "id": "video_background",
        "type": "video",
        "label": "Video Background"
      },
      {
        "id": "video_background_mobile",
        "type": "video",
        "label": "Video Background Mobile"
      },
      {
        "id": "heading",
        "type": "richtext",
        "label": "Heading"
      },
      {
        "id": "subheading",
        "type": "richtext",
        "label": "Subheading"
      },
      {
        "id": "button_1_url",
        "type": "url",
        "label": "Button #1 URL"
      },
      {
        "id": "button_1_label",
        "type": "text",
        "label": "Button #1 Label"
      },
      {
        "id": "button_2_url",
        "type": "url",
        "label": "Button #2 URL"
      },
      {
        "id": "button_2_label",
        "type": "text",
        "label": "Button #2 Label"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Icons",
        "settings": [
          {
            "id": "icon",
            "type": "image_picker",
            "label": "Icon"
          },
          {
            "id": "title",
            "type": "text",
            "label": "Title"
          }
        ]
      }
    ],
    "max_blocks": 3,
    "presets": [
      {
        "name": "HP Hero",
        "category": "Home Page"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.ebd-home-hero {
    background-size: cover;
    background-position: center;
    height: 800px;
    position: relative;
    padding: 0 45px;

    &:before {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.4);
      z-index: 1;
    }

    video.desktop-video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 0;
    }

    video.mobile-video {
      display: none;
    }

    .content-wrapper {
      z-index: 1;
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;

      h1, h3 {
        color: white;
        max-width: 750px;
      }

      .icons-wrapper {
        display: grid;
        grid-template-columns: minmax(0,1fr) minmax(0,1fr) minmax(0,1fr);
        gap: 20px;
        max-width: 600px;

        .icon-text {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 5px;

          .image-wrapper {
            height: 40px;
            display: flex;
            justify-content: center;
            align-items: center;
            
            img {
              filter: brightness(0) invert(1);
              height: auto;
              max-width: 100%;
            }


          }

          h5 {
            color: white;
            text-align: center;
            margin: 0;
          }

          &:nth-of-type(2) {
            border-left: solid 1px white;
            border-right: solid 1px white;
            padding: 0 20px;
          }
        }
      }

      .link-wrapper {
        display: flex;
        gap: 20px;
        margin-top: 45px;

        a.btn:nth-of-type(2) {
          background-color: #624330;

          &:hover {
            color: #624330;
            border-color: #624330;
            background-color: white;
          }
        }
      }
    }

    @media (max-width: 1024px) {
      height: 700px;
    }

    @media (max-width: 768px) {
      padding: 0 20px;
      height: 550px;

      .content-wrapper {
        justify-content: center;
        align-items: center;

        h1, h3 {
          text-align: center;
          max-width: 400px;
        }

        .icons-wrapper {
          gap: 10px;
          .icon-text {
            h5 {
              font-size: 12px;
            }

            &:nth-of-type(2) {
              padding: 0 10px;
            }
          }
        }

        .link-wrapper {
          flex-direction: column;
          align-items: center;
          margin-top: 25px;
          gap: 15px;
        }
      }
    }
  }
{% endstylesheet %}