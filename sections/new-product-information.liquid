    display: flex;
    height: 60px;
    min-height: var(--height-48, 48px);
    padding: 16px;
    justify-content: center;
    align-items: flex-start;
    align-self: stretch;
    border-radius: 9999px;
    background: var(--color-rose-46, #EA0044);
    color: var(--lairdsuperfood-com-white, var(--color-white-solid, #FFF));
    text-align: center;
    font-family: var(--font-family-Font-2, Gotham);
    font-size: var(--line-height-20, 20px);
    font-style: normal;
    font-weight: var(--font-weight-500, 500);
    line-height: var(--line-height-28, 28px);
    text-transform: capitalize;
  }

  .new-product-information .add-to-cart-button .add-to-cart-text__content {
    color: var(--lairdsuperfood-com-white, var(--color-white-solid, #FFF));
    font-size: var(--line-height-20, 20px);
    font-style: normal;
    font-weight: var(--font-weight-500, 500);
    line-height: var(--line-height-28, 28px);
    text-transform: capitalize;
  }

  .new-product-information .add-to-cart-button .add-to-cart-icon {
    display: none;
  }

  .new-product-information .add-to-cart-button .add-to-cart-text {
    gap: 0;
  }

  .new-purchase-options {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    border: none;
    padding: 0;
    margin: 0;
  }

  .new-purchase-options .new-po-legend {
    color: var(--lairdsuperfood-com-black, var(--color-black-solid, #000)) !important;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0) !important;
    font-family: var(--font-family-Font-1, Rubik) !important;
    font-size: 14px !important;
    font-style: normal !important;
    font-weight: var(--font-weight-700, 700) !important;
    line-height: 20px !important;
    padding: 0;
    margin: 0 0 4px 0;
  }

  .new-po-option {
    border: 1.5px solid var(--color-azure-88, #DBE3E7);
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
  }

  .new-po-option--subscribe {
    border-color: var(--color-azure-14, #003349);
  }

  .new-po-option__row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    cursor: pointer;
    width: 100%;
  }

  .new-po-radio-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .new-po-radio-indicator {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 2px solid var(--color-azure-88, #DBE3E7);
    background: #fff;
    position: relative;
    transition: border-color 0.15s;
  }

  .new-po-radio-input:checked ~ .new-po-radio-indicator {
    border-color: var(--color-azure-14, #003349);
  }

  .new-po-radio-input:checked ~ .new-po-radio-indicator::after {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--color-azure-14, #003349);
  }

  .new-po-option__title {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 1px;
    flex-wrap: wrap;
    color: var(--lairdsuperfood-com-prussian-blue, var(--color-azure-14, #003349));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: 18px;
    font-style: normal;
    font-weight: 500;
    line-height: 24px;
  }

  .new-po-discount-badge {
    display: flex;
    padding: 6px ;
    justify-content: center;
    align-items: center;
    gap: 8px;
    border-radius: 3px;
    background: var(--color-rose-46, #EA0044);
    color: var(--color-white-solid, #FFF);
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 100%;
  }

  .new-po-prices {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    margin-left: auto;
  }

  .new-po-price {
    font-family: var(--font-family-Font-1, Rubik);
    font-style: normal;
  }

  .new-po-price--compare {
    color: var(--lairdsuperfood-com-bismark, var(--color-azure-42, #507488));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-size: var(--font-size-16, 16px);
    font-weight: 400;
    line-height: var(--font-size-24, 24px);
    text-decoration-line: line-through;
  }

  .new-po-price--sub,
  .new-po-price--regular {
    color: var(--lairdsuperfood-com-prussian-blue, var(--color-azure-14, #003349));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-size: var(--font-size-16, 16px);
    font-weight: 700;
    line-height: var(--font-size-24, 24px);
  }

  .new-po-option__body {
    padding: 0 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .new-po-benefits-extra[hidden] {
    display: none !important;
  }

  .new-po-benefits-list,
  .new-po-benefits-extra {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .new-po-benefit {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--lairdsuperfood-com-prussian-blue, var(--color-azure-14, #003349));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-14, 14px);
    font-style: normal;
    font-weight: 400;
    line-height: var(--line-height-20, 20px);
  }

  .new-po-check-icon {
    flex-shrink: 0;
  }

  .new-po-see-more {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--color-azure-10, #012332);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-14, 14px);
    font-style: normal;
    font-weight: 600;
    line-height: var(--font-size-24, 24px);
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-decoration-skip-ink: auto;
    text-transform: uppercase;
    text-align: left;
  }

  .new-po-see-more:hover {
    opacity: 0.85;
  }

  .new-po-frequency {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .new-po-frequency__label {
    display: none;
  }

  .new-po-select-wrapper {
    position: relative;
    display: flex;
    align-items: center;
  }

  .new-po-frequency-select {
    width: 100%;
    appearance: none;
    background: #fff;
    border: 1.5px solid var(--color-azure-88, #DBE3E7);
    border-radius: 6px;
    padding: 8px 36px 8px 12px;
    color: var(--lairdsuperfood-com-mine-shaft, var(--color-grey-14, #232323));
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-14, 14px);
    font-style: normal;
    font-weight: 500;
    line-height: var(--line-height-20, 20px);
    cursor: pointer;
  }

  .new-po-option--onetime:has(.new-po-radio-input:checked) {
    border-radius: 12px;
    border: 2px solid var(--color-azure-19, #193347);
    background: var(--color-azure-88, #DBE3E7);
  }

  .new-po-frequency-select:focus {
    outline: 2px solid var(--color-azure-14, #003349);
    outline-offset: 2px;
  }

  .new-po-select-arrow {
    position: absolute;
    right: 12px;
    pointer-events: none;
    color: var(--color-grey-14, #232323);
    display: flex;
    align-items: center;
  }
  fieldset.variant-option--buttons label.variant-option__button-label{
    gap:0!important
  }
  .product-information,
  .new-product-information {
    padding-left: 12px;
    padding-right: 12px;
  }
  /* Hex picked on the product (metafield custom.product_page_background_color) fades into the page background.
     --pdp-gradient-color is set inline by sections/product-information.liquid. */
  /* Scoped through .shopify-section to outrank base.css `:is(.section, ...) { background: transparent }` */
  .shopify-section:not(.header-section) :is(.product-information, .new-product-information).gradient {
    background: linear-gradient(
      180deg,
      var(--pdp-gradient-color, transparent) 0%,
      var(--pdp-gradient-end, var(--color-mediumgray, #F8F4EF)) var(--pdp-gradient-stop, 52.51%)
    );
  }

  /* Legacy keyword values kept so products still on "red/gold/orange gradient" render unchanged */
  .shopify-section:not(.header-section) .product-information.red.gradient,
  .shopify-section:not(.header-section) .new-product-information.red.gradient {
    background: linear-gradient(180deg, #D9043D 0%, #F8F4EF 100%);
  }
  .shopify-section:not(.header-section) .product-information.gold.gradient,
  .shopify-section:not(.header-section) .new-product-information.gold.gradient {
    background: linear-gradient(180deg, #DBA72D 0%, #F8F4EF 52.51%);
  }
  .shopify-section:not(.header-section) .product-information.orange.gradient,
  .shopify-section:not(.header-section) .new-product-information.orange.gradient {
    background: linear-gradient(180deg, #E86400 0%, #F8F4EF 52.51%);
  }

  .new-product-information .product-tabs {
    margin-top: 15px;
  }

