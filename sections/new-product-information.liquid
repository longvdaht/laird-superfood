{% liquid
  if section.settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  assign product_has_media = true
  if closest.product.media.size == 0
    assign product_has_media = false
  endif

  assign product_grid_class = 'new-product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' new-product-information--media-none'
  elsif section.settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' new-product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' new-product-information--media-left'
  endif

  if section.settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' new-product-information__grid--half'

    if section.settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' new-product-information__grid--limit-details'
    endif
  endif

  case section.settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase
%}

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="new-product-information section section--{{ content_width }} spacing-style color-{{ section.settings.color_scheme }} relative" style="{% render 'spacing-style', settings: section.settings %} --gap: {{ section.settings.gap }}px;">
  {% if section.settings.desktop_media_position == 'left' and product_has_media %}
    {% assign product_href = '#NewProductInformation-' | append: section.id %}
    {% render 'skip-to-content-link'
      , href: product_href
      , text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  <div class="{{ product_grid_class }}" data-product-grid-content>
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="new-product-information__media"
        data-testid="new-product-information-media"
      >
        {%- content_for 'block',
          type: '_product-media-gallery',
          id: 'media-gallery',
          closest.product: closest.product
        -%}
      </div>
    {% endcapture %}
    {% capture details %}
      <div class="new-product-details">
        {% content_for 'block',
          type: '_product-details',
          id: 'product-details',
          closest.product: closest.product
        %}
      </div>
    {% endcapture %}
    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ details }}
      {% endif %}
    {% endfor %}
  </div>

  {% content_for 'blocks' %}
</div>

{%- render 'new-purchase-options-new-mahalo', product: closest.product, section: section -%}

<script>
  (() => {
    const markDetailsHeader = () => {
      const details = document.querySelector('.new-product-information .new-product-details');
      if (!details) return;
      const header = details.querySelector('.group-block .group-block-content .product-type');
      if (header) {
        const block = header.closest('.group-block-content');
        if (block) block.classList.add('new-product-details__header');
      }
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', markDetailsHeader);
    } else {
      markDetailsHeader();
    }
  })();

  (() => {
    const initPurchaseOptions = () => {
      document.querySelectorAll('.new-purchase-options').forEach((poEl) => {
        const sectionEl = document.querySelector('.new-product-information');
        if (!sectionEl) return;

        const rcWidget = sectionEl.querySelector('recharge-subscription-widget');
        if (!rcWidget) return;

        const getRcShadow = () => rcWidget.shadowRoot;
        const getRcPlansShadow = () => {
          const s1 = getRcShadow();
          if (!s1) return null;
          const rcPlans = s1.querySelector('rc-selling-plans');
          return rcPlans ? rcPlans.shadowRoot : null;
        };

        const hideRcWidget = () => {
          rcWidget.style.setProperty('display', 'none', 'important');
        };

        const syncFrequency = (planId) => {
          const s2 = getRcPlansShadow();
          if (!s2) return;
          const radio = s2.querySelector(`input[value="${planId}"]`);
          if (radio && !radio.checked) radio.click();
        };

        const syncPurchaseOption = (value) => {
          const s1 = getRcShadow();
          if (!s1) return;
          const radio = s1.querySelector(`input[name="purchaseOption"][value="${value}"]`);
          if (radio && !radio.checked) radio.click();
        };

        rcWidget.parentNode.insertBefore(poEl, rcWidget);
        hideRcWidget();
        poEl.style.display = '';

        const freqSelect = poEl.querySelector('.new-po-frequency-select');
        if (freqSelect) {
          freqSelect.addEventListener('change', () => syncFrequency(freqSelect.value));
          setTimeout(() => {
            if (freqSelect.value) syncFrequency(freqSelect.value);
          }, 200);
        }

        poEl.querySelectorAll('.new-po-radio-input').forEach((radio) => {
          radio.addEventListener('change', () => {
            if (radio.checked) {
              syncPurchaseOption(radio.value);
              const subscribeBody = poEl.querySelector('.new-po-option--subscribe .new-po-option__body');
              if (subscribeBody) subscribeBody.style.display = radio.value === 'subscription' ? '' : 'none';
            }
          });
        });

        const seeMoreBtn = poEl.querySelector('.new-po-see-more');
        const extraList  = poEl.querySelector('.new-po-benefits-extra');
        if (seeMoreBtn && extraList) {
          seeMoreBtn.addEventListener('click', () => {
            const expanded = seeMoreBtn.getAttribute('aria-expanded') === 'true';
            seeMoreBtn.setAttribute('aria-expanded', String(!expanded));
            if (!expanded) {
              extraList.removeAttribute('hidden');
              seeMoreBtn.textContent = 'See fewer benefits -';
            } else {
              extraList.setAttribute('hidden', '');
              seeMoreBtn.textContent = 'See more subscription benefits +';
            }
          });
        }

        const roundPrice = (priceStr) => {
          if (!priceStr) return priceStr;
          return priceStr.replace(/\$(\d+)\.00$/, '$$$1');
        };

        const updatePrices = () => {
          const checkedInput = sectionEl.querySelector(
            '.variant-picker input[type="radio"][data-variant-id]:checked'
          );
          if (!checkedInput) return;

          const regularText  = roundPrice(checkedInput.getAttribute('data-variant-price-text') || '');
          const compareText  = roundPrice(checkedInput.getAttribute('data-variant-compare-price-text') || '');
          const subText      = roundPrice(checkedInput.getAttribute('data-variant-sub-price-text') || regularText);
          const hasCompare   = compareText !== '';

          poEl.querySelectorAll('[data-po-compare-price]').forEach((el) => {
            el.textContent   = regularText;
            el.style.display = '';
          });
          poEl.querySelectorAll('[data-po-sub-price]').forEach((el) => {
            el.textContent = subText;
          });

          poEl.querySelectorAll('[data-po-onetime-compare-price]').forEach((el) => {
            el.textContent   = compareText;
            el.style.display = hasCompare ? '' : 'none';
          });
          poEl.querySelectorAll('[data-po-onetime-price]').forEach((el) => {
            el.textContent = regularText;
          });
        };

        updatePrices();

        sectionEl.addEventListener('change', (e) => {
          if (e.target.matches('.variant-picker input[type="radio"][data-variant-id]')) {
            updatePrices();
          }
        });

        sectionEl.querySelector('.variant-picker')?.addEventListener('variant:update', () => {
          updatePrices();
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPurchaseOptions);
    } else {
      initPurchaseOptions();
    }
  })();

  (() => {
    const sections = document.querySelectorAll('.new-product-information');
    if (!sections.length) return;

    const isSubscriptionSelected = (sectionEl) => {
      const subRadio = sectionEl.querySelector('.new-po-radio-input[value="subscription"]');
      return subRadio ? subRadio.checked : false;
    };

    const roundPriceCart = (priceStr) => {
      if (!priceStr) return priceStr;
      return priceStr.replace(/\$(\d+)\.00$/, '$$$1');
    };

    const getSelectedVariantPriceText = (sectionEl) => {
      let checkedOption = sectionEl.querySelector('.variant-picker input[type="radio"][data-variant-id]:checked');

      if (!checkedOption) {
        const variantIdInput = sectionEl.querySelector('product-form-component input[ref="variantId"]');
        const variantId = variantIdInput?.value;
        if (variantId) {
          checkedOption = sectionEl.querySelector(
            `.variant-picker input[type="radio"][data-variant-id="${variantId}"][data-variant-price-text]`
          );
        }
      }

      if (!checkedOption) return null;

      if (isSubscriptionSelected(sectionEl)) {
        const subPrice = checkedOption.getAttribute('data-variant-sub-price-text');
        if (subPrice) return roundPriceCart(subPrice);
      }

      return roundPriceCart(checkedOption.getAttribute('data-variant-price-text') || null);
    };

    const updateAddToCartText = (sectionEl) => {
      const textEl = sectionEl.querySelector('.add-to-cart-button .add-to-cart-text__content');
      if (!textEl) return;

      const priceText = getSelectedVariantPriceText(sectionEl);
      if (!priceText) return;

      textEl.textContent = `Add To Cart - ${priceText}`;
    };

    sections.forEach((sectionEl) => {
      updateAddToCartText(sectionEl);

      let isSyncing = false;
      const safeSync = () => {
        if (isSyncing) return;
        isSyncing = true;
        updateAddToCartText(sectionEl);
        setTimeout(() => {
          updateAddToCartText(sectionEl);
          isSyncing = false;
        }, 60);
      };

      sectionEl.addEventListener('change', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        if (target.matches('.variant-picker input[type="radio"][data-variant-id]')) {
          safeSync();
        }
        if (target.matches('.new-po-radio-input')) {
          safeSync();
        }
      });

      sectionEl.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest('.variant-option__button-label')) {
          safeSync();
        }
      });

      document.addEventListener('change', (event) => {
        const target = event.target;
        if (target instanceof HTMLInputElement && target.matches('.new-po-radio-input')) {
          safeSync();
        }
      });

      const formContainer = sectionEl.querySelector('product-form-component');
      if (formContainer) {
        const observer = new MutationObserver(() => safeSync());
        observer.observe(formContainer, { childList: true, subtree: true, characterData: true, attributes: true });
      }
    });
  })();
</script>

{% stylesheet %}
  .new-product-information {
    gap: var(--gap) 0;
  }

  .new-product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  .new-product-details {
    order: 1;
  }

  .new-product-information .new-product-details .group-block > .group-block-content:not(.new-product-details__header) {
    --gap: 0 !important;
    gap: 0 !important;
  }

  .new-product-information .new-product-details .new-product-details__header {
    --gap: 0 !important;
    gap: 0 !important;
  }

  .new-product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .new-product-information__media {
      grid-column: 1 / -1;
    }

    .new-product-details {
      grid-column: 2 / 3;
    }
  }

  @media screen and (min-width: 750px) {
    .new-product-information__grid {
      grid-column: 2;
    }

    .new-product-information__grid.new-product-information--media-none,
    .new-product-information__grid:has(.new-product-information__media:empty) {
      .new-product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    .new-product-information__grid:not(:has(.new-product-information__media:empty)) {
      &.new-product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .new-product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .new-product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

         &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      &.new-product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .new-product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .new-product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

         &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      &.new-product-information__grid--half,
       &.new-product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns: var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(var(--full-page-grid-central-column-width) / 2) var(--full-page-grid-margin);

        &.new-product-information--media-left {
          .new-product-information__media {
            grid-column: 2 / 3;

             &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .new-product-details {
            grid-column: 3 / 4;
          }
        }

        &.new-product-information--media-right {
          .new-product-information__media {
            grid-column: 3 / 4;

             &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .new-product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    .section--full-width {
      .new-product-information__grid:not(:has(.new-product-information__media:empty)),
      .new-product-information__grid:not(:has(.new-product-information__media:empty)) {
        &.new-product-information--media-left,
        &.new-product-information--media-right {
          grid-column: 1 / -1;
        }

        &.new-product-information--media-left .new-product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.new-product-information--media-right .new-product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.new-product-information__grid--half.new-product-information--media-left {
          .new-product-information__media {
            grid-column: 1 / 3;
          }

          .new-product-details {
            grid-column: 3 / -1;
          }
        }

        &.new-product-information__grid--half.new-product-information--media-right {
          .new-product-information__media {
            grid-column: 3 / -1;
          }

          .new-product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  .new-product-information__grid--limit-details .new-product-details > .group-block {
    width: 100%;
    max-width: var(--sidebar-width);
  }

  @media screen and (min-width: 750px) {
    .new-product-information .new-product-information__grid:not(:has(.new-product-information__media:empty)):not(
        .new-product-information--media-none
      ) {
