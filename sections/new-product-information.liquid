.new-product-information .variant-option__button-label--has-selling-badge {
    overflow: visible;
}

  /* Reserve room for the badges on the whole row so every button stays the same shape */
  .new-product-information .variant-option__buttons-row:has(.variant-option__button-label--has-selling-badge) {
    padding-block-start: 10px;
  }

  .new-product-information .variant-option__buttons-row:has(.variant-option__button-label--has-selling-badge-bottom) {
    padding-block-end: 10px;
  }

  .new-product-information .variant-option__button-label__selling-badge {
    position: absolute;
    left: 50%;
    z-index: 3;
    max-width: calc(100% + 16px);
    white-space: nowrap;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--variant-badge-text-color, var(--color-white-solid, #FFF));
    text-align: center;
    font-family: var(--font-family-Font-1, Rubik);
    font-size: 10px;
    font-style: normal;
    font-weight: 700;
    line-height: 100%;
    letter-spacing: var(--letter-spacing-0_3, 0.3px);
    border-radius: 20px;
    background: var(--variant-badge-background, var(--color-rose-46, #EA0044));
    padding: 4px 8px;
    box-sizing: border-box;
    pointer-events: none;
  }

  /* The first badge sits above the button, the second below it */
  .new-product-information .variant-option__button-label__selling-badge--top {
    top: 0;
    transform: translate(-50%, -70%);
  }

  .new-product-information .variant-option__button-label__selling-badge--bottom {
    bottom: 0;
    transform: translate(-50%, 70%);
  }

  .new-product-information .variant-option__button-label--best-value {
    border-color: var(--color-rose-46, #EA0044);
  }

  .new-product-information .variant-option__button-label--badge-highlight {
    border-color: var(--variant-badge-border-color, var(--color-rose-46, #EA0044));
  }

  .new-product-information .variant-option__button-label::before,
  .new-product-information .variant-option__button-label::after,
  .new-product-information .variant-option__button-label__pill {
    display: none;
  }

  .new-product-information .variant-option__button-label:has([data-option-available='false']) {
    opacity: 0.5;
  }

