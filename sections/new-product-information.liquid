  @media (min-width: 750px) {
    .shopify-section:not(.header-section) .product-information.red.gradient,
    .shopify-section:not(.header-section) .new-product-information.red.gradient {
      background: linear-gradient(180deg, #D9043D 0%, #F8F4EF 52.51%);
    }
  }

  @media (max-width: 749px) {
    .new-po-option__title {
      font-size: 18px;
