{% liquid
  if section.settings.desktop_media_position == 'left'
    assign render_order = 'media,product-details'
  else
    assign render_order = 'product-details,media'
  endif

  assign product_has_media = true
  if closest.product.media.size == 0
    assign product_has_media = false
  endif

  assign product_grid_class = 'new-product-information__grid'

  if product_has_media == false
    assign product_grid_class = product_grid_class | append: ' new-product-information--media-none'
  elsif section.settings.desktop_media_position == 'right'
    assign product_grid_class = product_grid_class | append: ' new-product-information--media-right'
  else
    assign product_grid_class = product_grid_class | append: ' new-product-information--media-left'
  endif

  if section.settings.equal_columns
    assign product_grid_class = product_grid_class | append: ' new-product-information__grid--half'

    if section.settings.limit_details_width
      assign product_grid_class = product_grid_class | append: ' new-product-information__grid--limit-details'
    endif
  endif

  case section.settings.content_width
    when 'content-center-aligned'
      assign content_width = 'page-width'
    when 'content-full-width'
      assign content_width = 'full-width'
  endcase

  # Product page background. Preferred: a hex color picked on the product
  # (metafield custom.product_page_background_color) that fades into the page background.
  # Legacy: custom.product_page_background holding keyword classes (red gradient, gold gradient, ...).
  assign pdp_background_class = closest.product.metafields.custom.product_page_background | downcase | strip
  assign pdp_background_color = closest.product.metafields.custom.product_page_background_color | strip

  # The legacy text metafield may also hold a hex, so merchants can switch without a new field
  if pdp_background_color == blank
    assign pdp_background_first_char = pdp_background_class | slice: 0
    if pdp_background_first_char == "#"
      assign pdp_background_color = pdp_background_class
      assign pdp_background_class = ""
    endif
  endif

  if pdp_background_color != blank
    assign pdp_background_class = "gradient"
  endif
%}

<script type="application/ld+json">
  {{ closest.product | structured_data }}
</script>

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="new-product-information section section--{{ content_width }} spacing-style color-{{ section.settings.color_scheme }} relative{% if section.settings.custom_mobile_padding %} new-product-information--custom-mobile-padding{% endif %}{% if pdp_background_class != blank %} {{ pdp_background_class }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %} --gap: {{ section.settings.gap }}px;
    {%- if section.settings.custom_mobile_padding -%}
      --padding-block-start-mobile: {{ section.settings['padding-block-start-mobile'] }}px;
      --padding-block-end-mobile: {{ section.settings['padding-block-end-mobile'] }}px;
    {%- endif -%}
    {%- if pdp_background_color != blank -%}
      --pdp-gradient-color: {{ pdp_background_color }};
    {%- endif -%}
  "
>
  {% if section.settings.desktop_media_position == 'left' and product_has_media %}
    {% assign product_href = '#NewProductInformation-' | append: section.id %}
    {% render 'skip-to-content-link'
      , href: product_href
      , text: 'accessibility.skip_to_product_info' %}
  {% endif %}
  {% content_for 'blocks' %}

  <div class="{{ product_grid_class }}" data-product-grid-content>
    {% assign render_order_array = render_order | split: ',' %}
    {% capture media %}
      <div
        class="new-product-information__media"
        data-testid="new-product-information-media"
      >
        {%- content_for 'block',
          type: '_product-media-gallery',
          id: 'media-gallery',
          closest.product: closest.product
        -%}
      </div>
    {% endcapture %}
    {% capture details %}
      <div class="new-product-details">
        {% content_for 'block',
          type: '_product-details',
          id: 'product-details',
          closest.product: closest.product
        %}
      </div>
    {% endcapture %}
    {% for block in render_order_array %}
      {% if block == 'media' and product_has_media %}
        {{ media }}
      {% elsif block == 'product-details' %}
        {{ details }}
      {% endif %}
    {% endfor %}
  </div>
</div>

{%- render 'new-purchase-options-new-mahalo', product: closest.product, section: section -%}

<script>
  (() => {
    const markDetailsHeader = () => {
      const details = document.querySelector('.new-product-information .new-product-details');
      if (!details) return;
      const header = details.querySelector('.group-block .group-block-content .product-type');
      if (header) {
        const block = header.closest('.group-block-content');
        if (block) block.classList.add('new-product-details__header');
      }
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', markDetailsHeader);
    } else {
      markDetailsHeader();
    }
  })();

</script>

{% render 'purchase-options-sync', root_selector: '.new-product-information' %}

{% stylesheet %}
  .new-product-information {
    gap: var(--gap) 0;
  }

  .new-product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  .new-product-details {
    order: 1;
  }

  /* .new-product-information .new-product-details .group-block > .group-block-content:not(.new-product-details__header) {
    --gap: 0 !important;
    gap: 0 !important;
  }

  .new-product-information .new-product-details .new-product-details__header {
    --gap: 0 !important;
    gap: 0 !important;
  } */

  .new-product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .new-product-information__media {
      grid-column: 1 / -1;
    }

    .new-product-details {
      grid-column: 1 / -1;
    }
  }

  @media screen and (min-width: 750px) {
    .new-product-information__grid {
      grid-column: 2;
    }

    .new-product-information__grid.new-product-information--media-none,
    .new-product-information__grid:has(.new-product-information__media:empty) {
      .new-product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    .new-product-information__grid:not(:has(.new-product-information__media:empty)) {
      &.new-product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .new-product-information__media {
          padding-right: calc(var(--gap, 0) * 2);
        }

        /* .new-product-details {
          padding-left: calc(var(--gap, 0) * 2);
        } */

         &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      &.new-product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .new-product-information__media {
          padding-left: calc(var(--gap, 0) * 2);
          order: 1;
        }

        .new-product-details {
          padding-right: calc(var(--gap, 0) * 2);
          order: 0;
        }

         &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      &.new-product-information__grid--half,
       &.new-product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns: var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(var(--full-page-grid-central-column-width) / 2) var(--full-page-grid-margin);

        &.new-product-information--media-left {
          .new-product-information__media {
            grid-column: 2 / 3;

             &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .new-product-details {
            grid-column: 3 / 4;
          }
        }

        &.new-product-information--media-right {
          .new-product-information__media {
            grid-column: 3 / 4;

             &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .new-product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    .section--full-width {
      .new-product-information__grid:not(:has(.new-product-information__media:empty)),
      .new-product-information__grid:not(:has(.new-product-information__media:empty)) {
        &.new-product-information--media-left,
        &.new-product-information--media-right {
          grid-column: 1 / -1;
        }

        &.new-product-information--media-left .new-product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.new-product-information--media-right .new-product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.new-product-information__grid--half.new-product-information--media-left {
          .new-product-information__media {
            grid-column: 1 / 3;
          }

          .new-product-details {
            grid-column: 3 / -1;
          }
        }

        &.new-product-information__grid--half.new-product-information--media-right {
          .new-product-information__media {
            grid-column: 3 / -1;
          }

          .new-product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  .new-product-information__grid--limit-details .new-product-details > .group-block {
    width: 100%;
    max-width: var(--sidebar-width);
  }

  @media screen and (min-width: 750px) {
    /* .new-product-information .new-product-information__grid:not(:has(.new-product-information__media:empty)):not(
        .new-product-information--media-none
      ) {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      justify-content: center;
      width: 100%;
      max-width: 1312px;
      margin-inline: auto;
    } */

    .new-product-information__grid--limit-details .new-product-details > .group-block {
      max-width: 100%;
      padding-top: 36px;
    }

    .rating-wrapper-link {
      position: absolute;
      top: 0;
      right: 0;
    }

    .new-product-information .new-product-information__media {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      padding: 0;
    }

    .new-product-information .new-product-details {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      padding: 0;
    }

    .new-product-information .new-product-information--media-right .new-product-information__media {
      order: 2;
    }

    .new-product-information .new-product-information--media-right .new-product-details {
      order: 1;
    }
