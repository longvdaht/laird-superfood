  .new-product-information .product-tabs .tab-content .tab-content-single {
    display: none;
    width: 100%;
    color: var(--lairdsuperfood-com-mine-shaft, var(--color-grey-18, #2D2D2D));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-17, 17px);
    font-style: normal;
    font-weight: var(--font-weight-400, 400);
    line-height: normal;
  }

  .new-product-information .product-tabs .tab-content .tab-content-single.active {
    display: block;
  }

  .new-product-information .product-tabs .tab-content .tab-content-single p {
    margin: 0;
  }

  .new-product-information .product-tabs .tab-content .tab-content-single ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .new-product-information .product-tabs .tab-content .tab-content-single li {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    color: var(--lairdsuperfood-com-mine-shaft, var(--color-grey-18, #2D2D2D));
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0);
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-16, 16px);
    font-style: normal;
    font-weight: var(--font-weight-400, 400);
    line-height: normal;
  }

  .new-product-information .product-tabs .tab-content .tab-content-single li + li {
    margin-top: 8px;
  }

