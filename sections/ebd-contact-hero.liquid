<section class="contact-hero" style="background-image: url('{{ section.settings.background_image | img_url: '1920x' }}');">
  <div class="content">
    <h1 class="small">{{ section.settings.heading }}</h1>
    {% if section.settings.subheading %}
      <h3>{{ section.settings.subheading }}</h3>
    {% endif %}
  </div>
  <div class="wave-wrapper">
    {% render 'wave-contact-hero-offwhite' %}
  </div>

<style>
  @media (max-width: 768px) {
    section.contact-hero {
      background-image: url('{{ section.settings.background_image_mobile | img_url: '900x' }}') !important;
    }
  }
</style>

</section>

{% schema %}
  {
    "name": "Contact Hero",
    "settings": [
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      },
      {
        "id": "subheading",
        "type": "text",
        "label": "Subheading"
      },
      {
        "id": "background_image",
        "type": "image_picker",
        "label": "Background Image"
      },
      {
        "id": "background_image_mobile",
        "type": "image_picker",
        "label": "Background Image Mobile"
      }
    ],
    "presets": [
      {
        "name": "Contact Hero",
        "category": "Contact"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  section.contact-hero {
    height: 750px;
    background-size: cover;
    background-position: center;
    position: relative;

    &:before {
      content: '';
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: linear-gradient(to bottom, rgba(24, 69, 105, 0.5), transparent);
      z-index: 0;
    }

    .content {
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 0 45px;
      position: relative; 
      z-index: 1;

      h1 {
        max-width: 1100px;
        color: white;
        text-align: center;
      }

      h3 {
        max-width: 900px;
        color: white;
        text-align: center;
      }
    }

    .wave-wrapper {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 200px;
      svg {
        width: 100%;
        height: 100%;
        display: block;
      }
    }

    @media (max-width: 1024px) {
      height: 600px;
    }

    @media (max-width: 768px) {
      height: 500px;

      .wave-wrapper {
        height: 100px;
      }
    }


  }
{% endstylesheet %}