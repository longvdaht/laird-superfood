<section class="mushroom-lp-hero">
  <div class="content-wrapper">
    <div id="left" class="column" style="background-image: url('{{ section.settings.image_left | img_url: '1500x' }}');">
      <div class="content">
        <div class="inner-content">
          <h1>{{ section.settings.heading }}</h1>
          <p>{{ section.settings.text }}</p>
          <a href="{{ section.settings.button_url }}" class="btn">{{ section.settings.button_label }}</a>
        </div>
      </div>
    </div>
    <div id="right" class="column">
      <img class="desktop" src="{{ section.settings.image_right | img_url: '1500x' }}" alt="{{ section.settings.image_right.alt }}">
      <img class="mobile" src="{{ section.settings.image_right_mobile | img_url: '1500x' }}" alt="{{ section.settings.image_right_mobile.alt }}">
    </div>
  </div>
  <img src="{{ section.settings.new_badge | img_url: '500x' }}" alt="{{ section.settings.new_badge.alt }}" class="new-badge">
</section>

{% schema %}
  {
    "name": "Mush LP Hero",
    "settings": [
      {
        "id": "heading",
        "type": "text",
        "label": "Heading"
      },
      {
        "id": "text",
        "type": "text",
        "label": "Text"
      },
      {
        "id": "button_url",
        "type": "url",
        "label": "Button URL"
      },
      {
        "id": "button_label",
        "type": "text",
        "label": "Button Label"
      },
      {
        "id": "image_left",
        "type": "image_picker",
        "label": "Image Left"
      },
      {
        "id": "image_right",
        "type": "image_picker",
        "label": "Image Right"
      },
      {
        "id": "image_right_mobile",
        "type": "image_picker",
        "label": "Image Right Mobile"
      },
      {
        "id": "new_badge",
        "type": "image_picker",
        "label": "NEW Badge"
      }
    ],
    "presets": [
      {
        "name": "Mush LP Hero"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  @keyframes newBadgePulse {
    0% {
      transform: scale(1);
    }

    50% {
      transform: scale(1.05);

    }

    100% {
      transform: scale(1);
    }
  }

  section.mushroom-lp-hero {
    position: relative;
    .content-wrapper {
      display: flex;
      height: 900px;
      max-width: none;
      .column {
        width: 50%;
        background-size: cover;

        &#left {
          display: flex;
          justify-content: center;
          align-items: center;
          padding: 65px 45px;

          .content {
            border: solid 1px white;
            position: relative;
            border-radius: 12px;
            overflow: hidden;
            padding: 45px 65px;
            max-width: 575px;
            backdrop-filter: blur(10px);  
            background: rgba(30, 20, 5, 0.35);  

            h1 {
              font-size: 40px;
              margin-bottom: 10px;
            }

            p {
              color: white;
              margin-bottom: 20px;
            }
          }
        }

        &#right {
          position: relative;
          img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            top: 0;
            left: 0;
            position: absolute;

            &.mobile {
              display: none;
            }
          }
        }
      }
    }

    img.new-badge {
      position: absolute;
      top: 45px;
      right: 125px;
      width: 150px;
      height: 150px;
      animation: newBadgePulse 2s ease-in-out infinite;
    }

    @media (max-width: 1400px) {
      .content-wrapper {
        height: 700px;
        .column {
          &#left {
            .content {
              padding: 45px 25px;
            }
          }
        }
      }
    }

    img.new-badge {
      right: 45px;
    }

    @media (max-width: 1200px) {
      .content-wrapper {
        .column {
          &#left {
            padding: 65px 25px;
            .content {
              padding: 45px 20px;
            }
          }
        }
      }
      img.new-badge {
        right: 45px;
      }
    }

    @media (max-width: 800px) {
      .content-wrapper {
        height: 100%;
        flex-direction: column-reverse;
        .column {
          width: 100%;
          &#left {
            padding: 65px 15px;
            .content {
              padding: 35px 20px;

              h1 {
                font-size: 28px;
              }
            }
          }
          &#right {
            img.desktop {
              display: none;
            }

            img.mobile {
              display: block;
              position: relative;
            }
          }
        }
      }
      img.new-badge {
        width: 100px;
        height: 100px;
        left: 15px;
        top: 15px;
      }
    }


  }
{% endstylesheet %}