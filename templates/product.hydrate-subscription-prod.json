        "custom_liquid_Vf7jjw": {
          "type": "custom-liquid",
          "name": "One Time BTN",
          "settings": {
            "custom_liquid": "<div class=\"rc-onetime-button-wrap\">\n  <button type=\"button\" class=\"rc-onetime-button\">\n    Buy once for {{ product.selected_or_first_available_variant.price | money }} + $8.95 shipping\n  </button>\n</div>\n\n<style>\n  .rc-onetime-button-wrap {\n    text-align: center;\n    margin-top: 8px;\n  }\n  .rc-onetime-button {\n    background: none;\n    border: none;\n    padding: 0;\n    font-size: 15px;\n    font-weight: 400;\n    color: #003349;\n    text-decoration: underline;\n    cursor: pointer;\nmargin-bottom: 12px;\n  }\n</style>\n\n<script>\n  (function () {\n    const btn = document.querySelector('.rc-onetime-button');\n    if (!btn) return;\n\n    function getVariantId() {\n      const card = document.querySelector('.hydration-flavor-card.is-selected');\n      if (card?.dataset.variantId) return card.dataset.variantId;\n      const input = document.querySelector(\n        'form.shopify-product-form input[name=\"id\"], ' +\n        'form[data-type=\"add-to-cart-form\"] input[name=\"id\"]'\n      );\n      return input?.value || null;\n    }\n\n    btn.addEventListener('click', async function () {\n      const variantId = getVariantId();\n      if (!variantId) return;\n\n      const r = await fetch('/cart/add.js', {\n        method: 'POST',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify({ items: [{ id: parseInt(variantId), quantity: 1 }] })\n      });\n\n      if (r.ok) {\n        const url = new URL(window.location.href);\n        url.searchParams.set('viewcart', 'true');\n        window.location.href = url.toString();\n      }\n    });\n  })();\n</script>"
          },
          "blocks": {}
        },
