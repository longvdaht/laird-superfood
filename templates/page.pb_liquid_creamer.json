    "mush_lp_recipes_GD78nF": {
      "type": "mush-lp-recipes",
      "blocks": {
        "text_RkDJRx": {
          "type": "text",
          "settings": {
            "title": "Lion's Mane",
            "recipe_name": "Focus & Memory Mushroom Tea",
            "ingredients": "<ul><li>6 g Nilgiri tea (loose leaf)</li><li>12 oz boiling water</li><li>2 lemon wedges</li><li>1 tbsp honey</li><li>½ tsp Focus & Memory Mushroom powder</li><li>2 oz milk (optional)</li></ul>",
            "directions": "<ol><li>Bring 12 oz of water to a boil.</li><li>Place 6 g of Nilgiri tea into a reusable tea ball or infuser.</li><li>Pour the boiling water into a mug over the tea ball.</li><li>Steep for 6 minutes, then remove the tea ball.</li><li>Stir in ½ tsp of Focus & Memory Mushroom powder.</li><li>Add a squeeze of lemon, honey, and milk (if using) to taste.</li><li>Sip, savor, and focus up!</li></ol>"
          }
        },
        "text_A8bt6F": {
          "type": "text",
          "settings": {
            "title": "Reishi",
            "recipe_name": "Calm & Relaxation Mushroom Tea",
            "ingredients": "<ul><li>6 g Honeybush herbal tea (loose leaf)</li><li>10 oz boiling water</li><li>½ tsp Calm & Relaxation Mushroom powder</li><li>2 lemon wedges</li><li>1 tbsp honey</li></ul>",
            "directions": "<ol><li>Bring 10 oz of water to a boil.</li><li>Place 6 g of Honeybush tea into a reusable tea ball or infuser.</li><li>Pour boiling water over the tea and steep for 8 minutes.</li><li>Remove the tea ball.</li><li>Stir in ½ tsp of Calm & Relaxation Mushroom powder.</li><li>Add a squeeze of lemon and honey to taste.</li><li>Breathe deep, sip slow, and unwind.</li></ol>"
          }
        }
      },
