    "ebd_hp_instructions_TBqGwV": {
      "type": "ebd-hp-instructions",
      "blocks": {
        "text_BHXM8z": {
          "type": "text",
          "settings": {
            "title": "Daily Greens",
            "image_1": "shopify://shop_images/1_2a210cd0-ee67-415c-a06b-8e8c51ab5412.webp",
            "content_1": "<h4>1. Mix 2 tbsp of powder</h4>",
            "image_2": "shopify://shop_images/2_d92b6d8b-00c0-4041-ad72-eb7dc96d1fc4.webp",
            "content_2": "<h4>2. With 8 - 10oz of water</h4>",
            "image_3": "shopify://shop_images/3_ac5c4d4f-4b2d-46aa-ab6d-0b67862cdf0a.webp",
            "content_3": "<h4>3. Froth or stir</h4><p>*We use real ingredients so sometimes there will be sediment, just stir as you drink. </p>",
            "image_4": "shopify://shop_images/4_f4a07fa4-c94b-4fea-a40f-108fc38dff9c.webp",
            "content_4": "<h4>4. Enjoy your super cup of happiness.</h4>"
          }
        },
        "text_hHGpJi": {
          "type": "text",
          "settings": {
            "title": "Superfood Creamer",
            "image_1": "shopify://shop_images/1_0dea2c37-bcc6-47b8-bc60-ea1d9c61d019.webp",
            "content_1": "<h4>1. Mix 2 tbsp of powder</h4>",
            "image_2": "shopify://shop_images/2_62324458-1be5-4116-99c2-7f617763d81e.webp",
            "content_2": "<h4>2. With 8-12oz of coffee or tea</h4>",
            "image_3": "shopify://shop_images/3_14334a23-8d55-4026-86f7-3cd3043ba15f.webp",
            "content_3": "<h4>3. Froth or stir</h4><p>*We use real ingredients so sometimes there will be sediment, just stir as you drink. </p>",
            "image_4": "shopify://shop_images/4_299a7740-3c28-417e-a4ef-3304b345b0a8.webp",
            "content_4": "<h4>4. Enjoy your super cup of happiness.</h4>"
          }
        },
        "text_bjRjez": {
          "type": "text",
          "settings": {
            "title": "Performance Mushrooms",
            "image_1": "shopify://shop_images/1_75830b8d-2828-4b62-a1c8-6b26f886d39d.webp",
            "content_1": "<h4>1. Mix 3/4 tsp of powder</h4>",
            "image_2": "shopify://shop_images/2_c40e1847-c89b-47d8-89a5-269ac2549fab.webp",
            "content_2": "<h4>2. With 12oz of coffee or smoothie</h4>",
            "image_3": "shopify://shop_images/3_0bf92300-2261-4bfa-890a-8dc091ea36ee.webp",
            "content_3": "<h4>3. Froth or stir</h4><p>*We use real ingredients so sometimes there will be sediment, just stir as you drink. </p>",
            "image_4": "shopify://shop_images/4_bf7a07a1-be73-44da-8446-aea11304c600.webp",
            "content_4": "<h4>4. Enjoy your super cup of happiness.</h4>"
          }
        }
      },
