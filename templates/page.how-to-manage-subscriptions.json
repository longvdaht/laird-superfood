      "settings": {
        "title": "Process your order immediately ",
        "text": "<p>Process your order immediately rather than the order date originally scheduled.<\/p><p>After an order is processed, the next charge date for the subscriptions in the order gets recalculated based on the subscriptions frequency. For example, if the subscription gets delivered every month and today is January 1st, after I click order now, my next order will now happen on February 1st.<\/p>"
      }
    },
    "ebd_manage_subs_BYqnmL": {
      "type": "ebd-manage-subs",
      "blocks": {
        "text_zQUcFM": {
          "type": "text",
          "settings": {
            "content": "<p>In the <strong>View your next order<\/strong> tab, click<strong> Reschedule<\/strong>.<br\/><\/p><p>The reschedule modal will display an estimated charge date to <br\/>reschedule the order based on the frequency of the subscription. For <br\/>example, if your subscription is on a 30 day frequency, the modal will <br\/>suggest a reschedule date one month from the original charge date. <\/p>",
            "image": "shopify:\/\/shop_images\/image_6155ea77-1a2c-43c6-bc1c-9a7751050f40.png"
          }
        },
        "text_EhQkeg": {
          "type": "text",
          "settings": {
            "content": "<p>Select the new order date and click <strong>Save changes<\/strong> to confirm. <\/p>",
            "image": "shopify:\/\/shop_images\/image_a26974b6-6f38-4885-92a1-5a062100ddb1.png"
          }
        }
      },
      "block_order": [
        "text_zQUcFM",
        "text_EhQkeg"
      ],
      "settings": {
        "title": "Edit your next order date",
        "text": "<p>While you're changing the date, following orders will be rescheduled based on this next order and the delivery frequency of the subscription. <\/p>"
      }
    },
