    "ebd_about_intro_UgnQdy": {
      "type": "ebd-about-intro",
      "name": "EBD About Intro",
      "settings": {
        "heading": "It all started with a cup of coffee",
        "text": "<p>Laird Superfood was born when pioneering big wave surfer Laird Hamilton set out to find a better morning routine to improve and sustain his performance on the waves. He began experimenting with adding healthy plant-based fats and other real-food ingredients to his morning cup, eventually perfecting a recipe that not only sustained his energy, but tasted incredible.<br/><br/>This founding spirit still flows through every product we make. From your day’s first cup to your last snack, we believe everything you put in your body should fuel the best version of yourself.<br/></p>",
        "image": "shopify://shop_images/laird-surfing2.png"
      }
    },
    "ebd_about_meet_LxWBF9": {
      "type": "ebd-about-meet",
      "blocks": {
        "text_BGDFiM": {
          "type": "text",
          "settings": {
            "title": "Laird Hamilton",
            "bio": "You may know Laird as a big wave surfer, but his accomplishments on land are just as impressive. An innovator, author, speaker, nutrition expert, adrenaline junkie, and philanthropist, Laird goes big in everything he does. Among his many achievements, he’s most proud of being a devoted husband and father.",
            "facebook_url": "https://www.facebook.com/LairdLife/",
            "instagram_url": "https://www.instagram.com/lairdhamilton/?hl=en",
            "x_url": "https://twitter.com/lairdlife",
            "tiktok_url": "https://www.tiktok.com/@thereallairdhamilton"
          }
        },
        "text_6Kxb47": {
          "type": "text",
          "settings": {
            "title": "Gabby Reece",
            "bio": "Gabrielle Reece is a force to be reckoned with. From a volleyball legend to a health and fitness expert, there is no stopping her quest to grow awareness of better health habits. With her companies Laird Superfood and XPT (Extreme Performance Training) and her Podcast “The Gabby Reece Show\" Gabby's mission is to encourage people to be their best selves. It’s no surprise Gabby and Laird have made perfect partners, both at home and in business.",
            "facebook_url": "https://www.facebook.com/OfficialGabrielleReece/",
            "instagram_url": "https://www.instagram.com/gabbyreece",
            "x_url": "https://twitter.com/gabbyreece",
            "tiktok_url": "https://www.tiktok.com/@gabbyreeceofficial"
          }
        }
      },
