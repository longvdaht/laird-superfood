{% doc %}
  @prompt
    Build a variant & quantity selection section that has 1 bag, 2 bags, 4 bags, have 4 bags. , Place them in rounded rectangles with contrast so it's clear which one is selected, also change the price to show 7 servings, 14 servings, 28 servings, Make the popular badge 1 line instead of 2, can you give me all controls to change size of each part of the text and the spacing between everything
{% enddoc %}
{% comment %}
  Variant & Quantity Selection Block
  Allows customers to select between 1 bag, 2 bags, or 4 bags with servings display
{% endcomment %}

<style>
  .variant-quantity-selector {
    margin: {{ block.settings.margin_top }}px 0 {{ block.settings.margin_bottom }}px;
  }

  .variant-quantity-selector__title {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 500;
    margin-bottom: {{ block.settings.title_spacing }}px;
    color: rgb(var(--color-foreground));
  }

  .variant-quantity-selector__options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.option_gap }}px;
  }

  @media screen and (max-width: 749px) {
    .variant-quantity-selector__options {
      grid-template-columns: 1fr;
    }
  }

  .variant-quantity-option {
    position: relative;
    border: {{ block.settings.border_width }}px solid #e5e7eb;
    border-radius: {{ block.settings.border_radius }}px;
    padding: {{ block.settings.option_padding_vertical }}px {{ block.settings.option_padding_horizontal }}px;
    cursor: pointer;
    transition: all 0.25s ease;
    background-color: #ffffff;
    text-align: center;
    min-height: {{ block.settings.option_min_height }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .variant-quantity-option:hover {
    border-color: #003349;
    box-shadow: 0 2px 8px rgba(0, 51, 73, 0.1);
    transform: translateY(-2px);
  }

  .variant-quantity-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .variant-quantity-option.selected {
    background-color: #003349;
    border-color: #003349;
    box-shadow: 0 4px 12px rgba(0, 51, 73, 0.25);
  }

  .variant-quantity-option.selected:hover {
    background-color: #00445e;
    border-color: #00445e;
    transform: translateY(-2px);
  }

  .variant-quantity-option__content {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    color: #1f2937;
    transition: color 0.25s ease;
  }

  .variant-quantity-option.selected .variant-quantity-option__content {
    color: #ffffff;
  }

  .variant-quantity-option__quantity {
    font-size: {{ block.settings.quantity_size }}px;
    font-weight: {{ block.settings.quantity_weight }};
    line-height: 1.1;
    margin-bottom: {{ block.settings.quantity_spacing }}px;
  }

  .variant-quantity-option__label {
    font-size: {{ block.settings.label_size }}px;
    font-weight: {{ block.settings.label_weight }};
    opacity: 0.75;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.label_letter_spacing }}px;
  }

  .variant-quantity-option__price {
    font-size: {{ block.settings.price_size }}px;
    font-weight: {{ block.settings.price_weight }};
    margin-top: {{ block.settings.price_spacing }}px;
  }

  .variant-quantity-option__savings {
    font-size: {{ block.settings.savings_size }}px;
    color: #16a34a;
    font-weight: {{ block.settings.savings_weight }};
    margin-top: {{ block.settings.savings_spacing }}px;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.savings_letter_spacing }}px;
  }

  .variant-quantity-option.selected .variant-quantity-option__savings {
    color: #86efac;
  }

  .variant-quantity-option__checkmark {
    position: absolute;
    top: {{ block.settings.checkmark_position }}px;
    right: {{ block.settings.checkmark_position }}px;
    width: {{ block.settings.checkmark_size }}px;
    height: {{ block.settings.checkmark_size }}px;
    background-color: #ffffff;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.25s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .variant-quantity-option__checkmark::after {
    content: '✓';
    color: #003349;
    font-size: {{ block.settings.checkmark_icon_size }}px;
    font-weight: bold;
  }

  .variant-quantity-option.selected .variant-quantity-option__checkmark {
    opacity: 1;
  }

  {% if block.settings.show_popular_badge %}
  .variant-quantity-option__badge {
    position: absolute;
    top: {{ block.settings.badge_position }}px;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.badge_color }};
    color: {{ block.settings.badge_text_color }};
    padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_text_size }}px;
    font-weight: {{ block.settings.badge_text_weight }};
    text-transform: uppercase;
    letter-spacing: {{ block.settings.badge_letter_spacing }}px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    white-space: nowrap;
  }
  {% endif %}
</style>

<div class="variant-quantity-selector" {{ block.shopify_attributes }}>
  {% if block.settings.show_title %}
    <div class="variant-quantity-selector__title">
      {{ block.settings.title }}
    </div>
  {% endif %}

  <div class="variant-quantity-selector__options">
    {% comment %} 1 Bag = 7 Servings {% endcomment %}
    <label class="variant-quantity-option {% if block.settings.default_selection == '1' %}selected{% endif %}" data-quantity="1">
      <input 
        type="radio" 
        name="quantity-selector-{{ block.id }}" 
        value="1"
        {% if block.settings.default_selection == '1' %}checked{% endif %}
        onchange="updateQuantitySelection(this)"
      >
      <div class="variant-quantity-option__content">
        <div class="variant-quantity-option__quantity">7</div>
        <div class="variant-quantity-option__label">Servings</div>
        {% if product.selected_or_first_available_variant.price %}
          <div class="variant-quantity-option__price">
            {{ product.selected_or_first_available_variant.price | money }}
          </div>
        {% endif %}
      </div>
      <div class="variant-quantity-option__checkmark"></div>
    </label>

    {% comment %} 2 Bags = 14 Servings {% endcomment %}
    <label class="variant-quantity-option {% if block.settings.default_selection == '2' %}selected{% endif %}" data-quantity="2">
      <input 
        type="radio" 
        name="quantity-selector-{{ block.id }}" 
        value="2"
        {% if block.settings.default_selection == '2' %}checked{% endif %}
        onchange="updateQuantitySelection(this)"
      >
      <div class="variant-quantity-option__content">
        <div class="variant-quantity-option__quantity">14</div>
        <div class="variant-quantity-option__label">Servings</div>
        {% if product.selected_or_first_available_variant.price %}
          {% assign two_bag_price = product.selected_or_first_available_variant.price | times: 2 %}
          <div class="variant-quantity-option__price">
            {{ two_bag_price | money }}
          </div>
        {% endif %}
      </div>
      <div class="variant-quantity-option__checkmark"></div>
    </label>

    {% comment %} 4 Bags = 28 Servings {% endcomment %}
    <label class="variant-quantity-option {% if block.settings.default_selection == '4' %}selected{% endif %}" data-quantity="4">
      {% if block.settings.show_popular_badge and block.settings.popular_option == '4' %}
        <div class="variant-quantity-option__badge">{{ block.settings.badge_text }}</div>
      {% endif %}
      <input 
        type="radio" 
        name="quantity-selector-{{ block.id }}" 
        value="4"
        {% if block.settings.default_selection == '4' %}checked{% endif %}
        onchange="updateQuantitySelection(this)"
      >
      <div class="variant-quantity-option__content">
        <div class="variant-quantity-option__quantity">28</div>
        <div class="variant-quantity-option__label">Servings</div>
        {% if product.selected_or_first_available_variant.price %}
          {% assign four_bag_price = product.selected_or_first_available_variant.price | times: 4 %}
          <div class="variant-quantity-option__price">
            {{ four_bag_price | money }}
          </div>
          {% if block.settings.show_savings %}
            <div class="variant-quantity-option__savings">
              {{ block.settings.savings_text }}
            </div>
          {% endif %}
        {% endif %}
      </div>
      <div class="variant-quantity-option__checkmark"></div>
    </label>
  </div>
</div>

<script>
  function updateQuantitySelection(radio) {
    const container = radio.closest('.variant-quantity-selector');
    const options = container.querySelectorAll('.variant-quantity-option');
    const selectedQuantity = parseInt(radio.value);
    
    // Update visual selection
    options.forEach(option => {
      option.classList.remove('selected');
    });
    radio.closest('.variant-quantity-option').classList.add('selected');
    
    // Update the product form quantity input
    const productForm = document.querySelector('product-form form, form[action*="/cart/add"]');
    if (productForm) {
      const quantityInput = productForm.querySelector('input[name="quantity"], .quantity__input');
      if (quantityInput) {
        quantityInput.value = selectedQuantity;
        // Trigger change event for any listeners
        quantityInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
    }
    
    // Dispatch custom event for other scripts to listen to
    document.dispatchEvent(new CustomEvent('variant-quantity-changed', {
      detail: { quantity: selectedQuantity }
    }));
  }

  // Initialize on page load
  document.addEventListener('DOMContentLoaded', function() {
    const checkedRadio = document.querySelector('.variant-quantity-selector input[type="radio"]:checked');
    if (checkedRadio) {
      updateQuantitySelection(checkedRadio);
    }
  });
</script>

