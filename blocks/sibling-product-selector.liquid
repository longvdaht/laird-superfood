{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign sibling_products = product.metafields.custom.sibling_products.value %}

{% if sibling_products == blank and block.settings.fallback_products != blank %}
{% assign sibling_products = block.settings.fallback_products %}
{% endif %}

{% liquid
  assign hide_sibling_selector = false
  if template.suffix == 'new-mahalo' and product.handle == 'superfood-creamer-sweet-and-creamy-with-adaptogens'
    assign hide_sibling_selector = true
  endif
%}
{% if hide_sibling_selector == false %}

{% style %}
  .ai-product-list-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
  }

  .ai-product-list__title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    text-transform: capitalize;
    margin-bottom: 10px;
    color: rgb(var(--color-foreground));
  }

  .ai-product-list__subtitle-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 400;
    text-transform: none;
  }

  .ai-product-list__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-product-list__item-{{ ai_gen_id }} {
    cursor: pointer;
    border-radius: 8px;
    border: var(--stroke-weight-1, 1px) solid var(--color-azure-42, #507488);
    padding: 10px 16px;
    display: flex;
{% if block.settings.show_image %}
    flex-direction: column;
    gap: 12px;
{% else %}
    align-items: center;
    justify-content: center;
{% endif %}
    background-color: {{ block.settings.background_color }};
    transition: all 0.2s ease;
    text-decoration: none;
    color: {{ block.settings.text_color }};
  }

  .ai-product-list__item-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.hover_background_color }};
    border-color: {{ block.settings.hover_border_color }};
  }

  .ai-product-list__item-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.active_background_color }};
    border-color: {{ block.settings.active_border_color }};
    color: {{ block.settings.active_text_color }};
  }

  .ai-product-list__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
    background-color: #f5f5f5;
  }

  .ai-product-list__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-list__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-list__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-list__info-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .ai-product-list__product-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
  }

  .ai-product-list__price-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
  }

  .ai-product-list__empty-{{ ai_gen_id }} {
    padding: 40px 20px;
    text-align: center;
    color: #999;
    font-size: 14px;
  }

  .ai-product-list__empty-title-{{ ai_gen_id }} {
    font-weight: 600;
    margin-bottom: 8px;
    color: #666;
  }

  .ai-product-list__empty-text-{{ ai_gen_id }} {
    font-style: italic;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-product-list__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-product-list__item-{{ ai_gen_id }} {
      padding: 12px;
    }

    .ai-product-list__product-title-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-product-list__price-{{ ai_gen_id }} {
      font-size: 13px;
    }
  }
{% endstyle %}

<product-list-{{ ai_gen_id }}
  class="ai-product-list-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
{% if sibling_products != blank or block.settings.include_current_product %}
{% if block.settings.title != blank %}
    <div class="ai-product-list__title-{{ ai_gen_id }}">
      {{ block.settings.title }}:
      <span class="ai-product-list__subtitle-{{ ai_gen_id }}">
        {{ product.metafields.custom.size_name.value | default: product.metafields.custom.product_sub_title.value | default: product.title }}
      </span>
    </div>
{% endif %}

  <div class="ai-product-list__grid-{{ ai_gen_id }}">
{% if block.settings.include_current_product %}
    <a
      href="{{ product.url }}"
      class="ai-product-list__item-{{ ai_gen_id }} active"
      data-product-handle="{{ product.handle }}"
    >
{% if block.settings.show_image %}
      <div class="ai-product-list__image-wrapper-{{ ai_gen_id }}">
{% assign swatch_images = product.metafields.custom.swatch_color.value %}
{% if swatch_images != blank %}
          <img
            class="ai-product-list__image-{{ ai_gen_id }}"
            src="{{ swatch_images[0] | image_url: width: 400 }}"
            alt="{{ product.title | escape }}"
            loading="lazy"
            width="400"
            height="400"
          >
{% elsif product.featured_image %}
          <img
            class="ai-product-list__image-{{ ai_gen_id }}"
            src="{{ product.featured_image | image_url: width: 400 }}"
            alt="{{ product.featured_image.alt | escape }}"
            loading="lazy"
            width="400"
            height="400"
          >
{% else %}
          <div class="ai-product-list__image-placeholder-{{ ai_gen_id }}">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
{% endif %}
      </div>
{% endif %}

      <div class="ai-product-list__info-{{ ai_gen_id }}">
        <div class="ai-product-list__product-title-{{ ai_gen_id }}">
          {{ product.metafields.custom.size_name.value | default: product.metafields.custom.product_sub_title.value | default: product.title }}
        </div>
{% if block.settings.show_price %}
        <div class="ai-product-list__price-{{ ai_gen_id }}">
          {{ product.price | money }}
        </div>
{% endif %}
      </div>
    </a>
{% endif %}

{% if sibling_products != blank %}
{% for sibling in sibling_products %}
{% if sibling.handle != product.handle %}
      <a
        href="{{ sibling.url }}"
        class="ai-product-list__item-{{ ai_gen_id }}"
        data-product-handle="{{ sibling.handle }}"
      >
{% if block.settings.show_image %}
          <div class="ai-product-list__image-wrapper-{{ ai_gen_id }}">
{% assign swatch_images = sibling.metafields.custom.swatch_color.value %}
{% if swatch_images != blank %}
              <img
                class="ai-product-list__image-{{ ai_gen_id }}"
                src="{{ swatch_images[0] | image_url: width: 400 }}"
                alt="{{ sibling.title | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
{% elsif sibling.featured_image %}
              <img
                class="ai-product-list__image-{{ ai_gen_id }}"
                src="{{ sibling.featured_image | image_url: width: 400 }}"
                alt="{{ sibling.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
{% else %}
              <div class="ai-product-list__image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
{% endif %}
          </div>
{% endif %}

        <div class="ai-product-list__info-{{ ai_gen_id }}">
          <div class="ai-product-list__product-title-{{ ai_gen_id }}">
            {{ sibling.metafields.custom.size_name.value | default: sibling.metafields.custom.product_sub_title.value | default: sibling.title }}
          </div>
{% if block.settings.show_price %}
          <div class="ai-product-list__price-{{ ai_gen_id }}">
            {{ sibling.price | money }}
          </div>
{% endif %}
        </div>
      </a>
{% endif %}
{% endfor %}
{% endif %}
  </div>
{% else %}
  <div class="ai-product-list__empty-{{ ai_gen_id }}">
    <div class="ai-product-list__empty-title-{{ ai_gen_id }}">
      No sibling products configured
    </div>
    <div class="ai-product-list__empty-text-{{ ai_gen_id }}">
      Add products to the "sibling_products" metafield (custom.sibling_products)<br>
      or select fallback products in the block settings below.
    </div>
  </div>
{% endif %}
</product-list-{{ ai_gen_id }}>

{% endif %}

{% schema %}
{
  "name": "Sibling product selector",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Size"
    },
    {
      "type": "paragraph",
      "content": "This block displays products from the 'custom.sibling_products' metafield. If no metafield is set, it will use the fallback products below."
    },
    {
      "type": "checkbox",
      "id": "include_current_product",
      "label": "Include current product",
      "default": true
    },
    {
      "type": "product_list",
      "id": "fallback_products",
      "label": "Fallback products",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between items",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Product display"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show product image",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show product price",
      "default": false
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "header",
      "content": "Default state"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#003349"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#003349"
    },
    {
      "type": "header",
      "content": "Hover state"
    },
    {
      "type": "color",
      "id": "hover_background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "hover_border_color",
      "label": "Border",
      "default": "#003349"
    },
    {
      "type": "header",
      "content": "Active state"
    },
    {
      "type": "color",
      "id": "active_background_color",
      "label": "Background",
      "default": "#003349"
    },
    {
      "type": "color",
      "id": "active_text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_border_color",
      "label": "Border",
      "default": "#003349"
    }
  ],
  "presets": [
    {
      "name": "Sibling product selector"
    }
  ]
}
{% endschema %}