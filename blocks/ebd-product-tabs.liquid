<div class="product-tabs">
  <div class="tab-toggles">
    <div data-tab-id="description" class="tab active">Description</div>
    {% if product.metafields.custom.benefits %}
      <div data-tab-id="benefits" class="tab">Benefits</div>
    {% endif %}
    {% if product.metafields.custom.how_to_use %}
      <div data-tab-id="how-to-use" class="tab">How to use</div>
    {% endif %}
    {% if product.metafields.custom.ingredients_tab %}
      <div data-tab-id="ingredients" class="tab">Ingredients</div>
    {% endif %}
  </div>
  <div class="tab-content">

    <div data-tab-id="description" class="tab-content-single active">
      {% if product.metafields.custom.short_description %}
        {{ product.metafields.custom.short_description }}
      {% else %}
        {{ product.description }}
      {% endif %}
    </div>

    {% if product.metafields.custom.benefits %}
      <div data-tab-id="benefits" class="tab-content-single">
        {{ product.metafields.custom.benefits }}
      </div>
    {% endif %}

    {% if product.metafields.custom.how_to_use %}
      <div data-tab-id="how-to-use" class="tab-content-single">
        {{ product.metafields.custom.how_to_use }}
      </div>
    {% endif %}


    {% if product.metafields.custom.ingredients_tab %}
      <div data-tab-id="ingredients" class="tab-content-single">
        <p>{{ product.metafields.custom.ingredients_tab }}</p>
      </div>
    {% endif %}

    {% if product.metafields.custom.prop65 == true %}
      <a
        href="#footer-disclaimers"
        class="prop-65-warning"
        title="Prop 65 Warning">
        †† California Residents: View our Prop 65 Warning
      </a>
    {% endif %}

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var tabs = document.querySelectorAll('.product-tabs .tab');
    var tabContents = document.querySelectorAll('.product-tabs .tab-content-single');
    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var tabId = this.getAttribute('data-tab-id');
        if (tabId === 'ingredients') return;
        tabs.forEach(function (t) { t.classList.remove('active'); });
        tabContents.forEach(function (content) { content.classList.remove('active'); });
        this.classList.add('active');
        var target = document.querySelector('.tab-content-single[data-tab-id="' + tabId + '"]');
        if (target) target.classList.add('active');
      });
    });

    document.querySelectorAll('.product-tabs .prop-65-warning[href="#footer-disclaimers"]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        var el = document.getElementById('footer-disclaimers');
        if (el) {
          e.preventDefault();
          el.scrollIntoView({ behavior: 'smooth', block: 'end' });
        }
      });
    });
  });
</script>


{% schema %}
  {
    "name": "EBD Product Tabs",
    "settings": [],
    "presets": [
      {
        "name": "EBD Product Tabs",
        "category": "EBD Blocks"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  .product-tabs {
    margin-top: 0;
    background-color: var(--color-white);
    border-radius: 8px;
    border-top: 1.5px solid var(--color-gray-1);
    .tab-toggles {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      .tab {
        font-weight: 600;
        font-size: 12px;
        line-height: 16px;
        letter-spacing: 0px;
        text-align: center;
        color: rgba(var(--color-black-1), .81);
        cursor: pointer;
        border-bottom: 2px solid var(--color-gray-1);
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        &.active {
          background-color: var(--color-darkblue);
          color: var(--color-white);
          border-color: var(--color-darkblue);
        }
        &:first-child {
          border-top-left-radius: 8px;
        }
        &:last-child {
          border-top-right-radius: 8px;
        }
      }
    }
    .tab-content {
      .tab-content-single {
        display: none;
        padding: 24px 20px 12px;
        font-weight: 400;
        font-size: 16px;
        line-height: 22px;
        letter-spacing: 0;
        color: rgba(var(--color-black-1), .81);
        &.active {
          display: block;
        }
      }
    }
  }

  a.prop-65-warning {
    display: inline-block;
    font-size: 12px;
    line-height: 18px;
    letter-spacing: 0px;
    text-align: left;
    width: 100%;
    color: rgba(var(--color-black-1), .81);
    text-decoration: underline;
    font-weight: 400;
    padding: 0 20px 24px;
  }

  @media (min-width: 750px) {
    .product-tabs {
      .tab-toggles {
        .tab {
          font-size: 16px;
          line-height: 18px;
        }
      }
      .tab-content {
        .tab-content-single {
          padding: 36px 20px 12px;
        }
      }
    }

    a.prop-65-warning {
      font-size: 13px;
      line-height: 100%;
      letter-spacing: 0px;
      padding: 0 20px 36px;
    }
  }
{% endstylesheet %}

{% javascript %}
  const tabs = document.querySelectorAll('.product-tabs .tab');
  const tabContents = document.querySelectorAll('.product-tabs .tab-content-single');

  tabs.forEach(tab => {
    tab.addEventListener('click', function() {
      const tabId = this.getAttribute('data-tab-id');

      tabs.forEach(t => t.classList.remove('active'));
      tabContents.forEach(content => content.classList.remove('active'));

      this.classList.add('active');
      document.querySelector(`.tab-content-single[data-tab-id="${tabId}"]`).classList.add('active');
    });
  });
{% endjavascript %}