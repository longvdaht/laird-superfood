<h3 class="product-type">{{ product.type }}</h3>



{% schema %}
  {
    "name": "EBD Product Type",
    "presets": [
      {
        "name": "EBD Product Type",
        "category": "EBD Blocks"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  h3.product-type {
    text-transform: uppercase;
    font-size: 16px;
    line-height: 18px;
    color: var(--color-mediumblue);
    margin-bottom: 0;
    letter-spacing: 1px;
    padding-top: 8px;
  }
  @media screen and (min-width: 750px) {
    h3.product-type {
      padding-top: 0;
      font-size: 20px;
      line-height: 20px;
    } 
  }
{% endstylesheet %}