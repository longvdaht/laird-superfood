
<div class="product-review-count">
  {% render 'okendo-reviews-product-rating-summary', product: product %}
  <a href="#product-reviews" class="reviews-link"><span class="sparkle-emoji">✨</span>See reviews summary</a>
</div>

{% schema %}
{
  "name": "EBD Product Review Count",
  "presets": [
    {
      "name": "EBD Product Review Count",
      "category": "EBD Product"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .product-review-count {
    display: flex;
    align-items: center;

    a.reviews-link {
      position: relative;
      bottom: 2px;
      margin-left: 10px;
      font-weight: 400;
    }
  }
{% endstylesheet %}
