{% liquid
  assign heading = block.settings.heading
  assign body_text = block.settings.text
  assign icon_image = block.settings.icon_image
%}

<div
  class="ebd-pdp-guarantee"
  style="
    --ebd-guarantee-bg: {{ block.settings.background_color }};
    --ebd-guarantee-border: {{ block.settings.border_color }};
    --ebd-guarantee-icon-bg: {{ block.settings.icon_background_color }};
    --ebd-guarantee-icon-color: {{ block.settings.icon_color }};
    --ebd-guarantee-heading-color: {{ block.settings.heading_color }};
    --ebd-guarantee-text-color: {{ block.settings.text_color }};
    --ebd-guarantee-margin-top: {{ block.settings.margin_top }}px;
    --ebd-guarantee-margin-bottom: {{ block.settings.margin_bottom }}px;
    --ebd-guarantee-margin-top-mobile: {{ block.settings.margin_top_mobile }}px;
    --ebd-guarantee-margin-bottom-mobile: {{ block.settings.margin_bottom_mobile }}px;
  "
  {{ block.shopify_attributes }}
>
  <div class="ebd-pdp-guarantee__icon" aria-hidden="true">
    {% if icon_image != blank %}
      <img
        class="ebd-pdp-guarantee__icon-image"
        src="{{ icon_image | image_url: width: 120 }}"
        alt=""
        width="60"
        height="60"
        loading="lazy"
      >
    {% else %}
      <svg
        class="ebd-pdp-guarantee__icon-svg"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        focusable="false"
      >
        <path
          d="M12 2.75 4.75 5.9v5.35c0 4.4 3.05 8.5 7.25 9.95 4.2-1.45 7.25-5.55 7.25-9.95V5.9L12 2.75Z"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
        />
        <path
          d="m8.9 11.95 2.15 2.15 4.05-4.35"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    {% endif %}
  </div>

  <div class="ebd-pdp-guarantee__content">
    {% if heading != blank %}
      <p class="ebd-pdp-guarantee__heading">{{ heading }}</p>
    {% endif %}
    {% if body_text != blank %}
      <div class="ebd-pdp-guarantee__text">{{ body_text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "EBD PDP Guarantee",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "30 Day Happiness Guarantee"
      },
      {
        "type": "richtext",
        "id": "text",
        "label": "Text",
        "default": "<p>We know you'll love our products - we're so confident that we offer a 30-day guarantee on all orders, from the time you receive it at home.</p>"
      },
      {
        "type": "image_picker",
        "id": "icon_image",
        "label": "Icon image",
        "info": "Leave blank to use the built-in shield icon."
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border",
        "default": "#3A758A"
      },
      {
        "type": "color",
        "id": "icon_background_color",
        "label": "Icon background",
        "default": "#145E7D"
      },
      {
        "type": "color",
        "id": "icon_color",
        "label": "Icon",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "heading_color",
        "label": "Heading",
        "default": "#145E7D"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "default": "#145E7D"
      },
      {
        "type": "header",
        "content": "Spacing (desktop)"
      },
      {
        "type": "range",
        "id": "margin_top",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "Margin top",
        "default": 24
      },
      {
        "type": "range",
        "id": "margin_bottom",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "Margin bottom",
        "default": 24
      },
      {
        "type": "header",
        "content": "Spacing (mobile)"
      },
      {
        "type": "range",
        "id": "margin_top_mobile",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "Margin top",
        "default": 16
      },
      {
        "type": "range",
        "id": "margin_bottom_mobile",
        "min": 0,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "Margin bottom",
        "default": 16
      }
    ],
    "presets": [
      {
        "name": "EBD PDP Guarantee",
        "category": "EBD Blocks"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
  .ebd-pdp-guarantee {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    margin: var(--ebd-guarantee-margin-top, 24px) 0 var(--ebd-guarantee-margin-bottom, 24px);
    background: var(--ebd-guarantee-bg, #fff);
    border: 1px solid var(--ebd-guarantee-border, var(--lairdsuperfood-com-ming, #3a758a));
    border-radius: 12px;
  }

  .ebd-pdp-guarantee__icon {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--ebd-guarantee-icon-bg, var(--lairdsuperfood-com-chathams-blue, #145e7d));
    color: var(--ebd-guarantee-icon-color, #fff);
  }

  .ebd-pdp-guarantee__icon-svg {
    width: 28px;
    height: 28px;
  }

  .ebd-pdp-guarantee__icon-image {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .ebd-pdp-guarantee__content {
    min-width: 0;
  }

  .ebd-pdp-guarantee__heading {
    margin: 0 0 4px;
    color: var(--ebd-guarantee-heading-color, var(--lairdsuperfood-com-chathams-blue, #145e7d));
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-16, 16px);
    font-style: normal;
    font-weight: var(--font-weight-700, 700);
    line-height: 22px;
  }

  .ebd-pdp-guarantee__text,
  .ebd-pdp-guarantee__text p {
    margin: 0;
    color: var(--ebd-guarantee-text-color, var(--lairdsuperfood-com-chathams-blue, #145e7d));
    font-family: var(--font-family-Font-1, Rubik);
    font-size: var(--font-size-14, 14px);
    font-style: normal;
    font-weight: var(--font-weight-400, 400);
    line-height: 20px;
  }

  .ebd-pdp-guarantee__text a {
    color: inherit;
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .ebd-pdp-guarantee {
      gap: 14px;
      padding: 16px;
      margin: var(--ebd-guarantee-margin-top-mobile, 16px) 0 var(--ebd-guarantee-margin-bottom-mobile, 16px);
    }

    .ebd-pdp-guarantee__icon-svg {
      width: 24px;
      height: 24px;
    }

    .ebd-pdp-guarantee__heading {
      font-size: var(--font-size-15, 15px);
      line-height: 20px;
    }

    .ebd-pdp-guarantee__text,
    .ebd-pdp-guarantee__text p {
      font-size: var(--font-size-13, 13px);
      line-height: 19px;
    }
  }
{% endstylesheet %}
